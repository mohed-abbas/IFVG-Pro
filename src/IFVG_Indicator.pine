// ╔══════════════════════════════════════════════════════════════════╗
// ║                     IFVG INDICATOR v3.0                          ║
// ║                     Phase 3: Multi-Timeframe                     ║
// ║                                                                  ║
// ║  Created: 2026-01-20                                             ║
// ║  Based on DodgysDD IFVG Strategy                                 ║
// ║                                                                  ║
// ║  Phase 1 Features:                                               ║
// ║  - FVG Detection (current timeframe)                             ║
// ║  - IFVG Inversion Detection                                      ║
// ║  - Basic visualization (boxes)                                   ║
// ║  - Mitigation tracking                                           ║
// ║                                                                  ║
// ║  Phase 2 Features:                                               ║
// ║  - Swing structure liquidity detection (EQH, EQL, ITH, ITL)      ║
// ║  - Full grading algorithm (A+ to C)                              ║
// ║  - BE point tracking and validation                              ║
// ║  - Entry valid/invalid status                                    ║
// ║  - Stop loss calculation                                         ║
// ║  - Liquidity sweep detection                                     ║
// ║                                                                  ║
// ║  Phase 3 Features:                                               ║
// ║  - HTF FVG/IFVG detection via request.security                   ║
// ║  - HTF overlay projection on LTF chart                           ║
// ║  - HTF bias determination                                        ║
// ║  - LTF setup filtering based on HTF bias                         ║
// ╚══════════════════════════════════════════════════════════════════╝

//@version=6
indicator("IFVG Indicator", shorttitle="IFVG", overlay=true,
          max_bars_back=500,
          max_boxes_count=500,
          max_lines_count=500,
          max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════
// SECTION 1: TYPE DEFINITIONS
// ══════════════════════════════════════════════════════════════════════

// FVG Status Enum (using strings for clarity)
// "active"    - FVG detected, not yet inverted
// "inverted"  - FVG has been inverted (candle body closed through)
// "mitigated" - Price has fully closed through the inverted zone

// Type: Fair Value Gap
type FVG
    float top           // Upper boundary of gap
    float bottom        // Lower boundary of gap
    float mid           // Midpoint
    int start_bar       // Bar index where FVG starts (candle 1 of 3)
    int end_bar         // Bar index where FVG ends (candle 3 of 3)
    bool is_bullish     // true = bullish FVG, false = bearish FVG
    string status       // "active", "inverted", "mitigated"
    string timeframe    // Source timeframe ("" for current)
    box box_id          // Reference to drawn box
    label label_id      // Reference to label
    int htf_end = na    // HTF bar_index of candle 3 (HTF FVGs only; used for series of gaps)

// Type: SwingPoint - For structure-based liquidity detection
type SwingPoint
    float price         // Swing high/low price
    int bar_idx         // Bar index of swing
    bool is_high        // true = swing high, false = swing low
    bool is_internal    // true = internal structure, false = external
    bool is_valid       // Still valid (not broken)
    float far_close = na  // Lowest close since a swing high / highest since a swing low (tracked while pending)

// Type: LRLR - Low resistance liquidity run (trendline liquidity through 3+ aligned
// lower highs above price, or higher lows below price)
type LRLR
    int x1              // Bar of the origin swing (first, most extreme point)
    float y1            // Origin price — where the run usually ends (the target)
    int x2              // Bar of the newest swing on the line
    float y2            // Newest swing price
    int points          // Swings on the line
    bool lower_highs    // true = falling line of lower highs (buyside run, long targets)
    line line_id        // Drawn trendline
    label label_id      // "LRLR" label

// Type: Liquidity - All liquidity types (Enhanced for proper EQL/EQH)
type Liquidity
    float level         // Price level (average of touches)
    float original_level // First swing's exact price
    string liq_type     // "EQH", "EQL", "ITH", "ITL", "Data High", "Data Low"
    string quality      // "perfect", "relative" (NEW)
    int bar_idx         // Bar where first swing formed
    int last_touch_bar  // Bar of most recent valid touch
    int touch_count     // Number of valid touches
    bool is_swept       // true if liquidity has been taken
    int swept_bar       // Bar index where sweep occurred
    bool is_valid       // Still valid for new touches (not broken through)
    line line_id        // Reference to drawn line
    label label_id      // Reference to label
    int mitigated_bar   // Bar index where level was swept or broken (na while live)
    bool is_strong = false    // Strong High/Low: its leg broke structure (decided once)
    bool is_decided = false   // Strong/weak decision is final
    float structure_ref = na  // ITH: swing low the rally came from; ITL: swing high the drop came from

// Type: Trade - the setup taken at the inversion close (position size, PnL, stats)
type Trade
    bool is_bull        // Long (true) or short
    float entry         // Inversion candle close
    float sl            // Hard (disaster) stop: the setup's SL line, hit only by a wick
    float stop_px       // Planned stop = IFVG box far edge; entry → stop_px is 1R (lot size)
    float tp            // Take profit (fixed R:R or the setup's target)
    float zone_top      // IFVG box top (close-beyond exit)
    float zone_bottom   // IFVG box bottom (close-beyond exit)
    float be_level      // Stop moves to entry once price reaches it (na = no BE move)
    bool be_moved = false // Stop is at entry
    string grade        // Setup grade at inversion
    int start_bar       // Inversion bar
    int end_bar         // Exit bar (na while open)
    int result = 0      // 0 = open, 1 = TP hit, -1 = hard stop hit, 2 = closed beyond the box, 3 = breakeven
    float r_result = na // R made at exit
    float exit_price = na
    string tag = ""     // Grade and setup details for stats breakdown / strategy trade list
    bool notify = false // Meets the alert grade: breakeven and exit alerts are sent

// Type: Inverted Fair Value Gap (Extended for Phase 2)
type IFVG
    float top           // Upper boundary (inherited from source FVG)
    float bottom        // Lower boundary (inherited from source FVG)
    float mid           // Midpoint
    int start_bar       // Original FVG start bar
    int inversion_bar   // Bar where inversion occurred
    float inversion_close  // Close price of inversion candle
    bool is_bullish     // Direction (INVERTED from original FVG)
    string status       // "inverted", "mitigated"
    string grade        // "A+", "A", "A-", "B+", "B", "B-", "C"
    bool entry_valid    // true if SL not yet hit at inversion
    float be_level      // Break-even level (first swing target to the LEFT)
    string be_status    // "intact", "taken"
    float sl_level      // Stop loss level (swing or FVG boundary)
    string sl_type      // "strong" (setup's own high/low) or "fvg_boundary"
    Liquidity dol       // Draw on Liquidity (target)
    bool has_sweep      // Liquidity sweep present
    bool sweep_reclaimed // true when the sweep closed through the level and got back (no wick-only sweep)
    string momentum     // "strong_no_chop", "neutral", "weak_or_choppy"
    bool has_delivery   // true if price delivered from an active FVG during the setup's move
    string delivery_src // delivering FVG as "<TF> <bottom>-<top>" ("" = none, "same TF ..." = chart TF)
    string pd_zone      // "premium", "discount", "equilibrium", "neutral"
    int momentum_score     // 0=weak, 1=moderate, 2=strong (raw assess_momentum result)
    int singularity_score  // 0=not singular, 1=singular small, 2=singular obvious
    int target_score       // 0=no target, 1=target closer than the stop, 2=clear target (at inversion)
    bool has_lrlr          // LRLR (trendline liquidity) in the trade's path at inversion
    int pd_pct             // IFVG midpoint as 0-100% of the dealing range at inversion (na = no range)
    box box_id          // Reference to drawn box
    label label_id      // Reference to IFVG label (tiny "IFVG" text)
    line be_line_id     // Reference to BE line
    line sl_line_id     // Reference to SL line
    line entry_line_id  // Reference to entry line (at inversion close)
    label entry_label_id // Reference to entry line label (grade + direction)
    line formation_divider_id // Vertical line at inversion_bar dividing formation from live zone
    Trade trade         // Trade taken at the inversion close (na for HTF setups)

// ─────────────────────────────────────────────────────────────
// DealingRange — snapshot of the current HTF dealing range (PDZ-01..PDZ-08)
// Held in var g_current_range; rotated delete+recreate on new range selection.
// ─────────────────────────────────────────────────────────────
type DealingRange
    float  high_price      // selected ITH level
    float  low_price       // selected ITL level
    int    high_bar_idx    // chart bar_index where ITH was created
    int    low_bar_idx     // chart bar_index where ITL was created
    bool   is_valid        // true when both ITH and ITL currently selected
    line   line_high       // swing-H dashed line
    line   line_eq         // EQ dashed line
    line   line_low        // swing-L dashed line
    label  label_high      // "1 (price)" label
    label  label_eq        // "0.5 (price)" label
    label  label_low       // "0 (price)" label
    linefill fill_premium  // optional zone fill above EQ
    linefill fill_discount // optional zone fill below EQ
    line   ote_line_top    // optional OTE upper line
    line   ote_line_bot    // optional OTE lower line
    linefill ote_fill      // optional OTE fill

// ══════════════════════════════════════════════════════════════════════
// SECTION 2: INPUT CONFIGURATION
// ══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// General Settings
// ─────────────────────────────────────────────────────────────────────
string GROUP_GENERAL = "═══ General Settings ═══"
i_show_indicator    = input.bool(true, "Enable Indicator", group=GROUP_GENERAL)
i_max_fvgs          = input.int(3, "Max Active FVGs to Show", minval=2, maxval=50, group=GROUP_GENERAL,
                      tooltip="Maximum number of active (non-inverted) FVG boxes drawn. Detection always remembers more, so a series of gaps is never cut short.")
i_max_ifvgs         = input.int(10, "Max IFVGs to Track", minval=2, maxval=100, group=GROUP_GENERAL,
                      tooltip="Maximum number of IFVG setups to keep in memory. Independent of FVG limit.")
i_max_recent_display = input.int(2, "Max Recent IFVGs to Show", minval=1, maxval=20, group=GROUP_GENERAL,
                      tooltip="Only display the most recent N IFVG setups on chart (visual filter). Does not affect tracking.")
i_extend_bars       = input.int(15, "Extend Boxes (bars)", minval=10, maxval=200, group=GROUP_GENERAL,
                      tooltip="How many bars into the future to extend FVG boxes")

// ─────────────────────────────────────────────────────────────────────
// FVG Detection Settings
// ─────────────────────────────────────────────────────────────────────
string GROUP_FVG = "═══ FVG Detection ═══"
i_fvg_atr_period    = input.int(14, "ATR Period", minval=5, maxval=50, group=GROUP_FVG,
                      tooltip="ATR period used for minimum gap size calculation")
i_fvg_min_size_mult = input.float(0.25, "Min Gap Size (ATR Multiple)", minval=0.05, maxval=1.0,
                      step=0.05, group=GROUP_FVG,
                      tooltip="Minimum FVG size as a multiple of ATR. Lower = more sensitive")
i_show_active_fvg   = input.bool(true, "Show Active FVGs", group=GROUP_FVG,
                      tooltip="Display FVGs that haven't been inverted yet")
i_show_ifvg         = input.bool(true, "Show Inverted FVGs (IFVG)", group=GROUP_FVG,
                      tooltip="Display FVGs that have been inverted")
i_show_formation_divider = input.bool(true, "Show Formation Divider", group=GROUP_FVG,
                      tooltip="Draw a thin vertical line at the inversion bar separating the original FVG formation (left) from the post-inversion live zone (right).")

// ─────────────────────────────────────────────────────────────────────
// Higher Timeframe Settings (Phase 3)
// ─────────────────────────────────────────────────────────────────────
string GROUP_HTF = "═══ Higher Timeframe (HTF) ═══"
i_enable_htf        = input.bool(true, "Enable HTF Analysis", group=GROUP_HTF,
                      tooltip="Enable higher timeframe FVG/IFVG detection for bias")
i_htf_timeframe     = input.timeframe("60", "HTF Timeframe", group=GROUP_HTF,
                      tooltip="Higher timeframe for bias determination (e.g., 60 = 1H)")
i_htf_timeframe_2   = input.timeframe("240", "HTF Timeframe 2 (Optional)", group=GROUP_HTF,
                      tooltip="Second higher timeframe (e.g., 240 = 4H). Leave same as HTF1 to disable")
i_show_htf_fvg      = input.bool(true, "Show HTF FVGs", group=GROUP_HTF,
                      tooltip="Display HTF FVG boxes on chart")
i_show_htf_ifvg     = input.bool(true, "Show HTF IFVGs", group=GROUP_HTF,
                      tooltip="Display HTF IFVG boxes on chart")
i_htf_filter_ltf    = input.bool(true, "Filter LTF by HTF Bias", group=GROUP_HTF,
                      tooltip="Only show LTF setups that align with HTF bias direction")
i_htf_box_opacity   = input.int(75, "HTF Box Opacity (%)", minval=50, maxval=95, group=GROUP_HTF,
                      tooltip="Transparency for HTF boxes. Higher = more transparent")
i_htf_border_width  = input.int(3, "HTF Border Width", minval=1, maxval=5, group=GROUP_HTF,
                      tooltip="Thicker borders to distinguish HTF from LTF")

// ─────────────────────────────────────────────────────────────────────
// PD Zones (premium/discount) — Phase 2
// ─────────────────────────────────────────────────────────────────────
string GROUP_PD_ZONES = "═══ PD Zones ═══"
i_pd_timeframe                = input.timeframe("D",       "PD Timeframe",                  group=GROUP_PD_ZONES, tooltip="Higher timeframe used to derive the dealing range (default Daily).")
i_show_pd_lines               = input.bool(true, "Show PD Zone Lines",              group=GROUP_PD_ZONES)
i_show_pd_fills               = input.bool(false, "Show Zone Fills",                group=GROUP_PD_ZONES, tooltip="Linefill shading for premium (above EQ) and discount (below EQ).")
i_show_ote                    = input.bool(false, "Show OTE Band (62%-79%)",        group=GROUP_PD_ZONES, tooltip="Visual only — does not affect grading.")
i_pd_line_color               = input.color(color.white, "PD Line Color",           group=GROUP_PD_ZONES)
i_pd_eq_color                 = input.color(color.yellow, "EQ Line Color",          group=GROUP_PD_ZONES)
i_pd_line_width               = input.int(1, "PD Line Width", minval=1, maxval=4,   group=GROUP_PD_ZONES)
i_pd_sweep_min_atr_mult       = input.float(0.05, "PD Sweep Min Wick (ATR mult)", minval=0.0, maxval=1.0, step=0.01, group=GROUP_PD_ZONES, tooltip="Minimum wick protrusion beyond an ITH/ITL (as fraction of chart ATR) required to mark it swept. Higher = less sensitive. 0 disables the gate.")

// ─────────────────────────────────────────────────────────────────────
// Liquidity Detection Settings (Phase 2)
// ─────────────────────────────────────────────────────────────────────
string GROUP_LIQ = "═══ Liquidity Detection ═══"
i_show_ith_itl      = input.bool(true, "Show ITH/ITL", group=GROUP_LIQ,
                      tooltip="Display Internal Highs and Internal Lows")
i_show_mitigated_liq = input.bool(false, "Show Mitigated Liquidity", group=GROUP_LIQ,
                       tooltip="Keep displaying ITH/ITL and EQH/EQL after they're mitigated (swept ✗ or broken through ⊘)")
i_show_lrlr         = input.bool(true, "Show LRLR (Trendline Liquidity)", group=GROUP_LIQ,
                      tooltip="Draw low resistance liquidity runs: 3+ aligned lower highs above price or higher lows below price. Detection and grading run either way.")
i_show_data         = input.bool(true, "Show Data Highs/Lows", group=GROUP_LIQ,
                      tooltip="Draw the high and low of US news candles (8:30, 10:00, 14:00 New York) on 15m and lower. A candle counts only if it is at least 2x ATR. Detection and grading run either way.")

// ─────────────────────────────────────────────────────────────────────
// EQH/EQL Detection Settings (Enhanced)
// ─────────────────────────────────────────────────────────────────────
string GROUP_EQHL = "═══ EQH/EQL Detection ═══"
i_show_eqh_eql      = input.bool(true, "Show EQH/EQL", group=GROUP_EQHL,
                      tooltip="Display Equal Highs and Equal Lows")
i_perfect_tolerance = input.float(0.02, "Perfect EQL/EQH Tolerance (ATR)",
                      minval=0.01, maxval=0.05, step=0.01, group=GROUP_EQHL,
                      tooltip="Swings within this range are 'Perfect' EQL/EQH (★)")
i_relative_tolerance = input.float(0.10, "Relative EQL/EQH Tolerance (ATR)",
                       minval=0.05, maxval=0.25, step=0.01, group=GROUP_EQHL,
                       tooltip="Swings within this range are 'Relative' EQL/EQH (~)")
i_require_intact    = input.bool(true, "Require Intact Liquidity", group=GROUP_EQHL,
                      tooltip="Only form EQL/EQH if price hasn't broken through yet")
i_show_perfect_only = input.bool(false, "Show Perfect EQL/EQH Only", group=GROUP_EQHL,
                      tooltip="Hide relative EQL/EQH, only show perfect matches")

// ─────────────────────────────────────────────────────────────────────
// Grading Settings (Phase 2)
// ─────────────────────────────────────────────────────────────────────
string GROUP_GRADE = "═══ Grading Settings ═══"
i_min_grade_display = input.string("B-", "Min Grade to Display",
                      options=["A+", "A", "A-", "B+", "B", "B-", "C", "All"], group=GROUP_GRADE,
                      tooltip="Only show IFVGs with this grade or better")
i_show_be_level     = input.bool(true, "Show BE Levels", group=GROUP_GRADE,
                      tooltip="Display Break-Even point lines (first swing target)")
i_show_sl_level     = input.bool(true, "Show SL Levels", group=GROUP_GRADE,
                      tooltip="Display Stop Loss level lines")
i_sl_type           = input.string("Strong High/Low", "Stop Loss Type",
                      options=["Strong High/Low", "FVG Boundary"], group=GROUP_GRADE,
                      tooltip="Strong High/Low: SL at the setup's own low (longs) / high (shorts) - the extreme from the FVG formation to the inversion candle, which becomes the Strong Low/High once structure breaks. FVG Boundary: SL at the FVG edge")
i_show_grade_label  = input.bool(true, "Show Grade on Label", group=GROUP_GRADE,
                      tooltip="Include grade in IFVG label")

// ─────────────────────────────────────────────────────────────────────
// Visual Settings
// ─────────────────────────────────────────────────────────────────────
string GROUP_VISUAL = "═══ Visual Settings ═══"
i_bullish_color     = input.color(color.new(#089981, 0), "Bullish Color", group=GROUP_VISUAL)
i_bearish_color     = input.color(color.new(#F23645, 0), "Bearish Color", group=GROUP_VISUAL)
i_fvg_opacity       = input.int(85, "FVG Opacity (%)", minval=50, maxval=95, group=GROUP_VISUAL,
                      tooltip="Higher = more transparent. Active FVGs use this opacity")
i_show_labels       = input.bool(true, "Show Labels", group=GROUP_VISUAL)
i_label_size        = input.string("small", "Label Size", options=["tiny", "small", "normal"], group=GROUP_VISUAL)
i_liq_color         = input.color(color.orange, "Liquidity Color", group=GROUP_VISUAL,
                      tooltip="Color for liquidity lines (EQH/EQL)")
i_ithl_color        = input.color(color.yellow, "ITH/ITL Color", group=GROUP_VISUAL,
                      tooltip="Color for internal high/low lines")
i_be_color          = input.color(color.white, "BE Level Color", group=GROUP_VISUAL,
                      tooltip="Color for break-even level line")
i_sl_color          = input.color(color.red, "SL Level Color", group=GROUP_VISUAL,
                      tooltip="Color for stop loss level line")

// ─────────────────────────────────────────────────────────────────────
// IFVG Box & Entry Line Settings
// ─────────────────────────────────────────────────────────────────────
string GROUP_IFVG_STYLE = "═══ IFVG Style Settings ═══"
i_ifvg_box_color    = input.color(color.gray, "IFVG Box Color", group=GROUP_IFVG_STYLE,
                      tooltip="Fill color for IFVG boxes (translucent gray recommended)")
i_ifvg_box_opacity  = input.int(60, "IFVG Box Opacity (%)", minval=40, maxval=80, group=GROUP_IFVG_STYLE,
                      tooltip="Transparency level for IFVG boxes. Higher = more transparent")
i_show_entry_line   = input.bool(true, "Show Entry Line", group=GROUP_IFVG_STYLE,
                      tooltip="Display entry line at inversion candle close")
i_entry_color_bull  = input.color(color.new(#2962FF, 0), "Entry Line Color (Bullish)", group=GROUP_IFVG_STYLE,
                      tooltip="Color for bullish IFVG entry line (blue)")
i_entry_color_bear  = input.color(color.new(#F23645, 0), "Entry Line Color (Bearish)", group=GROUP_IFVG_STYLE,
                      tooltip="Color for bearish IFVG entry line (red)")

// ─────────────────────────────────────────────────────────────────────
// Border Settings
// ─────────────────────────────────────────────────────────────────────
string GROUP_BORDER = "═══ Border Settings ═══"
i_fvg_border_width  = input.int(1, "FVG Border Width", minval=1, maxval=4, group=GROUP_BORDER)
i_ifvg_border_width = input.int(2, "IFVG Border Width", minval=1, maxval=4, group=GROUP_BORDER)
i_fvg_border_style  = input.string("Solid", "FVG Border Style", options=["Solid", "Dashed", "Dotted"], group=GROUP_BORDER)
i_ifvg_border_style = input.string("Dashed", "IFVG Border Style", options=["Solid", "Dashed", "Dotted"], group=GROUP_BORDER)

// ─────────────────────────────────────────────────────────────────────
// Risk & Position (lot size, PnL zone, win/loss stats)
// ─────────────────────────────────────────────────────────────────────
string GROUP_RISK = "═══ Risk & Position ═══"
i_account_size      = input.float(10000.0, "Account Size (USD)", minval=1.0, step=1000.0, group=GROUP_RISK)
i_risk_type         = input.string("%", "Risk Type", options=["%", "USD"], group=GROUP_RISK,
                      tooltip="%: risk a percent of the account per trade. USD: risk a fixed dollar amount per trade. Risk is measured from entry to the IFVG box edge (open stop: a candle closing beyond the box)")
i_risk_value        = input.float(1.0, "Risk per Trade", minval=0.01, step=0.25, group=GROUP_RISK,
                      tooltip="Percent of the account or USD amount, per Risk Type. Size is rounded down so the risk is never exceeded")
i_target_mode       = input.string("Fixed R:R", "Take Profit", options=["Fixed R:R", "Setup Target"], group=GROUP_RISK,
                      tooltip="Fixed R:R: TP at entry ± R:R × risk. Setup Target: TP at the setup's target (liquidity level, LRLR origin, Data High/Low); falls back to the fixed R:R when the setup has none")
i_rr                = input.float(2.0, "R:R (Fixed)", minval=0.1, step=0.5, group=GROUP_RISK,
                      tooltip="Reward-to-risk for the Fixed R:R take profit: 1 = 1:1, 2 = 1:2")
i_show_size         = input.bool(true, "Show Lot Size & Risk", group=GROUP_RISK,
                      tooltip="Label on the latest valid setup: size, risk, reward, live open PnL. Hover it for the order ticket")
i_show_pnl          = input.bool(true, "Show PnL Zone", group=GROUP_RISK,
                      tooltip="Profit and loss boxes on the latest valid setup (entry to TP, entry to the IFVG box edge)")
i_pnl_profit_color  = input.color(color.new(#089981, 80), "PnL Profit Color", group=GROUP_RISK)
i_pnl_loss_color    = input.color(color.new(#F23645, 80), "PnL Loss Color", group=GROUP_RISK)
i_stats_min_grade   = input.string("All", "Min Grade (Stats & Strategy)",
                      options=["A+", "A", "A-", "B+", "B", "B-", "C", "All"], group=GROUP_RISK,
                      tooltip="Only setups with this grade or better count in the stats table. The strategy version only trades these")
i_show_stats        = input.bool(true, "Show Win/Loss Stats", group=GROUP_RISK,
                      tooltip="Win rate, breakeven rate and average R per grade over the loaded chart history, with ✓/✗/BE marks at past exits. Entry at the inversion close, 1R = entry to the IFVG box edge. Exit: TP wick, any candle closing beyond the box, a wick to the hard stop (SL line), or entry after the BE level was reached. No commission")

// ─────────────────────────────────────────────────────────────────────
// Alerts (push, popup, email: one alert covers every event)
// ─────────────────────────────────────────────────────────────────────
string GROUP_ALERT = "═══ Alerts ═══"
i_alert_min_grade   = input.string("A-", "Alert Min Grade",
                      options=["A+", "A", "A-", "B+", "B", "B-", "C", "All"], group=GROUP_ALERT,
                      tooltip="Only setups with this grade or better send alerts. Set up ONE alert: Create Alert → Condition: this indicator → \"Any alert() function call\". It covers every event below. Recreate the alert after changing any setting")
i_alert_setups      = input.bool(true, "Alert: New Setups", group=GROUP_ALERT,
                      tooltip="On the inversion candle close: direction, entry, open stop (close beyond the box), hard stop, TP, BE level, lot size and risk")
i_alert_updates     = input.bool(true, "Alert: Trade Updates", group=GROUP_ALERT,
                      tooltip="For setups that met the alert grade: BE level reached (move the stop to entry), candle closed beyond the box (exit), TP hit, hard stop hit, stopped at breakeven")

// ─────────────────────────────────────────────────────────────────────
// DEBUG (kept last so adding/removing it never shifts saved settings)
// ─────────────────────────────────────────────────────────────────────
GROUP_DEBUG = "Debug"
i_show_debug = input.bool(false, "Show Debug Panel", group=GROUP_DEBUG,
     tooltip="Shows swing and liquidity counters next to the last candle, for troubleshooting")

// ══════════════════════════════════════════════════════════════════════
// SECTION 3: GLOBAL VARIABLES & DATA STORES
// ══════════════════════════════════════════════════════════════════════

// FVG Arrays (LTF - current timeframe)
int FVG_MEMORY = 50  // active FVGs remembered for series/delivery checks (display limit is i_max_fvgs)
var array<FVG> g_fvg_array = array.new<FVG>()
var array<IFVG> g_ifvg_array = array.new<IFVG>()

// HTF FVG Arrays (Phase 3)
var array<FVG> g_htf_fvg_array = array.new<FVG>()
var array<FVG> g_htf2_fvg_array = array.new<FVG>()
var array<IFVG> g_htf_ifvg_array = array.new<IFVG>()
var array<IFVG> g_htf2_ifvg_array = array.new<IFVG>()

// Liquidity Arrays (Phase 2)
var array<SwingPoint> g_swing_highs = array.new<SwingPoint>()
var array<SwingPoint> g_swing_lows = array.new<SwingPoint>()
// Swing candidates awaiting displacement confirmation (automatic swing detection)
var array<SwingPoint> g_pending_highs = array.new<SwingPoint>()
var array<SwingPoint> g_pending_lows = array.new<SwingPoint>()
// Debug counters: candidates H, confirmed H, cancelled H, candidates L, confirmed L, cancelled L
var array<int> g_dbg_swing = array.from(0, 0, 0, 0, 0, 0)

// Swing detection rules (automatic, not user settings)
float SWING_CONFIRM_ATR = 1.0  // Close this many ATRs away from a candidate confirms it
int SWING_PENDING_MAX   = 20   // Max unconfirmed candidates kept per side
int SWING_MEMORY_MAX    = 50   // Max confirmed swings kept per side
var array<Liquidity> g_liquidity_array = array.new<Liquidity>()
// Last swing bar turned into an ITH [0] / ITL [1] — prevents re-creating a level
// that was already swept/broken and forgotten
var array<int> g_last_internal_bar = array.from(-1, -1)
// LRLR per side: 0 = lower highs (above price), 1 = higher lows (below price)
var array<LRLR> g_lrlr = array.new<LRLR>(2)
var array<int> g_lrlr_last_swing = array.from(-1, -1)  // newest swing bar each side was built from
int LRLR_MIN_POINTS = 3     // Swings needed for a trendline
float LRLR_FIT_ATR  = 0.25  // Max distance (ATR) of a middle swing from the line
// Data (news) candles: [release bar index, ATR before the release] while the next candle is checked
var array<float> g_data_pending = array.new<float>(2, na)
float DATA_RANGE_ATR = 2.0   // Candle range (x ATR before the release) that marks a real release
int DATA_MAX_TF_SECS = 900   // Data candles only on 15m and lower
color DATA_COLOR     = #E040FB  // Data High/Low lines (purple)

// Liquidity memory rules (automatic, not user settings)
// Live levels are remembered until swept or broken, regardless of age.
// Mitigated levels are kept LIQ_MITIGATED_KEEP_BARS for sweep crediting, then forgotten.
int LIQ_MEMORY_MAX          = 200  // Hard cap on remembered levels
int LIQ_MITIGATED_KEEP_BARS = 500  // Matches max_bars_back (sweep window limit)
int LIQ_DRAW_PER_SIDE       = 3    // Live levels drawn above and below price (per strong/weak group)
int SWEEP_MAX_CLOSES_BEYOND = 3    // Closes beyond a level a setup sweep may have before getting back

// PD zone state (Phase 2)
var array<SwingPoint> g_pd_swing_highs = array.new<SwingPoint>()
var array<SwingPoint> g_pd_swing_lows  = array.new<SwingPoint>()
var array<Liquidity>  g_pd_liquidity_array = array.new<Liquidity>()
var DealingRange      g_current_range = na
var int               g_prev_pd_bar   = na

// ATR for sizing
atr_value = ta.atr(i_fvg_atr_period)
atr_prev = atr_value[1]  // ATR before the current candle (Data candle size check)
// Approx. height of one small label in price: 2.5% of the recent price span (labels closer than this overlap)
float g_label_gap = (ta.highest(high, 100) - ta.lowest(low, 100)) * 0.025

// Trades taken at each chart-TF setup (position size, PnL zone, win/loss stats)
var array<Trade> g_open_trades = array.new<Trade>()
var array<int> g_stat_wins = array.new<int>(7, 0)        // Per grade, index 0 = A+ ... 6 = C
var array<int> g_stat_losses = array.new<int>(7, 0)
var array<int> g_stat_be = array.new<int>(7, 0)          // Breakeven exits (0R)
var array<float> g_stat_r = array.new<float>(7, 0.0)    // Sum of R per grade
var array<label> g_trade_marks = array.new<label>()     // ✓/✗ marks at past exits
var array<box> g_pos_boxes = array.new<box>(2)          // 0 = loss box, 1 = profit box
var array<label> g_pos_label = array.new<label>(1)      // Lot size & risk label
int TRADES_OPEN_MAX = 100   // Open trades tracked at once
int TRADE_MARKS_MAX = 50    // ✓/✗ marks kept on the chart
var array<string> g_alert_msgs = array.new<string>()    // Alert messages queued this candle
// Symbol currency → USD (1 for USD-quoted symbols)
float fx_rate = request.currency_rate(syminfo.currency, "USD", ignore_invalid_currency=true)
float g_fx = syminfo.currency == "USD" ? 1.0 : nz(fx_rate, 1.0)

// Swing inputs, evaluated on every bar at global scope (history references kept out of functions)
bool swing_ready = barstate.isconfirmed and bar_index >= 2 and not na(atr_value)
bool swing_cand_high = high[1] > high[2] and high[1] >= high
bool swing_cand_low = low[1] < low[2] and low[1] <= low

// ══════════════════════════════════════════════════════════════════════
// SECTION 4: UTILITY FUNCTIONS
// ══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// Clamp a drawing's left x-coordinate to TradingView's 5000-bar limit
// Keeps the true formation anchor unless it is more than 4999 bars back
// (otherwise box.new/line.new throw "bar index too far" errors)
// ─────────────────────────────────────────────────────────────────────
clamp_left_bar(int x) =>
    int(math.max(x, bar_index - 4999))

// ─────────────────────────────────────────────────────────────────────
// Get label size from string
// ─────────────────────────────────────────────────────────────────────
get_label_size() =>
    result = size.small
    switch i_label_size
        "tiny"   => result := size.tiny
        "small"  => result := size.small
        "normal" => result := size.normal
    result

// ─────────────────────────────────────────────────────────────────────
// Get color based on direction and status
// ─────────────────────────────────────────────────────────────────────
get_fvg_color(bool is_bullish) =>
    base_color = is_bullish ? i_bullish_color : i_bearish_color
    color.new(base_color, i_fvg_opacity)

get_border_color(bool is_bullish) =>
    is_bullish ? i_bullish_color : i_bearish_color

// ─────────────────────────────────────────────────────────────────────
// Get border style from string input
// ─────────────────────────────────────────────────────────────────────
get_border_style(string style_str) =>
    result = line.style_solid
    switch style_str
        "Solid"  => result := line.style_solid
        "Dashed" => result := line.style_dashed
        "Dotted" => result := line.style_dotted
    result

// ─────────────────────────────────────────────────────────────────────
// Grade to numeric value for comparison
// ─────────────────────────────────────────────────────────────────────
grade_to_value(string grade) =>
    int result = 0
    switch grade
        "A+" => result := 7
        "A"  => result := 6
        "A-" => result := 5
        "B+" => result := 4
        "B"  => result := 3
        "B-" => result := 2
        "C"  => result := 1
    result

// ─────────────────────────────────────────────────────────────────────
// Check if grade meets minimum threshold
// ─────────────────────────────────────────────────────────────────────
grade_meets_minimum(string grade, string min_grade) =>
    if min_grade == "All"
        true
    else
        grade_to_value(grade) >= grade_to_value(min_grade)

// ─────────────────────────────────────────────────────────────────────
// Grade to color for visual distinction
// ─────────────────────────────────────────────────────────────────────
grade_to_color(string grade) =>
    color result = color.gray
    switch grade
        "A+" => result := color.new(#00FF00, 0)  // Bright green
        "A"  => result := color.new(#00CC00, 0)  // Green
        "A-" => result := color.new(#66CC00, 0)  // Yellow-green
        "B+" => result := color.new(#FFCC00, 0)  // Yellow
        "B"  => result := color.new(#FF9900, 0)  // Orange
        "B-" => result := color.new(#FF6600, 0)  // Dark orange
        "C"  => result := color.new(#FF3333, 0)  // Red
    result

// ─────────────────────────────────────────────────────────────────────
// Clean up arrays when they exceed limits
// ─────────────────────────────────────────────────────────────────────
// NOTE: memory is fixed (FVG_MEMORY); i_max_fvgs only limits how many boxes are drawn
cleanup_fvg_array() =>
    while array.size(g_fvg_array) > FVG_MEMORY
        old_fvg = array.shift(g_fvg_array)
        if not na(old_fvg.box_id)
            box.delete(old_fvg.box_id)
        if not na(old_fvg.label_id)
            label.delete(old_fvg.label_id)

cleanup_ifvg_array() =>
    while array.size(g_ifvg_array) > i_max_ifvgs
        old_ifvg = array.shift(g_ifvg_array)
        if not na(old_ifvg.box_id)
            box.delete(old_ifvg.box_id)
        if not na(old_ifvg.label_id)
            label.delete(old_ifvg.label_id)
        if not na(old_ifvg.be_line_id)
            line.delete(old_ifvg.be_line_id)
        if not na(old_ifvg.sl_line_id)
            line.delete(old_ifvg.sl_line_id)
        if not na(old_ifvg.entry_line_id)
            line.delete(old_ifvg.entry_line_id)
        if not na(old_ifvg.entry_label_id)
            label.delete(old_ifvg.entry_label_id)
        if not na(old_ifvg.formation_divider_id)
            line.delete(old_ifvg.formation_divider_id)

// ─────────────────────────────────────────────────────────────────────
// Liquidity side: buy-side (highs) or sell-side (lows)
// ─────────────────────────────────────────────────────────────────────
is_bsl(Liquidity liq) =>
    liq.liq_type == "EQH" or liq.liq_type == "ITH" or liq.liq_type == "Data High"

is_ssl(Liquidity liq) =>
    liq.liq_type == "EQL" or liq.liq_type == "ITL" or liq.liq_type == "Data Low"

// ─────────────────────────────────────────────────────────────────────
// Delete a liquidity level's line and label
// ─────────────────────────────────────────────────────────────────────
delete_liquidity_drawings(Liquidity liq) =>
    if not na(liq.line_id)
        line.delete(liq.line_id)
        liq.line_id := na
    if not na(liq.label_id)
        label.delete(liq.label_id)
        liq.label_id := na

// ─────────────────────────────────────────────────────────────────────
// Liquidity memory cleanup (no user setting)
// RULE 1: Live levels stay remembered until swept or broken, however old.
// RULE 2: Mitigated levels are forgotten LIQ_MITIGATED_KEEP_BARS after mitigation.
// RULE 3: Above LIQ_MEMORY_MAX, drop the oldest mitigated level first; when none
//         are mitigated, drop the live level FARTHEST from price (least likely
//         to be swept or targeted soon), so major levels within reach stay remembered.
// ─────────────────────────────────────────────────────────────────────
cleanup_liquidity_array() =>
    int n = array.size(g_liquidity_array)
    if n > 0
        for i = n - 1 to 0
            Liquidity liq = array.get(g_liquidity_array, i)
            bool mitigated = liq.is_swept or not liq.is_valid
            if mitigated and not na(liq.mitigated_bar) and bar_index - liq.mitigated_bar > LIQ_MITIGATED_KEEP_BARS
                delete_liquidity_drawings(liq)
                array.remove(g_liquidity_array, i)
    while array.size(g_liquidity_array) > LIQ_MEMORY_MAX
        int drop_idx = -1
        int far_idx = 0
        float far_dist = -1.0
        int sz = array.size(g_liquidity_array)
        for i = 0 to sz - 1
            Liquidity liq = array.get(g_liquidity_array, i)
            if liq.is_swept or not liq.is_valid
                drop_idx := i
                break
            float dist = math.abs(liq.level - close)
            if dist > far_dist
                far_dist := dist
                far_idx := i
        if drop_idx < 0
            drop_idx := far_idx
        Liquidity old_liq = array.remove(g_liquidity_array, drop_idx)
        delete_liquidity_drawings(old_liq)

// ─────────────────────────────────────────────────────────────────────
// Check if a swing level is still intact (not broken through)
// For EQL: returns true if price never CLOSED below the swing low
// For EQH: returns true if price never CLOSED above the swing high
// ─────────────────────────────────────────────────────────────────────
is_swing_intact(float swing_price, bool is_low, int swing_bar) =>
    bool intact = true
    int bars_to_check = bar_index - swing_bar

    // Limit check to prevent performance issues
    int max_check = math.min(bars_to_check, 500)

    if max_check > 0
        for i = 0 to max_check - 1
            if is_low
                // For lows: check if price ever CLOSED below
                if close[i] < swing_price
                    intact := false
                    break
            else
                // For highs: check if price ever CLOSED above
                if close[i] > swing_price
                    intact := false
                    break

    intact

// ─────────────────────────────────────────────────────────────────────
// Classify EQL/EQH quality based on price difference
// ─────────────────────────────────────────────────────────────────────
get_eqhl_quality(float price_diff, float atr) =>
    string quality = "none"

    if not na(atr) and atr > 0
        float perfect_thresh = atr * i_perfect_tolerance
        float relative_thresh = atr * i_relative_tolerance

        if price_diff <= perfect_thresh
            quality := "perfect"
        else if price_diff <= relative_thresh
            quality := "relative"

    quality

// ─────────────────────────────────────────────────────────────────────
// Check if new swing forms valid EQL (must be AT or ABOVE previous)
// ─────────────────────────────────────────────────────────────────────
is_valid_eql_formation(float swing1_low, float swing2_low, float tolerance) =>
    // Swing 2 must be >= Swing 1 (within small tolerance for "exactly equal")
    // This ensures new low is at same level or holding higher (support holding)
    swing2_low >= swing1_low - tolerance

// ─────────────────────────────────────────────────────────────────────
// Check if new swing forms valid EQH (must be AT or BELOW previous)
// ─────────────────────────────────────────────────────────────────────
is_valid_eqh_formation(float swing1_high, float swing2_high, float tolerance) =>
    // Swing 2 must be <= Swing 1 (within small tolerance for "exactly equal")
    // This ensures new high is at same level or failing to break (resistance holding)
    swing2_high <= swing1_high + tolerance

// ─────────────────────────────────────────────────────────────────────
// Check if liquidity was swept between two swing points (WICK-based)
// For EQH: Returns true if any bar's HIGH went above the reference level
// For EQL: Returns true if any bar's LOW went below the reference level
// This includes the second swing bar itself
// ─────────────────────────────────────────────────────────────────────
was_liquidity_swept_between(int bar1_idx, int bar2_idx, float ref_level, bool check_highs) =>
    bool swept = false
    int bars_between = bar_index - bar1_idx  // How many bars back is bar1
    int bars_to_bar2 = bar_index - bar2_idx  // How many bars back is bar2

    // Loop from bar1+1 to bar2 (inclusive of bar2)
    if bars_between > 0 and bars_to_bar2 >= 0
        for offset = bars_between - 1 to bars_to_bar2
            if offset >= 0 and offset < bars_between
                if check_highs
                    // For EQH: check if any HIGH exceeded the reference level
                    if high[offset] > ref_level
                        swept := true
                        break
                else
                    // For EQL: check if any LOW went below the reference level
                    if low[offset] < ref_level
                        swept := true
                        break
    swept

// ─────────────────────────────────────────────────────────────────────
// Get combined HTF bias from HTF IFVG arrays
// Returns "bullish", "bearish", or "neutral"
// ─────────────────────────────────────────────────────────────────────
get_htf_bias() =>
    string htf1_b = "neutral"
    string htf2_b = "neutral"
    if array.size(g_htf_ifvg_array) > 0
        IFVG htf1_r = array.get(g_htf_ifvg_array, array.size(g_htf_ifvg_array) - 1)
        htf1_b := htf1_r.status == "inverted" ? (htf1_r.is_bullish ? "bullish" : "bearish") : "neutral"
    if array.size(g_htf2_ifvg_array) > 0
        IFVG htf2_r = array.get(g_htf2_ifvg_array, array.size(g_htf2_ifvg_array) - 1)
        htf2_b := htf2_r.status == "inverted" ? (htf2_r.is_bullish ? "bullish" : "bearish") : "neutral"
    string result = htf1_b != "neutral" ? htf1_b : htf2_b
    result

// ─────────────────────────────────────────────────────────────────────
// Merge a new FVG with an existing same-direction FVG if within the same leg
// Per strategy (Section 7.1): combine series of gaps into one zone,
// wait for all to be inverted before grading
// Returns true if merged (new FVG absorbed into existing), false if standalone
// ─────────────────────────────────────────────────────────────────────
merge_with_existing_fvg(FVG new_fvg) =>
    bool merged = false
    int fvg_count = array.size(g_fvg_array)
    if fvg_count > 0
        for j = fvg_count - 1 to 0
            FVG existing = array.get(g_fvg_array, j)
            // Same direction, active, within 5 bars
            if existing.is_bullish == new_fvg.is_bullish and existing.status == "active"
                int bar_distance = int(math.abs(new_fvg.end_bar - existing.end_bar))
                if bar_distance <= 5
                    // Combined-span scan: block merge when ANY opposite-color
                    // candle exists anywhere across the full combined region
                    // [existing.start_bar, new_fvg.end_bar]. This single sweep
                    // covers both 3-candle FVG windows AND the gap between them,
                    // including outer candles. Dojis are neutral and never block.
                    bool opposite_found = false
                    int span_from = int(math.min(existing.start_bar, new_fvg.start_bar))
                    int span_to = int(math.max(existing.end_bar, new_fvg.end_bar))
                    if span_to >= span_from
                        for k = span_from to span_to
                            int offset = bar_index - k
                            if offset >= 0
                                if new_fvg.is_bullish
                                    if close[offset] < open[offset]
                                        opposite_found := true
                                if not new_fvg.is_bullish
                                    if close[offset] > open[offset]
                                        opposite_found := true
                    if not opposite_found
                        // Merge: extend existing FVG to encompass new one
                        float combined_top = math.max(existing.top, new_fvg.top)
                        float combined_bottom = math.min(existing.bottom, new_fvg.bottom)
                        existing.top := combined_top
                        existing.bottom := combined_bottom
                        existing.mid := (combined_top + combined_bottom) / 2
                        existing.end_bar := int(math.max(existing.end_bar, new_fvg.end_bar))
                        // Redraw the box to reflect combined zone
                        if not na(existing.box_id)
                            box.delete(existing.box_id)
                            existing.box_id := na
                        if not na(existing.label_id)
                            label.delete(existing.label_id)
                            existing.label_id := na
                        merged := true
                        break
    merged

// ─────────────────────────────────────────────────────────────────────
// PD Zone helpers (Phase 2)
// ─────────────────────────────────────────────────────────────────────
// Returns true when chart TF < PD TF (i.e., PD fetch via request.security is meaningful).
// When false, fall back to chart-TF g_liquidity_array. (D-05)
is_pd_tf_higher() =>
    timeframe.in_seconds(i_pd_timeframe) > timeframe.in_seconds(timeframe.period)

// ─────────────────────────────────────────────────────────────────────
// Get timeframe display label
// ─────────────────────────────────────────────────────────────────────
get_tf_label(string tf) =>
    string result = tf
    if tf == "1"
        result := "1m"
    else if tf == "3"
        result := "3m"
    else if tf == "5"
        result := "5m"
    else if tf == "15"
        result := "15m"
    else if tf == "30"
        result := "30m"
    else if tf == "60"
        result := "1H"
    else if tf == "120"
        result := "2H"
    else if tf == "240"
        result := "4H"
    result

// Computes pd_zone for an IFVG midpoint against the current range.
// Strict 50% equilibrium (D-13). Returns "neutral" when no valid range (D-06).
compute_pd_zone(float price_mid) =>
    string result = "neutral"
    if not na(g_current_range) and g_current_range.is_valid
        float hi = g_current_range.high_price
        float lo = g_current_range.low_price
        if hi > lo
            float eq = (hi + lo) / 2.0
            if price_mid > eq
                result := "premium"
            else if price_mid < eq
                result := "discount"
            else
                result := "equilibrium"
    result

// Integer 0-100 or na when no valid range (DSH-02).
compute_range_percent(float price_mid) =>
    int result = na
    if not na(g_current_range) and g_current_range.is_valid
        float hi = g_current_range.high_price
        float lo = g_current_range.low_price
        float span = hi - lo
        if span > 0
            result := int(math.round((price_mid - lo) / span * 100))
    result

// ══════════════════════════════════════════════════════════════════════
// SECTION 5: FVG DETECTION
// ══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// Detect Fair Value Gaps
// ─────────────────────────────────────────────────────────────────────
detect_fvg() =>
    FVG result = na

    if barstate.isconfirmed and not na(atr_value)
        min_gap = atr_value * i_fvg_min_size_mult

        // Bullish FVG: low[0] > high[2]
        bullish_gap_size = low - high[2]
        if bullish_gap_size > min_gap
            result := FVG.new(
                top = low,
                bottom = high[2],
                mid = (low + high[2]) / 2,
                start_bar = bar_index - 2,
                end_bar = bar_index,
                is_bullish = true,
                status = "active",
                timeframe = "",
                box_id = na,
                label_id = na
            )

        // Bearish FVG: high[0] < low[2]
        bearish_gap_size = low[2] - high
        if bearish_gap_size > min_gap and na(result)
            result := FVG.new(
                top = low[2],
                bottom = high,
                mid = (low[2] + high) / 2,
                start_bar = bar_index - 2,
                end_bar = bar_index,
                is_bullish = false,
                status = "active",
                timeframe = "",
                box_id = na,
                label_id = na
            )

    result

// ══════════════════════════════════════════════════════════════════════
// SECTION 5B: HTF FVG DETECTION (Phase 3)
// ══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// Get HTF OHLC data via request.security
// ─────────────────────────────────────────────────────────────────────
// request.security budget: 3 calls used pre-Phase-2; 4 calls / 16 tuple elements after Phase 2 PD pivots (D-01)
// HTF 1 Data - Consolidated tuple (7 elements)
[htf_high, htf_low, htf_close, htf_high_2, htf_low_2, htf_bar_idx_raw, htf_atr, htf_prev_col] = request.security(syminfo.tickerid, i_htf_timeframe, [high, low, close, high[2], low[2], bar_index, ta.atr(i_fvg_atr_period), math.sign(close[1] - open[1])], lookahead = barmerge.lookahead_off)
int htf_bar_idx = int(htf_bar_idx_raw)

// HTF 2 Data - Consolidated tuple (7 elements)
[htf2_high, htf2_low, htf2_close, htf2_high_2, htf2_low_2, htf2_bar_idx_raw, htf2_atr, htf2_prev_col] = request.security(syminfo.tickerid, i_htf_timeframe_2, [high, low, close, high[2], low[2], bar_index, ta.atr(i_fvg_atr_period), math.sign(close[1] - open[1])], lookahead = barmerge.lookahead_off)
int htf2_bar_idx = int(htf2_bar_idx_raw)

// ─── PD timeframe swing data (Phase 2 — PDZ-01) ─────────────
// 1 call, 4 tuple elements. Security-call budget: 3 -> 4 of 40 after Phase 2.
// Same automatic swing rule as the chart (no lookback setting), evaluated on the PD TF:
// RULE 1: candidate = ICT 3-candle swing at [1] (first of equal highs/lows wins).
// RULE 2: confirmed when a PD candle closes SWING_CONFIRM_ATR x PD-ATR away.
// RULE 3: cancelled when price trades beyond it before confirmation.
// Returns the newest swing high/low confirmed on this PD bar (price, and its age in PD
// bars from swing candle to confirmation); na when none confirmed.
// NOTE: if several swings on one side confirm on the same PD bar, only the newest is used.
pd_swing_feed() =>
    var array<float> pend_h = array.new<float>()
    var array<int> pend_h_bar = array.new<int>()
    var array<float> pend_l = array.new<float>()
    var array<int> pend_l_bar = array.new<int>()
    float pd_atr = ta.atr(i_fvg_atr_period)
    bool cand_h = high[1] > high[2] and high[1] >= high
    bool cand_l = low[1] < low[2] and low[1] <= low
    float out_h = na
    int out_h_age = na
    float out_l = na
    int out_l_age = na
    if bar_index >= 2 and not na(pd_atr)
        if cand_h
            array.push(pend_h, high[1])
            array.push(pend_h_bar, bar_index - 1)
            if array.size(pend_h) > SWING_PENDING_MAX
                array.shift(pend_h)
                array.shift(pend_h_bar)
        if cand_l
            array.push(pend_l, low[1])
            array.push(pend_l_bar, bar_index - 1)
            if array.size(pend_l) > SWING_PENDING_MAX
                array.shift(pend_l)
                array.shift(pend_l_bar)
        int ih = 0
        while ih < array.size(pend_h)
            float ph = array.get(pend_h, ih)
            bool resolved = false
            if high > ph
                resolved := true
            else if close <= ph - pd_atr * SWING_CONFIRM_ATR
                out_h := ph
                out_h_age := bar_index - array.get(pend_h_bar, ih)
                resolved := true
            if resolved
                array.remove(pend_h, ih)
                array.remove(pend_h_bar, ih)
            ih := resolved ? ih : ih + 1
        int il = 0
        while il < array.size(pend_l)
            float pl = array.get(pend_l, il)
            bool resolved = false
            if low < pl
                resolved := true
            else if close >= pl + pd_atr * SWING_CONFIRM_ATR
                out_l := pl
                out_l_age := bar_index - array.get(pend_l_bar, il)
                resolved := true
            if resolved
                array.remove(pend_l, il)
                array.remove(pend_l_bar, il)
            il := resolved ? il : il + 1
    [out_h, out_h_age, out_l, out_l_age]

[pd_pivot_high_raw, pd_pivot_high_age, pd_pivot_low_raw, pd_pivot_low_age] = request.security(syminfo.tickerid, i_pd_timeframe, pd_swing_feed(), lookahead = barmerge.lookahead_off)
// Confirmation-lag window (chart bars) of the most recent PD swing, used by check_pd_sweeps()
var int g_pd_lag_bars = 1

// Track HTF bar changes to detect new HTF bars
var int prev_htf_bar = na
var int prev_htf2_bar = na
bool htf_bar_changed = na(prev_htf_bar) or htf_bar_idx != prev_htf_bar
bool htf2_bar_changed = na(prev_htf2_bar) or htf2_bar_idx != prev_htf2_bar
prev_htf_bar := htf_bar_idx
prev_htf2_bar := htf2_bar_idx

// HTF candle colors (1 = up, -1 = down, 0 = doji) by HTF bar_index, recorded when each
// HTF bar closes. Used by the series-of-gaps rule on HTF FVGs.
var array<int> g_htf_col_bar = array.new<int>()
var array<int> g_htf_col = array.new<int>()
var array<int> g_htf2_col_bar = array.new<int>()
var array<int> g_htf2_col = array.new<int>()
if htf_bar_changed and not na(htf_prev_col)
    array.push(g_htf_col_bar, htf_bar_idx - 1)
    array.push(g_htf_col, int(htf_prev_col))
    if array.size(g_htf_col_bar) > 200
        array.shift(g_htf_col_bar)
        array.shift(g_htf_col)
if htf2_bar_changed and not na(htf2_prev_col)
    array.push(g_htf2_col_bar, htf2_bar_idx - 1)
    array.push(g_htf2_col, int(htf2_prev_col))
    if array.size(g_htf2_col_bar) > 200
        array.shift(g_htf2_col_bar)
        array.shift(g_htf2_col)

// ─────────────────────────────────────────────────────────────────────
// Detect HTF Fair Value Gaps
// ─────────────────────────────────────────────────────────────────────
detect_htf_fvg(string tf, float h, float l, float h2, float l2, float atr_val, bool bar_changed) =>
    FVG result = na

    if i_enable_htf and bar_changed and barstate.isconfirmed and not na(atr_val)
        min_gap = atr_val * i_fvg_min_size_mult

        // Bullish FVG: current low > high[2]
        bullish_gap_size = l - h2
        if bullish_gap_size > min_gap
            result := FVG.new(
                top = l,
                bottom = h2,
                mid = (l + h2) / 2,
                start_bar = bar_index - 2,  // Approximate LTF bar position
                end_bar = bar_index,
                is_bullish = true,
                status = "active",
                timeframe = tf,
                box_id = na,
                label_id = na
            )

        // Bearish FVG: current high < low[2]
        bearish_gap_size = l2 - h
        if bearish_gap_size > min_gap and na(result)
            result := FVG.new(
                top = l2,
                bottom = h,
                mid = (l2 + h) / 2,
                start_bar = bar_index - 2,
                end_bar = bar_index,
                is_bullish = false,
                status = "active",
                timeframe = tf,
                box_id = na,
                label_id = na
            )

    result

// ─────────────────────────────────────────────────────────────────────
// Check if HTF FVG already exists (avoid duplicates)
// ─────────────────────────────────────────────────────────────────────
htf_fvg_exists(array<FVG> arr, float top, float bottom, bool is_bullish) =>
    bool exists = false
    int arr_size = array.size(arr)
    if arr_size > 0
        for i = 0 to arr_size - 1
            fvg = array.get(arr, i)
            // Check if same zone (with small tolerance)
            float tolerance = atr_value * 0.1
            if fvg.is_bullish == is_bullish and
               math.abs(fvg.top - top) < tolerance and
               math.abs(fvg.bottom - bottom) < tolerance
                exists := true
                break
    exists

// ─────────────────────────────────────────────────────────────────────
// Cleanup HTF arrays
// ─────────────────────────────────────────────────────────────────────
cleanup_htf_fvg_array(array<FVG> arr, int max_count) =>
    while array.size(arr) > max_count
        old_fvg = array.shift(arr)
        if not na(old_fvg.box_id)
            box.delete(old_fvg.box_id)
        if not na(old_fvg.label_id)
            label.delete(old_fvg.label_id)

cleanup_htf_ifvg_array(array<IFVG> arr, int max_count) =>
    while array.size(arr) > max_count
        old_ifvg = array.shift(arr)
        if not na(old_ifvg.box_id)
            box.delete(old_ifvg.box_id)
        if not na(old_ifvg.label_id)
            label.delete(old_ifvg.label_id)

// ─────────────────────────────────────────────────────────────────────
// HTF candle color recorded for an HTF bar (1 up, -1 down, 0 doji; na if unknown)
// ─────────────────────────────────────────────────────────────────────
htf_color_at(array<int> col_bars, array<int> cols, int htf_bar) =>
    int result = na
    int n = array.size(col_bars)
    if n > 0
        for i = n - 1 to 0
            int b = array.get(col_bars, i)
            if b == htf_bar
                result := array.get(cols, i)
            if b <= htf_bar
                break
    result

// ─────────────────────────────────────────────────────────────────────
// Check HTF FVG inversions (simplified - no full grading)
// Series of gaps (strategy 7.1) as on the chart timeframe: same-direction HTF FVGs made
// by one unbroken run of HTF displacement candles are one zone, inverted only when the
// HTF close is through ALL of them. Candles between two HTF FVG windows must all be the
// move's color (dojis neutral); an opposite-color or unknown HTF candle ends the series.
// ─────────────────────────────────────────────────────────────────────
check_htf_inversions(array<FVG> fvg_arr, array<IFVG> ifvg_arr, float htf_c, string tf, array<int> col_bars, array<int> cols) =>
    int fvg_size = array.size(fvg_arr)
    if barstate.isconfirmed and fvg_size > 0 and not na(htf_c)
        for i = fvg_size - 1 to 0
            fvg = array.get(fvg_arr, i)
            if fvg.status == "active" and bar_index - fvg.end_bar >= 1
                bool inverted = fvg.is_bullish ? htf_c < fvg.bottom : htf_c > fvg.top
                float s_top = fvg.top
                float s_bottom = fvg.bottom
                int s_start = fvg.start_bar
                int s_htf_start = na(fvg.htf_end) ? na : fvg.htf_end - 2
                if inverted and i > 0 and not na(s_htf_start)
                    bool chain_open = true
                    for j = i - 1 to 0
                        FVG other = array.get(fvg_arr, j)
                        bool candidate = (chain_open and other.status == "active" and other.is_bullish == fvg.is_bullish and not na(other.htf_end) and other.htf_end - 2 < s_htf_start)
                        if candidate
                            bool pause = false
                            int from_b = other.htf_end + 1
                            int to_b = s_htf_start - 1
                            if to_b >= from_b
                                for b = from_b to to_b
                                    int c = htf_color_at(col_bars, cols, b)
                                    if na(c)
                                        pause := true
                                    else if fvg.is_bullish ? c < 0 : c > 0
                                        pause := true
                            if pause
                                chain_open := false
                            else
                                s_top := math.max(s_top, other.top)
                                s_bottom := math.min(s_bottom, other.bottom)
                                s_start := int(math.min(s_start, other.start_bar))
                                s_htf_start := other.htf_end - 2
                    inverted := fvg.is_bullish ? htf_c < s_bottom : htf_c > s_top
                if inverted
                    // Mark the series inverted and delete its drawings (removed after the loop)
                    for j = 0 to i
                        FVG member = array.get(fvg_arr, j)
                        bool in_series = (member.status == "active" and member.is_bullish == fvg.is_bullish and not na(member.htf_end) and not na(s_htf_start) and member.htf_end - 2 >= s_htf_start)
                        if j == i or in_series
                            member.status := "inverted"
                            if not na(member.box_id)
                                box.delete(member.box_id)
                                member.box_id := na
                            if not na(member.label_id)
                                label.delete(member.label_id)
                                member.label_id := na
                    // IFVG direction is INVERTED from FVG
                    bool ifvg_is_bullish = not fvg.is_bullish
                    // Create simplified HTF IFVG (no grading needed for bias)
                    new_ifvg = IFVG.new(
                        top = s_top,
                        bottom = s_bottom,
                        mid = (s_top + s_bottom) / 2,
                        start_bar = s_start,
                        inversion_bar = bar_index,
                        inversion_close = htf_c,
                        is_bullish = ifvg_is_bullish,
                        status = "inverted",
                        grade = "HTF",  // Mark as HTF
                        entry_valid = true,
                        be_level = ifvg_is_bullish ? s_top : s_bottom,
                        be_status = "intact",
                        sl_level = ifvg_is_bullish ? s_bottom : s_top,
                        sl_type = "fvg_boundary",
                        dol = na,
                        has_sweep = false,
                        momentum = "neutral",
                        has_delivery = false,
                        pd_zone = "neutral",
                        momentum_score = 0,
                        singularity_score = 0,
                        box_id = na,
                        label_id = na,
                        be_line_id = na,
                        sl_line_id = na,
                        entry_line_id = na,
                        entry_label_id = na,
                        formation_divider_id = na
                    )
                    array.push(ifvg_arr, new_ifvg)
        // Remove every HTF FVG inverted on this bar (series members included)
        if array.size(fvg_arr) > 0
            for r = array.size(fvg_arr) - 1 to 0
                if array.get(fvg_arr, r).status == "inverted"
                    array.remove(fvg_arr, r)

// ─────────────────────────────────────────────────────────────────────
// Check HTF IFVG mitigation
// ─────────────────────────────────────────────────────────────────────
check_htf_mitigations(array<IFVG> ifvg_arr, float htf_c) =>
    int ifvg_size = array.size(ifvg_arr)
    if barstate.isconfirmed and ifvg_size > 0 and not na(htf_c)
        for i = ifvg_size - 1 to 0
            if i >= 0 and i < array.size(ifvg_arr)
                ifvg = array.get(ifvg_arr, i)

                if ifvg.status == "inverted"
                    bool mitigated = false

                    // Bullish IFVG mitigated: price closes below zone
                    if ifvg.is_bullish
                        if htf_c < ifvg.bottom
                            mitigated := true

                    // Bearish IFVG mitigated: price closes above zone
                    else
                        if htf_c > ifvg.top
                            mitigated := true

                    if mitigated
                        // Delete drawings
                        if not na(ifvg.box_id)
                            box.delete(ifvg.box_id)
                        if not na(ifvg.label_id)
                            label.delete(ifvg.label_id)

                        array.remove(ifvg_arr, i)

// ══════════════════════════════════════════════════════════════════════
// SECTION 6: SWING POINT & LIQUIDITY DETECTION (Phase 2)
// ══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// Detect swing highs and lows (automatic — no lookback setting)
// RULE 1: Candidate = ICT 3-candle swing at [1]. On equal highs/lows the FIRST
//         candle is the candidate (high[1] > high[2] and high[1] >= high[0]).
// RULE 2: Confirm when a candle CLOSES at least SWING_CONFIRM_ATR x ATR away
//         from the candidate (price clearly left the level).
// RULE 3: Cancel when price trades beyond the candidate before confirmation
//         (a higher high / lower low takes over as the extreme).
// NOTE: Equal highs/lows don't cancel each other, so double tops/bottoms give
//       two swings and the EQH/EQL logic pairs them.
// ─────────────────────────────────────────────────────────────────────
// NOTE: Runs inline in the main loop (Step 1), not as a function. Wrapped in a function,
//       TradingView skipped its body on some builds (0 swings, no ITH/ITL/EQH/EQL).

// ─────────────────────────────────────────────────────────────────────
// Check for Equal Highs (EQH) - REDESIGNED
// Rules:
//   1. Both swings must form BEFORE price breaks above either
//   2. New swing must be AT or BELOW previous swing (resistance holding)
//   3. Quality: "perfect" if within 0.02 ATR, "relative" if within 0.1 ATR
// ─────────────────────────────────────────────────────────────────────
check_equal_highs() =>
    int swing_size = array.size(g_swing_highs)
    if swing_size >= 2 and not na(atr_value)
        float relative_tol = atr_value * i_relative_tolerance

        // Get the most recent swing high
        recent_high = array.get(g_swing_highs, swing_size - 1)

        // RULE 1: Check if recent swing is still intact (not broken through)
        bool recent_intact = true
        if i_require_intact
            recent_intact := is_swing_intact(recent_high.price, false, recent_high.bar_idx)

        if recent_intact
            // Check against previous swing highs for EQH
            int start_idx = swing_size - 2
            int end_idx = math.max(0, swing_size - 10)

            for i = start_idx to end_idx
                if i >= 0 and i < swing_size
                    prev_high = array.get(g_swing_highs, i)

                    // RULE 1: Previous swing must also be intact
                    bool prev_intact = true
                    if i_require_intact
                        prev_intact := is_swing_intact(prev_high.price, false, prev_high.bar_idx)

                    if prev_intact
                        // RULE 2: New swing must be AT or BELOW previous (resistance holding)
                        // For EQH: recent_high.price <= prev_high.price + tolerance
                        if is_valid_eqh_formation(prev_high.price, recent_high.price, relative_tol)
                            // Calculate price difference
                            float price_diff = math.abs(recent_high.price - prev_high.price)

                            // RULE 3: Must be within tolerance
                            if price_diff <= relative_tol
                                // RULE 4 (NEW): Liquidity must NOT have been swept between the swings
                                // Check if any bar's HIGH (wick) went above the first swing's high
                                bool liquidity_swept = was_liquidity_swept_between(prev_high.bar_idx, recent_high.bar_idx, prev_high.price, true)

                                if not liquidity_swept
                                    // Determine quality
                                    string quality = get_eqhl_quality(price_diff, atr_value)

                                    if quality != "none"
                                        // NOTE: i_show_perfect_only is handled in render_liquidity_lines()
                                        // Data must always be collected for grading algorithms to work

                                        // Check if EQH already exists at this level
                                        bool exists = false
                                        int liq_size = array.size(g_liquidity_array)
                                        if liq_size > 0
                                            for j = 0 to liq_size - 1
                                                if j < liq_size
                                                    liq = array.get(g_liquidity_array, j)
                                                    if liq.liq_type == "EQH" and liq.is_valid and not liq.is_swept
                                                        if math.abs(liq.level - recent_high.price) <= relative_tol
                                                            // Update existing EQH with new touch
                                                            liq.touch_count := liq.touch_count + 1
                                                            liq.last_touch_bar := recent_high.bar_idx
                                                            // Upgrade quality if better
                                                            if quality == "perfect" and liq.quality == "relative"
                                                                liq.quality := "perfect"
                                                            exists := true
                                                            break

                                        // Create new EQH if doesn't exist
                                        if not exists
                                            // Use the LOWER of the two highs as the level (more conservative)
                                            float eqh_level = math.min(recent_high.price, prev_high.price)

                                            new_liq = Liquidity.new(
                                                level = eqh_level,
                                                original_level = prev_high.price,
                                                liq_type = "EQH",
                                                quality = quality,
                                                bar_idx = prev_high.bar_idx,
                                                last_touch_bar = recent_high.bar_idx,
                                                touch_count = 2,
                                                is_swept = false,
                                                swept_bar = 0,
                                                is_valid = true,
                                                line_id = na,
                                                label_id = na
                                            )
                                            array.push(g_liquidity_array, new_liq)
                                        break  // Only create one EQH per swing high

// ─────────────────────────────────────────────────────────────────────
// Check for Equal Lows (EQL) - REDESIGNED
// Rules:
//   1. Both swings must form BEFORE price breaks below either
//   2. New swing must be AT or ABOVE previous swing (support holding)
//   3. Quality: "perfect" if within 0.02 ATR, "relative" if within 0.1 ATR
// ─────────────────────────────────────────────────────────────────────
check_equal_lows() =>
    int swing_size = array.size(g_swing_lows)
    if swing_size >= 2 and not na(atr_value)
        float relative_tol = atr_value * i_relative_tolerance

        // Get the most recent swing low
        recent_low = array.get(g_swing_lows, swing_size - 1)

        // RULE 1: Check if recent swing is still intact (not broken through)
        bool recent_intact = true
        if i_require_intact
            recent_intact := is_swing_intact(recent_low.price, true, recent_low.bar_idx)

        if recent_intact
            // Check against previous swing lows for EQL
            int start_idx = swing_size - 2
            int end_idx = math.max(0, swing_size - 10)

            for i = start_idx to end_idx
                if i >= 0 and i < swing_size
                    prev_low = array.get(g_swing_lows, i)

                    // RULE 1: Previous swing must also be intact
                    bool prev_intact = true
                    if i_require_intact
                        prev_intact := is_swing_intact(prev_low.price, true, prev_low.bar_idx)

                    if prev_intact
                        // RULE 2: New swing must be AT or ABOVE previous (support holding)
                        // For EQL: recent_low.price >= prev_low.price - tolerance
                        if is_valid_eql_formation(prev_low.price, recent_low.price, relative_tol)
                            // Calculate price difference
                            float price_diff = math.abs(recent_low.price - prev_low.price)

                            // RULE 3: Must be within tolerance
                            if price_diff <= relative_tol
                                // RULE 4 (NEW): Liquidity must NOT have been swept between the swings
                                // Check if any bar's LOW (wick) went below the first swing's low
                                bool liquidity_swept = was_liquidity_swept_between(prev_low.bar_idx, recent_low.bar_idx, prev_low.price, false)

                                if not liquidity_swept
                                    // Determine quality
                                    string quality = get_eqhl_quality(price_diff, atr_value)

                                    if quality != "none"
                                        // NOTE: i_show_perfect_only is handled in render_liquidity_lines()
                                        // Data must always be collected for grading algorithms to work

                                        // Check if EQL already exists at this level
                                        bool exists = false
                                        int liq_size = array.size(g_liquidity_array)
                                        if liq_size > 0
                                            for j = 0 to liq_size - 1
                                                if j < liq_size
                                                    liq = array.get(g_liquidity_array, j)
                                                    if liq.liq_type == "EQL" and liq.is_valid and not liq.is_swept
                                                        if math.abs(liq.level - recent_low.price) <= relative_tol
                                                            // Update existing EQL with new touch
                                                            liq.touch_count := liq.touch_count + 1
                                                            liq.last_touch_bar := recent_low.bar_idx
                                                            // Upgrade quality if better
                                                            if quality == "perfect" and liq.quality == "relative"
                                                                liq.quality := "perfect"
                                                            exists := true
                                                            break

                                        // Create new EQL if doesn't exist
                                        if not exists
                                            // Use the HIGHER of the two lows as the level (more conservative)
                                            float eql_level = math.max(recent_low.price, prev_low.price)

                                            new_liq = Liquidity.new(
                                                level = eql_level,
                                                original_level = prev_low.price,
                                                liq_type = "EQL",
                                                quality = quality,
                                                bar_idx = prev_low.bar_idx,
                                                last_touch_bar = recent_low.bar_idx,
                                                touch_count = 2,
                                                is_swept = false,
                                                swept_bar = 0,
                                                is_valid = true,
                                                line_id = na,
                                                label_id = na
                                            )
                                            array.push(g_liquidity_array, new_liq)
                                        break  // Only create one EQL per swing low

// ─────────────────────────────────────────────────────────────────────
// Price of the most recent confirmed swing in `swings` that formed before `before_bar`
// (na if none). Swing arrays are kept in bar order.
// ─────────────────────────────────────────────────────────────────────
find_swing_before(array<SwingPoint> swings, int before_bar) =>
    float result = na
    int n = array.size(swings)
    if n > 0
        for i = n - 1 to 0
            SwingPoint sp = array.get(swings, i)
            if sp.bar_idx < before_bar
                result := sp.price
                break
    result

// ─────────────────────────────────────────────────────────────────────
// Create Internal Highs/Lows (ITH/ITL)
// These are recent swing points that serve as BE references
// ─────────────────────────────────────────────────────────────────────
create_internal_levels() =>
    // Turn every newly confirmed swing into an ITH/ITL. Several swings can confirm
    // on the same candle, so walk all swings newer than the last one used.
    // Strong/weak: structure_ref is the opposite swing the move came from; if a close
    // already broke it between the swing candle and now (far_close, tracked while the
    // swing was pending), the level is Strong at once.
    // NOTE: i_show_ith_itl is handled in render_liquidity_lines()
    // Data must always be collected for grading algorithms to work
    int swing_high_size = array.size(g_swing_highs)
    if swing_high_size > 0
        for i = 0 to swing_high_size - 1
            SwingPoint sh = array.get(g_swing_highs, i)
            // Never re-create a level from a swing already used (it may have been swept and forgotten)
            if sh.bar_idx > array.get(g_last_internal_bar, 0)
                array.set(g_last_internal_bar, 0, sh.bar_idx)
                float ref_low = find_swing_before(g_swing_lows, sh.bar_idx)
                bool strong_h = not na(ref_low) and sh.far_close < ref_low
                array.push(g_liquidity_array, Liquidity.new(level = sh.price, original_level = sh.price, liq_type = "ITH", quality = "na", bar_idx = sh.bar_idx, last_touch_bar = sh.bar_idx, touch_count = 1, is_swept = false, swept_bar = 0, is_valid = true, line_id = na, label_id = na, is_strong = strong_h, is_decided = strong_h or na(ref_low), structure_ref = ref_low))
    int swing_low_size = array.size(g_swing_lows)
    if swing_low_size > 0
        for i = 0 to swing_low_size - 1
            SwingPoint sl = array.get(g_swing_lows, i)
            if sl.bar_idx > array.get(g_last_internal_bar, 1)
                array.set(g_last_internal_bar, 1, sl.bar_idx)
                float ref_high = find_swing_before(g_swing_highs, sl.bar_idx)
                bool strong_l = not na(ref_high) and sl.far_close > ref_high
                array.push(g_liquidity_array, Liquidity.new(level = sl.price, original_level = sl.price, liq_type = "ITL", quality = "na", bar_idx = sl.bar_idx, last_touch_bar = sl.bar_idx, touch_count = 1, is_swept = false, swept_bar = 0, is_valid = true, line_id = na, label_id = na, is_strong = strong_l, is_decided = strong_l or na(ref_high), structure_ref = ref_high))

// ─────────────────────────────────────────────────────────────────────
// Check for liquidity sweeps (Enhanced for EQL/EQH)
// When swept: mark as swept AND invalidate for future touches
// ─────────────────────────────────────────────────────────────────────
check_liquidity_sweeps() =>
    int liq_size = array.size(g_liquidity_array)
    if barstate.isconfirmed and liq_size > 0
        for i = 0 to liq_size - 1
            if i < liq_size
                liq = array.get(g_liquidity_array, i)
                if not liq.is_swept and liq.is_valid
                    // BSL Sweep: high wicks above, close stays below
                    if is_bsl(liq)
                        if high > liq.level and close < liq.level
                            liq.is_swept := true
                            liq.swept_bar := bar_index
                            liq.is_valid := false  // No more touches count
                            liq.mitigated_bar := bar_index
                    // SSL Sweep: low wicks below, close stays above
                    if is_ssl(liq)
                        if low < liq.level and close > liq.level
                            liq.is_swept := true
                            liq.swept_bar := bar_index
                            liq.is_valid := false  // No more touches count
                            liq.mitigated_bar := bar_index
                // Close-through invalidation (level broken, NOT swept) for all types.
                // A broken level can never be swept later — a wick back through it is not a sweep.
                // NOTE: PD dealing range uses g_pd_liquidity_array, so this does not affect PD zones.
                if liq.is_valid and not liq.is_swept
                    if is_bsl(liq)
                        if close > liq.level
                            liq.is_valid := false
                            liq.mitigated_bar := bar_index
                    if is_ssl(liq)
                        if close < liq.level
                            liq.is_valid := false
                            liq.mitigated_bar := bar_index
                // Strong/weak decision (once): Strong if a close breaks structure_ref before a
                // newer same-side swing confirms; weak if that swing comes first or the level is mitigated
                if not liq.is_decided and (liq.liq_type == "ITH" or liq.liq_type == "ITL")
                    if not liq.is_valid or liq.is_swept
                        liq.is_decided := true
                    else if liq.liq_type == "ITH" and close < liq.structure_ref
                        liq.is_strong := true
                        liq.is_decided := true
                    else if liq.liq_type == "ITL" and close > liq.structure_ref
                        liq.is_strong := true
                        liq.is_decided := true
                    else if liq.liq_type == "ITH" and array.size(g_swing_highs) > 0 and array.get(g_swing_highs, array.size(g_swing_highs) - 1).bar_idx > liq.bar_idx
                        liq.is_decided := true
                    else if liq.liq_type == "ITL" and array.size(g_swing_lows) > 0 and array.get(g_swing_lows, array.size(g_swing_lows) - 1).bar_idx > liq.bar_idx
                        liq.is_decided := true

// ─────────────────────────────────────────────────────────────────────
// Data (news) candles — no calendar in Pine, so a release is detected by time + size
// RULE 1: The candle contains a US release time: 8:30, 10:00 or 14:00 New York,
//         Monday-Friday. Times are converted to New York (DST included), so the
//         user's chart timezone does not matter.
// RULE 2: The release candle, or the candle after it, has a range of at least
//         DATA_RANGE_ATR x the ATR before the release. Quiet days are not marked.
// RULE 3: The big candle's high and low become "Data High" / "Data Low" liquidity:
//         targets and sweepable levels until swept or broken, like EQH/EQL.
// NOTE: Only on 15m and lower; on higher TFs the news candle is lost inside the bar.
// ─────────────────────────────────────────────────────────────────────
is_release_bar() =>
    bool result = false
    int dow = dayofweek(time, "America/New_York")
    if dow >= dayofweek.monday and dow <= dayofweek.friday
        int y = year(time, "America/New_York")
        int m = month(time, "America/New_York")
        int d = dayofmonth(time, "America/New_York")
        int t1 = timestamp("America/New_York", y, m, d, 8, 30)
        int t2 = timestamp("America/New_York", y, m, d, 10, 0)
        int t3 = timestamp("America/New_York", y, m, d, 14, 0)
        result := (time <= t1 and t1 < time_close) or (time <= t2 and t2 < time_close) or (time <= t3 and t3 < time_close)
    result

add_data_levels() =>
    array.push(g_liquidity_array, Liquidity.new(level = high, original_level = high, liq_type = "Data High", quality = "na", bar_idx = bar_index, last_touch_bar = bar_index, touch_count = 1, is_swept = false, swept_bar = 0, is_valid = true, line_id = na, label_id = na, is_decided = true))
    array.push(g_liquidity_array, Liquidity.new(level = low, original_level = low, liq_type = "Data Low", quality = "na", bar_idx = bar_index, last_touch_bar = bar_index, touch_count = 1, is_swept = false, swept_bar = 0, is_valid = true, line_id = na, label_id = na, is_decided = true))

detect_data_candle() =>
    if barstate.isconfirmed and timeframe.in_seconds(timeframe.period) <= DATA_MAX_TF_SECS and not na(atr_prev)
        float candle_range = high - low
        float pend_bar = array.get(g_data_pending, 0)
        if not na(pend_bar)
            // Candle after a quiet release candle
            if candle_range >= array.get(g_data_pending, 1) * DATA_RANGE_ATR
                add_data_levels()
            array.set(g_data_pending, 0, na)
        else if is_release_bar()
            if candle_range >= atr_prev * DATA_RANGE_ATR
                add_data_levels()
            else
                array.set(g_data_pending, 0, bar_index)
                array.set(g_data_pending, 1, atr_prev)

// ─────────────────────────────────────────────────────────────────────
// LRLR (trendline liquidity) — built from the chart-TF swings, no lookback setting
// ─────────────────────────────────────────────────────────────────────
// Trendline price at bar `b`
lrlr_value(LRLR t, int b) =>
    t.y1 + (t.y2 - t.y1) * (b - t.x1) / (t.x2 - t.x1)

// Build the LRLR ending at the newest swing, or na
// RULE 1: Consecutive swings ending at the newest one, each earlier swing beyond the
//         next (higher for lower highs, lower for higher lows); at least LRLR_MIN_POINTS.
// RULE 2: The line runs from the oldest swing that fits to the newest; every swing in
//         between lies within LRLR_FIT_ATR × ATR of it (oldest anchor tried first).
// RULE 3: No close beyond the line from the origin to now (otherwise the run happened).
build_lrlr(array<SwingPoint> swings, bool lower_highs) =>
    LRLR result = na
    int n = array.size(swings)
    if n >= LRLR_MIN_POINTS and not na(atr_value)
        int start = n - 1
        while start > 0 and (lower_highs ? array.get(swings, start - 1).price > array.get(swings, start).price : array.get(swings, start - 1).price < array.get(swings, start).price)
            start -= 1
        if n - start >= LRLR_MIN_POINTS
            SwingPoint newest = array.get(swings, n - 1)
            for a = start to n - LRLR_MIN_POINTS
                if na(result)
                    SwingPoint o = array.get(swings, a)
                    LRLR cand = LRLR.new(x1 = o.bar_idx, y1 = o.price, x2 = newest.bar_idx, y2 = newest.price, points = n - a, lower_highs = lower_highs)
                    bool fits = true
                    for j = a + 1 to n - 2
                        SwingPoint p = array.get(swings, j)
                        if math.abs(p.price - lrlr_value(cand, p.bar_idx)) > atr_value * LRLR_FIT_ATR
                            fits := false
                    if fits
                        bool broken = false
                        int span = int(math.min(bar_index - o.bar_idx, 499))
                        for k = 0 to span
                            float lv = lrlr_value(cand, bar_index - k)
                            if lower_highs ? close[k] > lv : close[k] < lv
                                broken := true
                        if not broken
                            result := cand
    result

// Drop an LRLR and its drawings
clear_lrlr(int side) =>
    LRLR t = array.get(g_lrlr, side)
    if not na(t)
        if not na(t.line_id)
            line.delete(t.line_id)
        if not na(t.label_id)
            label.delete(t.label_id)
    array.set(g_lrlr, side, na)

// Rebuild on a new swing; consume on a close through the line
update_lrlr() =>
    if barstate.isconfirmed
        for side = 0 to 1
            array<SwingPoint> swings = side == 0 ? g_swing_highs : g_swing_lows
            if array.size(swings) > 0
                int newest_bar = array.get(swings, array.size(swings) - 1).bar_idx
                if newest_bar != array.get(g_lrlr_last_swing, side)
                    array.set(g_lrlr_last_swing, side, newest_bar)
                    LRLR built = build_lrlr(swings, side == 0)
                    if not na(built)
                        clear_lrlr(side)
                        array.set(g_lrlr, side, built)
            LRLR t = array.get(g_lrlr, side)
            if not na(t)
                float lv = lrlr_value(t, bar_index)
                if side == 0 ? close > lv : close < lv
                    clear_lrlr(side)

// LRLR in the trade's path: lower highs above the entry for longs, higher lows below
// for shorts (na if none)
lrlr_in_path(bool is_bull, float entry) =>
    LRLR t = array.get(g_lrlr, is_bull ? 0 : 1)
    LRLR result = na
    if not na(t)
        float lv = lrlr_value(t, bar_index)
        if is_bull ? lv > entry : lv < entry
            result := t
    result

// Draw both LRLR lines to the current bar
render_lrlr() =>
    for side = 0 to 1
        LRLR t = array.get(g_lrlr, side)
        if not na(t)
            if not na(t.line_id)
                line.delete(t.line_id)
            if not na(t.label_id)
                label.delete(t.label_id)
            if i_show_lrlr
                int left_x = clamp_left_bar(t.x1)
                t.line_id := line.new(left_x, lrlr_value(t, left_x), bar_index, lrlr_value(t, bar_index), color = i_liq_color, style = line.style_dashed, width = 1)
                t.label_id := label.new(bar_index, lrlr_value(t, bar_index), "LRLR", style = side == 0 ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(color.black, 100), textcolor = i_liq_color, size = size.tiny)

// ─────────────────────────────────────────────────────────────────────
// Create PD Internal Highs/Lows (PD_ITH/PD_ITL) — mirror of create_internal_levels()
// scoped to g_pd_swing_highs/lows and g_pd_liquidity_array.
// ─────────────────────────────────────────────────────────────────────
create_pd_internal_levels() =>
    int pd_swing_high_size = array.size(g_pd_swing_highs)
    if pd_swing_high_size > 0
        recent_high = array.get(g_pd_swing_highs, pd_swing_high_size - 1)
        bool ith_exists = false
        int pd_liq_size_1 = array.size(g_pd_liquidity_array)
        if pd_liq_size_1 > 0
            for i = 0 to pd_liq_size_1 - 1
                if i < pd_liq_size_1
                    liq = array.get(g_pd_liquidity_array, i)
                    if liq.liq_type == "PD_ITH" and liq.bar_idx == recent_high.bar_idx
                        ith_exists := true
                        break
        if not ith_exists
            new_ith = Liquidity.new(level = recent_high.price, original_level = recent_high.price, liq_type = "PD_ITH", quality = "na", bar_idx = recent_high.bar_idx, last_touch_bar = recent_high.bar_idx, touch_count = 1, is_swept = false, swept_bar = 0, is_valid = true, line_id = na, label_id = na)
            array.push(g_pd_liquidity_array, new_ith)
    int pd_swing_low_size = array.size(g_pd_swing_lows)
    if pd_swing_low_size > 0
        recent_low = array.get(g_pd_swing_lows, pd_swing_low_size - 1)
        bool itl_exists = false
        int pd_liq_size_2 = array.size(g_pd_liquidity_array)
        if pd_liq_size_2 > 0
            for i = 0 to pd_liq_size_2 - 1
                if i < pd_liq_size_2
                    liq = array.get(g_pd_liquidity_array, i)
                    if liq.liq_type == "PD_ITL" and liq.bar_idx == recent_low.bar_idx
                        itl_exists := true
                        break
        if not itl_exists
            new_itl = Liquidity.new(level = recent_low.price, original_level = recent_low.price, liq_type = "PD_ITL", quality = "na", bar_idx = recent_low.bar_idx, last_touch_bar = recent_low.bar_idx, touch_count = 1, is_swept = false, swept_bar = 0, is_valid = true, line_id = na, label_id = na)
            array.push(g_pd_liquidity_array, new_itl)
    while array.size(g_pd_liquidity_array) > 50
        array.shift(g_pd_liquidity_array)

// ─────────────────────────────────────────────────────────────────────
// Check PD liquidity sweeps — mirror of check_liquidity_sweeps() scoped
// to g_pd_liquidity_array. Runs on chart-TF close (RESEARCH §Pattern 2).
// ─────────────────────────────────────────────────────────────────────
check_pd_sweeps() =>
    int pd_liq_size = array.size(g_pd_liquidity_array)
    if barstate.isconfirmed and pd_liq_size > 0
        float min_protrusion = (na(atr_value) ? 0.0 : atr_value * i_pd_sweep_min_atr_mult)
        // Cycle 5: recompute the confirmation-lag window so close-through invalidation
        // can be scoped to pivots that are still inside it. Cycle 3 introduced
        // close-through to drop levels that materialise already broken during the lag,
        // but applied unscoped it also nukes legitimate older pivots once a trend
        // closes past them — leaving cycle 4's fallback with zero candidates on the
        // trend-counter side. Same formula as the Step 4C push uses.
        // Lag of the most recent PD swing (set by the Step 4C push).
        int sweep_lag_bars     = g_pd_lag_bars
        for i = 0 to pd_liq_size - 1
            if i < pd_liq_size
                liq = array.get(g_pd_liquidity_array, i)
                if not liq.is_swept and liq.is_valid
                    // Wick-and-revert sweep (existing behavior, ATR-gated). Applies at
                    // any age — a legitimate wick-sweep is meaningful whenever it occurs.
                    if liq.liq_type == "PD_ITH"
                        if (high - liq.level) > min_protrusion and close < liq.level
                            liq.is_swept := true
                            liq.swept_bar := bar_index
                            liq.is_valid := false
                    if liq.liq_type == "PD_ITL"
                        if (liq.level - low) > min_protrusion and close > liq.level
                            liq.is_swept := true
                            liq.swept_bar := bar_index
                            liq.is_valid := false
                    // Close-through invalidation (cycle 3, time-gated in cycle 5):
                    // ONLY apply while the pivot is inside its confirmation-lag window.
                    // Inside the window a close-through means the level was "born already
                    // broken" — drop it. Outside the window the pivot is a legitimate
                    // historical structural high/low that survives trend penetration —
                    // leave it for cycle 4's structural-extremes fallback to anchor on
                    // during steep trends. The wick-and-revert sweep above still applies
                    // at all ages, so genuine sweeps are still marked.
                    if liq.is_valid and not liq.is_swept
                        int age = bar_index - liq.bar_idx
                        if age <= sweep_lag_bars
                            if liq.liq_type == "PD_ITH"
                                if close > liq.level
                                    liq.is_valid := false
                            if liq.liq_type == "PD_ITL"
                                if close < liq.level
                                    liq.is_valid := false

// ─────────────────────────────────────────────────────────────────────
// Dealing-range source is always g_pd_liquidity_array — fed by request.security
// at the configured PD TF, so the PD input always drives what the user sees,
// regardless of chart TF.
// ─────────────────────────────────────────────────────────────────────
select_dealing_range_source() =>
    g_pd_liquidity_array

// ══════════════════════════════════════════════════════════════════════
// SECTION 7: BE POINT & GRADING FUNCTIONS (Phase 2)
// ══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// Find nearest internal high after a bar index (for bearish IFVG BE)
// ─────────────────────────────────────────────────────────────────────
find_next_internal_high(int after_bar) =>
    float result = na
    int closest_bar = 999999
    int arr_size = array.size(g_swing_highs)

    if arr_size > 0
        for i = 0 to arr_size - 1
            if i < arr_size
                swing = array.get(g_swing_highs, i)
                if swing.bar_idx > after_bar and swing.bar_idx < closest_bar
                    result := swing.price
                    closest_bar := swing.bar_idx

    result

// ─────────────────────────────────────────────────────────────────────
// Find nearest internal low after a bar index (for bullish IFVG BE)
// ─────────────────────────────────────────────────────────────────────
find_next_internal_low(int after_bar) =>
    float result = na
    int closest_bar = 999999
    int arr_size = array.size(g_swing_lows)

    if arr_size > 0
        for i = 0 to arr_size - 1
            if i < arr_size
                swing = array.get(g_swing_lows, i)
                if swing.bar_idx > after_bar and swing.bar_idx < closest_bar
                    result := swing.price
                    closest_bar := swing.bar_idx

    result

// ─────────────────────────────────────────────────────────────────────
// Find nearest swing HIGH BEFORE a bar index (to the LEFT)
// Used for: Bullish IFVG BE point
// ─────────────────────────────────────────────────────────────────────
find_previous_swing_high(int before_bar) =>
    float result = na
    int closest_bar = -1
    int arr_size = array.size(g_swing_highs)

    if arr_size > 0
        for i = arr_size - 1 to 0  // Iterate backwards to find most recent
            if i >= 0 and i < arr_size
                swing = array.get(g_swing_highs, i)
                if swing.bar_idx < before_bar and swing.bar_idx > closest_bar
                    result := swing.price
                    closest_bar := swing.bar_idx

    result

// ─────────────────────────────────────────────────────────────────────
// Find nearest swing LOW BEFORE a bar index (to the LEFT)
// Used for: Bearish IFVG BE point
// ─────────────────────────────────────────────────────────────────────
find_previous_swing_low(int before_bar) =>
    float result = na
    int closest_bar = -1
    int arr_size = array.size(g_swing_lows)

    if arr_size > 0
        for i = arr_size - 1 to 0  // Iterate backwards to find most recent
            if i >= 0 and i < arr_size
                swing = array.get(g_swing_lows, i)
                if swing.bar_idx < before_bar and swing.bar_idx > closest_bar
                    result := swing.price
                    closest_bar := swing.bar_idx

    result

// ─────────────────────────────────────────────────────────────────────
// Find nearest Draw on Liquidity (target)
// For bullish IFVG: find BSL (highs above)
// For bearish IFVG: find SSL (lows below)
// ─────────────────────────────────────────────────────────────────────
find_dol(bool is_bullish_ifvg, float current_price) =>
    Liquidity result = na
    float best_distance = 999999.0
    int arr_size = array.size(g_liquidity_array)

    if arr_size > 0
        for i = 0 to arr_size - 1
            if i < arr_size
                liq = array.get(g_liquidity_array, i)

                // DOL must be both un-swept AND still valid (not broken through)
                if not liq.is_swept and liq.is_valid
                    if is_bullish_ifvg
                        // For bullish IFVG, target BSL (highs above current price)
                        if is_bsl(liq) and liq.level > current_price
                            distance = liq.level - current_price
                            if distance < best_distance
                                best_distance := distance
                                result := liq
                    else
                        // For bearish IFVG, target SSL (lows below current price)
                        if is_ssl(liq) and liq.level < current_price
                            distance = current_price - liq.level
                            if distance < best_distance
                                best_distance := distance
                                result := liq

    result

// ─────────────────────────────────────────────────────────────────────
// Check if a liquidity sweep CAUSED this setup's reversal (no bar-count setting)
// Returns 0 = no sweep, 1 = wick sweep, 2 = closed through and reclaimed
// RULE 1: The level was taken (wick-swept or broken by a close) inside the setup's
//         own move — from FVG formation (window_start) up to the inversion candle.
// RULE 2: The move's extreme (highest high for BSL / lowest low for SSL) is on the
//         taking candle or after it — a multi-candle raid still counts.
// RULE 3: No candle closed beyond the level after the move's extreme (price got back
//         and stayed back), so the inversion candle closes on the right side.
// RULE 4: At most 3 candles closed beyond the level in total. A short close-through on
//         the chart TF is a wick on a higher TF; longer acceptance is a real break.
// NOTE: The level keeps its broken (⊘) state on the chart; this only credits the setup.
// NOTE: Window is capped at 499 bars by max_bars_back=500.
// ─────────────────────────────────────────────────────────────────────
check_setup_sweep(bool looking_for_bsl, int window_start) =>
    int result = 0
    int span = int(math.min(bar_index - window_start, 499))
    if span >= 0
        // Extreme of the move across the window and its bar offset (oldest wins on ties)
        float move_extreme = looking_for_bsl ? high : low
        int extreme_off = 0
        for k = 0 to span
            bool beyond = looking_for_bsl ? high[k] >= move_extreme : low[k] <= move_extreme
            if beyond
                move_extreme := looking_for_bsl ? high[k] : low[k]
                extreme_off := k
        int arr_size = array.size(g_liquidity_array)
        if arr_size > 0
            for i = 0 to arr_size - 1
                liq = array.get(g_liquidity_array, i)
                bool side_match = looking_for_bsl ? is_bsl(liq) : is_ssl(liq)
                bool taken = liq.is_swept or (not liq.is_valid and not na(liq.mitigated_bar))
                if result != 1 and side_match and taken
                    int take_bar = liq.is_swept ? liq.swept_bar : liq.mitigated_bar
                    int take_offset = bar_index - take_bar
                    if take_offset >= 0 and take_offset <= span and extreme_off <= take_offset
                        int closes_beyond = 0
                        bool closed_after_extreme = false
                        for k = 0 to take_offset
                            if looking_for_bsl ? close[k] > liq.level : close[k] < liq.level
                                closes_beyond += 1
                                if k < extreme_off
                                    closed_after_extreme := true
                        if not closed_after_extreme and closes_beyond <= SWEEP_MAX_CLOSES_BEYOND
                            result := closes_beyond == 0 ? 1 : 2
    result

// ─────────────────────────────────────────────────────────────────────
// Assess momentum through the IFVG (per D-08, strategy 6: "no chop through the IFVG")
// Returns int: 0 = weak/choppy, 1 = moderate, 2 = strong with no chop
// Chop = candles spent at the zone before the body closes through it: counted from
// the first candle (after the setup's extreme) that touched the zone up to the
// inversion candle. No lookback setting: the window is the setup's own move.
// RULE 1: Score 0 if the inversion candle is weak (body < 30% of range or range < 0.5 ATR)
//         or price chopped at the zone for 4+ candles.
// RULE 2: Score 2 if the inversion candle is strong (body > 70%, range > 1 ATR) and it
//         closed through within 1 candle of first touching the zone.
// RULE 3: Otherwise score 1.
// NOTE: Uses series offsets relative to the current (inversion) bar.
// ─────────────────────────────────────────────────────────────────────
assess_momentum(bool is_bull, float zone_top, float zone_bottom, int extreme_off) =>
    int result = 1
    float candle_body = math.abs(close - open)
    float candle_range = high - low
    if candle_range > 0 and not na(atr_value)
        float body_ratio = candle_body / candle_range
        bool strong_candle = body_ratio > 0.7 and candle_range > atr_value
        bool weak_candle = body_ratio < 0.3 or candle_range < atr_value * 0.5
        int chop = 0
        if extreme_off > 0
            for k = extreme_off to 1
                if chop == 0
                    bool touched = is_bull ? high[k] >= zone_bottom : low[k] <= zone_top
                    if touched
                        chop := k
        if weak_candle or chop >= 4
            result := 0
        else if strong_candle and chop <= 1
            result := 2
    result

// ─────────────────────────────────────────────────────────────────────
// Check if an FVG is singular (no same-direction FVG nearby AND overlapping)
// Per strategy: singular FVGs are higher quality than clustered ones
// Both checks must fail for the FVG to be non-singular (per D-01)
// ─────────────────────────────────────────────────────────────────────
is_fvg_singular(FVG source_fvg) =>
    bool singular = true
    int fvg_count = array.size(g_fvg_array)
    if fvg_count > 1 and not na(atr_value)
        for j = 0 to fvg_count - 1
            FVG other = array.get(g_fvg_array, j)
            // Skip self, opposite direction, and non-active
            bool is_self = (other.start_bar == source_fvg.start_bar and other.end_bar == source_fvg.end_bar)
            bool same_dir = (other.is_bullish == source_fvg.is_bullish)
            bool is_active = (other.status == "active")
            if not is_self and same_dir and is_active
                // CHECK 1: Proximity -- within 5 bars?
                int bar_distance = int(math.abs(source_fvg.end_bar - other.end_bar))
                bool too_close = bar_distance <= 5
                // CHECK 2: Overlap -- zones overlap or nearly overlap? (ATR * 0.1 tolerance)
                float overlap_tolerance = atr_value * 0.1
                bool zones_overlap = (source_fvg.top + overlap_tolerance >= other.bottom) and (source_fvg.bottom - overlap_tolerance <= other.top)
                // Both must be true to mark as non-singular
                if too_close and zones_overlap
                    singular := false
                    break
    singular

// ─────────────────────────────────────────────────────────────────────
// True if price turned from `f` (delivered from it) in the setup's move
// RULE 1: Same direction as the IFVG — a bullish FVG below for longs (price taps the
//         discount gap and turns up), a bearish FVG above for shorts.
// RULE 2: Still active at inversion (not inverted on its own timeframe).
// RULE 3: It existed before the turn — the setup's extreme (lowest low for longs,
//         highest high for shorts, `extreme_off` bars back). Gaps left by the move
//         out of the turn do not count.
// RULE 4: The turn reached into it (extreme wick at or beyond its near edge).
// RULE 5: Bodies respected it: no chart-TF close beyond its far edge from its
//         formation (or window_start) to the inversion candle.
// ─────────────────────────────────────────────────────────────────────
fvg_delivered(FVG f, bool ifvg_is_bullish, int window_start, int extreme_off) =>
    bool result = false
    int turn_bar = bar_index - extreme_off
    if f.is_bullish == ifvg_is_bullish and f.status == "active" and f.end_bar < turn_bar
        bool tapped = ifvg_is_bullish ? low[extreme_off] <= f.top : high[extreme_off] >= f.bottom
        if tapped
            bool respected = true
            int from_bar = int(math.max(window_start, f.end_bar + 1))
            int span = int(math.min(bar_index - from_bar, 499))
            if span >= 0
                for k = 0 to span
                    if ifvg_is_bullish ? close[k] < f.bottom : close[k] > f.top
                        respected := false
            result := respected
    result

// Tooltip text for a delivering FVG: timeframe and price range
delivery_text(string tf_text, FVG f) =>
    tf_text + " " + str.tostring(f.bottom, format.mintick) + "-" + str.tostring(f.top, format.mintick)

// ─────────────────────────────────────────────────────────────────────
// Delivery source for a new IFVG: the selected higher timeframes first (HTF1, then
// HTF2), then the chart timeframe (counts, but slightly less confident).
// Returns "<TF> <bottom>-<top>" of the delivering FVG ("same TF ..." for the chart
// TF), or "" for none.
// ─────────────────────────────────────────────────────────────────────
find_delivery(bool ifvg_is_bullish, int window_start, int extreme_off) =>
    string result = ""
    if i_enable_htf
        if array.size(g_htf_fvg_array) > 0
            for i = array.size(g_htf_fvg_array) - 1 to 0
                FVG f = array.get(g_htf_fvg_array, i)
                if result == "" and fvg_delivered(f, ifvg_is_bullish, window_start, extreme_off)
                    result := delivery_text(get_tf_label(i_htf_timeframe), f)
        if result == "" and array.size(g_htf2_fvg_array) > 0
            for i = array.size(g_htf2_fvg_array) - 1 to 0
                FVG f = array.get(g_htf2_fvg_array, i)
                if result == "" and fvg_delivered(f, ifvg_is_bullish, window_start, extreme_off)
                    result := delivery_text(get_tf_label(i_htf_timeframe_2), f)
    if result == "" and array.size(g_fvg_array) > 0
        for i = array.size(g_fvg_array) - 1 to 0
            FVG f = array.get(g_fvg_array, i)
            if result == "" and fvg_delivered(f, ifvg_is_bullish, window_start, extreme_off)
                result := delivery_text("same TF", f)
    result

// ─────────────────────────────────────────────────────────────────────
// Score the target 0-2 (rating PDF: "targets are clear — one of these 7")
// Flat target = nearest unswept EQH/EQL/ITH/ITL in the trade's direction.
// LRLR = trendline liquidity in the trade's path; its target is the origin swing.
// Score 2: flat target at least as far as the stop (R:R >= 1), or a flat target with
//          an LRLR on the way (confluence), or only an LRLR whose origin is that far
// Score 1: a target exists but is closer than the stop ("reward sucks")
// Score 0: no target
// ─────────────────────────────────────────────────────────────────────
score_target(Liquidity dol_target, LRLR lrlr, float entry, float sl) =>
    int result = 0
    float risk = math.abs(entry - sl)
    if not na(dol_target)
        result := math.abs(dol_target.level - entry) >= risk or not na(lrlr) ? 2 : 1
    else if not na(lrlr)
        result := math.abs(lrlr.y1 - entry) >= risk ? 2 : 1
    result

// ─────────────────────────────────────────────────────────────────────
// Score FVG singularity 0-2 per D-05 criterion 4
// Score 2: singular and obvious (large gap >= 0.5 ATR)
// Score 1: singular but small/inconspicuous
// Score 0: not singular (overlapping FVGs nearby)
// ─────────────────────────────────────────────────────────────────────
score_singularity(bool is_singular, float fvg_size, float atr_val) =>
    int result = 0
    if is_singular
        if not na(atr_val) and fvg_size >= atr_val * 0.5
            result := 2
        else
            result := 1
    result

// ─────────────────────────────────────────────────────────────────────
// Score PD zone positioning 0-2 per D-09
// Score 2: correct zone (bullish in discount, bearish in premium)
// Score 1: neutral/equilibrium or no dealing range detected
// Score 0: wrong zone (bullish in premium, bearish in discount)
// ─────────────────────────────────────────────────────────────────────
score_pd_zone(string pd_zone, bool ifvg_is_bullish) =>
    int result = 1
    if pd_zone == "discount"
        result := ifvg_is_bullish ? 2 : 0
    else if pd_zone == "premium"
        result := ifvg_is_bullish ? 0 : 2
    result

// ─────────────────────────────────────────────────────────────────────
// True when the setup is far into the wrong half of the range
// (long in the top quarter, short in the bottom quarter)
// ─────────────────────────────────────────────────────────────────────
is_far_wrong_zone(int pd_pct, bool ifvg_is_bullish) =>
    bool result = false
    if not na(pd_pct)
        result := ifvg_is_bullish ? pd_pct >= 75 : pd_pct <= 25
    result

// ─────────────────────────────────────────────────────────────────────
// Grading per the rating PDF: sweep/delivery sets the band, the other four
// criteria step the grade down inside it.
// Ladder: 0=A+ 1=A 2=A- 3=B+ 4=B 5=B- 6=C
// RULE 1: Sweep AND delivery → starts at A+. A+ needs strong momentum, a clear
//         target, a singular FVG and the correct PD zone; floor B.
// RULE 2: Sweep OR delivery → starts at A; floor B.
//         One step down for each: momentum moderate (1) / weak (2), not singular,
//         target closer than the stop, wrong PD zone, delivery only from a
//         chart-TF FVG (higher-timeframe delivery is the full-confidence kind).
// RULE 3: Neither → starts at B; floor B-. Steps: weak momentum, target closer
//         than the stop (wrong zone and a non-obvious gap are normal for B).
// RULE 4: No target → at most B-.
// RULE 5: Neither AND far in the wrong zone → C ("way too high/low", no bias).
// ─────────────────────────────────────────────────────────────────────
calculate_grade(bool has_sweep, bool has_delivery, bool delivery_htf, int momentum_score, int target_score, int singularity_score, string pd_zone, int pd_pct, bool ifvg_is_bullish) =>
    int pd_score = score_pd_zone(pd_zone, ifvg_is_bullish)
    int idx = 4
    if has_sweep or has_delivery
        int steps = (2 - momentum_score) + (singularity_score == 0 ? 1 : 0) + (target_score == 1 ? 1 : 0) + (pd_score == 0 ? 1 : 0) + (has_delivery and not delivery_htf ? 1 : 0)
        if has_sweep and has_delivery
            // A+ also needs the correct zone; neutral/equilibrium is one step
            if steps == 0 and pd_score == 1
                steps := 1
            idx := int(math.min(steps, 4))
        else
            idx := int(math.min(1 + steps, 4))
    else
        int steps = (momentum_score == 0 ? 1 : 0) + (target_score == 1 ? 1 : 0)
        idx := int(math.min(4 + steps, 5))
        if is_far_wrong_zone(pd_pct, ifvg_is_bullish)
            idx := 6
    if target_score == 0
        idx := int(math.max(idx, 5))
    string result = "C"
    switch idx
        0 => result := "A+"
        1 => result := "A"
        2 => result := "A-"
        3 => result := "B+"
        4 => result := "B"
        5 => result := "B-"
    result

// ─────────────────────────────────────────────────────────────────────
// Risk & position helpers
// ─────────────────────────────────────────────────────────────────────
// Grade → stats index (0 = A+ ... 6 = C)
grade_index(string grade) =>
    int(math.max(0, math.min(6, 7 - grade_to_value(grade))))

// USD amount the user risks per trade
risk_budget() =>
    i_risk_type == "%" ? i_account_size * i_risk_value / 100.0 : i_risk_value

usd(float v) =>
    "$" + str.tostring(math.abs(v), "#,##0.00")

// Micro contract for a mini/full futures root ("" = none); micros are 1/10 size
micro_root(string root) =>
    string result = ""
    switch root
        "NQ"  => result := "MNQ"
        "ES"  => result := "MES"
        "YM"  => result := "MYM"
        "RTY" => result := "M2K"
        "GC"  => result := "MGC"
        "CL"  => result := "MCL"
    result

// ─────────────────────────────────────────────────────────────────────
// Position size for the user's risk, rounded down so the risk is never exceeded
// RULE 1: Futures in contracts; on NQ/ES/YM/RTY/GC/CL the micro count is shown too,
//         and used alone when 1 full contract risks too much.
// RULE 2: Forex in lots (100,000 units), gold/silver in lots (100 / 5,000 oz),
//         stocks in shares, anything else in units (2 decimals).
// RULE 3: Risk per unit = stop distance × point value, converted to USD.
// Returns [size text, USD actually risked]; 0 risked = below the minimum size.
// ─────────────────────────────────────────────────────────────────────
position_info(float entry, float sl) =>
    float budget = risk_budget()
    float per_unit = math.abs(entry - sl) * syminfo.pointvalue * g_fx
    string txt = ""
    float used = 0.0
    if per_unit > 0
        if syminfo.type == "futures"
            string root = syminfo.root
            string micro = micro_root(root)
            int ct = int(math.floor(budget / per_unit))
            int mc = micro != "" ? int(math.floor(budget / (per_unit / 10.0))) : 0
            if ct >= 1
                txt := str.tostring(ct) + " " + root + (micro != "" ? " / " + str.tostring(mc) + " " + micro : "")
                used := ct * per_unit
            else if mc >= 1
                txt := str.tostring(mc) + " " + micro
                used := mc * per_unit / 10.0
            else
                float one = micro != "" ? per_unit / 10.0 : per_unit
                txt := "risk too small (1 " + (micro != "" ? micro : root) + " = " + usd(one) + ")"
                used := 0.0
        else
            float units = budget / per_unit
            float lot = syminfo.type == "forex" ? 100000.0 : syminfo.basecurrency == "XAU" ? 100.0 : syminfo.basecurrency == "XAG" ? 5000.0 : 0.0
            if lot > 0
                float lots = math.floor(units / lot * 100.0) / 100.0
                if lots >= 0.01
                    txt := str.tostring(lots, "0.00") + " lots"
                    used := lots * lot * per_unit
                else
                    txt := "risk too small (0.01 lot = " + usd(per_unit * lot * 0.01) + ")"
                    used := 0.0
            else
                float qty = syminfo.type == "stock" ? math.floor(units) : math.floor(units * 100.0) / 100.0
                if qty > 0
                    txt := str.tostring(qty) + (syminfo.type == "stock" ? " shares" : " units")
                    used := qty * per_unit
                else
                    txt := "risk too small"
                    used := 0.0
    [txt, used]

// ─────────────────────────────────────────────────────────────────────
// Trading session of the current candle (New York time, DST included)
// Asia 18:00-02:00 · London 02:00-07:00 · Pre-NY 07:00-09:30 · NY AM 09:30-12:00
// NY Lunch 12:00-13:30 · NY PM 13:30-16:00 · Close 16:00-18:00
// ─────────────────────────────────────────────────────────────────────
session_name() =>
    int mins = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    string result = "Close"
    if mins >= 1080 or mins < 120
        result := "Asia"
    else if mins < 420
        result := "London"
    else if mins < 570
        result := "Pre-NY"
    else if mins < 720
        result := "NY AM"
    else if mins < 810
        result := "NY Lunch"
    else if mins < 960
        result := "NY PM"
    result

// ─────────────────────────────────────────────────────────────────────
// Setup details as one text tag: "A|sw=1|dl=HTF|mo=2|si=2|tg=2|pd=discount|lr=0|ss=NY AM|bi=with"
// sw: 0 none, 1 wick sweep, 2 reclaimed · dl: HTF / TF / none · mo, si, tg: grading scores
// pd: PD zone · lr: LRLR in path · ss: session · bi: HTF bias with / against / neutral
// ─────────────────────────────────────────────────────────────────────
trade_tag(string grade, int sweep_kind, string delivery_src, int mom, int sing, int tgt, string pd_zone, bool has_lrlr, bool is_bull) =>
    string dl = delivery_src == "" ? "none" : str.startswith(delivery_src, "same TF") ? "TF" : "HTF"
    string bias = get_htf_bias()
    string bi = bias == "neutral" ? "neutral" : ((bias == "bullish") == is_bull ? "with" : "against")
    grade + "|sw=" + str.tostring(sweep_kind) + "|dl=" + dl + "|mo=" + str.tostring(mom) + "|si=" + str.tostring(sing) + "|tg=" + str.tostring(tgt) + "|pd=" + pd_zone + "|lr=" + (has_lrlr ? "1" : "0") + "|ss=" + session_name() + "|bi=" + bi

// ─────────────────────────────────────────────────────────────────────
// Alert texts (queued, sent once per candle close at the end of the script)
// ─────────────────────────────────────────────────────────────────────
fmt_px(float p) =>
    str.tostring(p, format.mintick)

fmt_r(float r) =>
    (r >= 0 ? "+" : "-") + str.tostring(math.abs(r), "0.0#") + "R"

alert_head(Trade t) =>
    t.grade + " " + (t.is_bull ? "BUY" : "SELL") + " " + syminfo.ticker + " " + get_tf_label(timeframe.period)

queue_alert(string msg) =>
    array.push(g_alert_msgs, msg)

setup_alert_text(Trade t) =>
    [size_txt, used] = position_info(t.entry, t.stop_px)
    float rr = math.abs(t.tp - t.entry) / math.abs(t.entry - t.stop_px)
    string stop_txt = "Stop: close " + (t.is_bull ? "below " : "above ") + fmt_px(t.stop_px) + (na(t.sl) ? "" : " · Hard SL " + fmt_px(t.sl))
    string tp_txt = "TP " + fmt_px(t.tp) + " (1:" + str.tostring(rr, "0.0#") + ")" + (na(t.be_level) ? "" : " · BE at " + fmt_px(t.be_level))
    (t.is_bull ? "🟢 " : "🔴 ") + alert_head(t) + "\nEntry " + fmt_px(t.entry) + " · " + stop_txt + "\n" + tp_txt + "\nSize " + size_txt + (used > 0 ? " · Risk " + usd(used) : "")

exit_alert_text(Trade t) =>
    [size_txt, used] = position_info(t.entry, t.stop_px)
    string what = t.result == 1 ? "✅ TP hit at " + fmt_px(t.exit_price) : t.result == -1 ? "❌ Hard stop hit at " + fmt_px(t.exit_price) : t.result == 3 ? "⚪ Stopped at breakeven " + fmt_px(t.exit_price) : "⛔ Closed " + (t.is_bull ? "below" : "above") + " the box at " + fmt_px(t.exit_price) + ", exit now"
    string pnl = used > 0 ? " (" + (t.r_result >= 0 ? "+" : "-") + usd(t.r_result * used) + ")" : ""
    alert_head(t) + "\n" + what + " · " + fmt_r(t.r_result) + pnl

// ─────────────────────────────────────────────────────────────────────
// Open a trade at the inversion close (open-stop model)
// 1R = entry → IFVG box far edge (planned stop; sizes the position).
// TP: fixed R:R of that 1R, or the setup's target (DOL level, else LRLR origin) when
// "Setup Target" is chosen — fixed R:R when the setup has no target.
// ─────────────────────────────────────────────────────────────────────
create_trade(bool is_bull, float entry, float sl, float zone_top, float zone_bottom, float be_level, string grade, string tag, Liquidity dol, LRLR lrlr) =>
    Trade t = na
    float stop_px = is_bull ? zone_bottom : zone_top
    float risk = is_bull ? entry - stop_px : stop_px - entry
    if risk > 0
        float tp = is_bull ? entry + risk * i_rr : entry - risk * i_rr
        if i_target_mode == "Setup Target"
            if not na(dol)
                tp := dol.level
            else if not na(lrlr)
                tp := lrlr.y1
        // BE move only when the BE level lies in profit and before the TP
        bool be_ok = not na(be_level) and (is_bull ? (be_level > entry and be_level < tp) : (be_level < entry and be_level > tp))
        t := Trade.new(is_bull = is_bull, entry = entry, sl = sl, stop_px = stop_px, tp = tp, zone_top = zone_top, zone_bottom = zone_bottom, be_level = be_ok ? be_level : na, grade = grade, start_bar = bar_index, end_bar = na, tag = tag)
        array.push(g_open_trades, t)
        if array.size(g_open_trades) > TRADES_OPEN_MAX
            array.shift(g_open_trades)
    t

// ══════════════════════════════════════════════════════════════════════
// SECTION 8: INVERSION DETECTION (Updated for Phase 2)
// ══════════════════════════════════════════════════════════════════════

check_inversions() =>
    int fvg_size = array.size(g_fvg_array)
    if barstate.isconfirmed and fvg_size > 0
        for i = fvg_size - 1 to 0
            if i >= 0 and i < array.size(g_fvg_array)  // Use fresh size check since array may be modified
                fvg = array.get(g_fvg_array, i)

                if fvg.status == "active"
                    fvg_age = bar_index - fvg.end_bar

                    if fvg_age >= 1
                        bool inverted = false

                        // Bullish FVG Inversion
                        if fvg.is_bullish
                            price_entered_zone = low <= fvg.top and low >= fvg.bottom
                            price_through_zone = low < fvg.bottom
                            body_closes_below = close < fvg.bottom

                            if (price_entered_zone or price_through_zone) and body_closes_below
                                inverted := true

                        // Bearish FVG Inversion
                        else
                            price_entered_zone = high >= fvg.bottom and high <= fvg.top
                            price_through_zone = high > fvg.top
                            body_closes_above = close > fvg.top

                            if (price_entered_zone or price_through_zone) and body_closes_above
                                inverted := true

                        // ═══════════════════════════════════════════════════════════
                        // SERIES OF GAPS (strategy 7.1) - same-direction FVGs made by one
                        // unbroken run of displacement candles are one zone. The setup fires
                        // only when a body closes through ALL of them, as a single inversion.
                        // RULE: an older active same-direction FVG joins while every candle
                        // between its 3-candle window and the chain is a displacement candle
                        // (same color as the move; touching windows join directly). An
                        // opposite-color candle between them is a pause and ends the series.
                        // A gap formed later inside an older zone stays a standalone setup.
                        // ═══════════════════════════════════════════════════════════
                        float s_top = fvg.top
                        float s_bottom = fvg.bottom
                        int s_start = fvg.start_bar
                        int series_count = 1
                        if inverted and i > 0
                            bool chain_open = true
                            for j = i - 1 to 0
                                FVG other = array.get(g_fvg_array, j)
                                bool candidate = (chain_open and other.status == "active" and other.is_bullish == fvg.is_bullish and other.start_bar < s_start)
                                if candidate
                                    // Candles between the two 3-candle windows must all be
                                    // displacement candles (no opposite color; dojis are neutral)
                                    bool opposite_between = false
                                    int from_bar = other.end_bar + 1
                                    int to_bar = s_start - 1
                                    if to_bar >= from_bar
                                        for k = from_bar to to_bar
                                            int off = bar_index - k
                                            if off >= 0 and off <= 499
                                                if fvg.is_bullish
                                                    if close[off] < open[off]
                                                        opposite_between := true
                                                else
                                                    if close[off] > open[off]
                                                        opposite_between := true
                                    if opposite_between
                                        chain_open := false
                                    else
                                        s_top := math.max(s_top, other.top)
                                        s_bottom := math.min(s_bottom, other.bottom)
                                        s_start := other.start_bar
                                        series_count += 1
                        if inverted
                            inverted := fvg.is_bullish ? close < s_bottom : close > s_top
                        float s_mid = (s_top + s_bottom) / 2

                        // Process Inversion with Phase 2 enhancements
                        if inverted
                            // Mark the whole series inverted and delete its FVG drawings
                            // (members are removed from the array after the loop)
                            for j = 0 to array.size(g_fvg_array) - 1
                                FVG member = array.get(g_fvg_array, j)
                                bool in_series = (j < i and member.status == "active" and member.is_bullish == fvg.is_bullish and member.start_bar >= s_start)
                                if j == i or in_series
                                    member.status := "inverted"
                                    if not na(member.box_id)
                                        box.delete(member.box_id)
                                        member.box_id := na
                                    if not na(member.label_id)
                                        label.delete(member.label_id)
                                        member.label_id := na

                            // IFVG direction is INVERTED
                            bool ifvg_is_bullish = not fvg.is_bullish

                            // ═══════════════════════════════════════════════════════════
                            // BE LEVEL - First swing point TO THE LEFT of the IFVG
                            // This is where you move your stop to breakeven (first target)
                            // ═══════════════════════════════════════════════════════════
                            float be_level = na
                            if ifvg_is_bullish
                                // Bullish IFVG (long): BE is first swing HIGH to the left
                                be_level := find_previous_swing_high(s_start)
                                if na(be_level)
                                    be_level := s_top  // Fallback: use FVG top
                            else
                                // Bearish IFVG (short): BE is first swing LOW to the left
                                be_level := find_previous_swing_low(s_start)
                                if na(be_level)
                                    be_level := s_bottom  // Fallback: use FVG bottom

                            // Final safety check - ensure BE is never na
                            if na(be_level)
                                be_level := ifvg_is_bullish ? s_top : s_bottom

                            // ═══════════════════════════════════════════════════════════
                            // SL LEVEL - Stop Loss placement (user configurable)
                            // Option 1: Strong High/Low (default) - the setup's own extreme: lowest
                            //           low (longs) / highest high (shorts) from the first FVG of
                            //           the zone to the inversion candle. This is the swing the
                            //           reversal came from, which becomes the Strong Low/High once
                            //           the move breaks structure. Older Strong levels are not used
                            //           (they can sit far from the setup).
                            // Option 2: FVG Boundary (bottom for bullish, top for bearish)
                            // ═══════════════════════════════════════════════════════════
                            // Setup extreme: lowest low (longs) / highest high (shorts) from the
                            // first FVG of the zone to the inversion candle, and its bar offset
                            int span = int(math.min(bar_index - s_start, 499))
                            float setup_extreme = ifvg_is_bullish ? low : high
                            int extreme_off = 0
                            if span > 0
                                for k = 1 to span
                                    bool more_extreme = ifvg_is_bullish ? low[k] < setup_extreme : high[k] > setup_extreme
                                    if more_extreme
                                        setup_extreme := ifvg_is_bullish ? low[k] : high[k]
                                        extreme_off := k
                            float fvg_edge = ifvg_is_bullish ? s_bottom : s_top
                            float sl_level = fvg_edge
                            string sl_type_used = "fvg_boundary"
                            if i_sl_type == "Strong High/Low"
                                bool beyond = ifvg_is_bullish ? setup_extreme < fvg_edge : setup_extreme > fvg_edge
                                if beyond
                                    sl_level := setup_extreme
                                    sl_type_used := "strong"

                            // Final safety check - ensure SL is never na
                            if na(sl_level)
                                sl_level := ifvg_is_bullish ? s_bottom : s_top

                            // ═══════════════════════════════════════════════════════════
                            // ENTRY VALIDITY - the SL is hit only by any candle
                            // closing beyond the IFVG box (see is_ifvg_stopped); the inversion
                            // candle closes on the other side, so the entry starts valid
                            // ═══════════════════════════════════════════════════════════
                            bool entry_valid = true

                            // Find DOL (target)
                            Liquidity dol = find_dol(ifvg_is_bullish, close)

                            // Check for a sweep inside this setup's move (FVG formation → inversion)
                            int sweep_kind = check_setup_sweep(not ifvg_is_bullish, s_start)
                            bool has_sweep = sweep_kind > 0

                            // Delivery: price tapped an active FVG (HTF first, then chart TF) during
                            // the setup's move (FVG formation → inversion)
                            string delivery_src = find_delivery(ifvg_is_bullish, s_start, extreme_off)
                            bool has_delivery = delivery_src != ""

                            // Assess momentum (returns int 0-2 per D-08)
                            int momentum_score = assess_momentum(ifvg_is_bullish, s_top, s_bottom, extreme_off)
                            // Map int score to string for backward compatibility (until Plan 03 rewrites rendering)
                            string momentum_str = momentum_score == 2 ? "strong_no_chop" : (momentum_score == 0 ? "weak_or_choppy" : "neutral")

                            // Calculate grade (rating PDF bands, see calculate_grade)
                            bool fvg_singular = series_count == 1 and is_fvg_singular(fvg)
                            float gap_size = s_top - s_bottom
                            int singular_score = score_singularity(fvg_singular, gap_size, atr_value)
                            string ifvg_pd_zone = compute_pd_zone(s_mid)
                            int ifvg_pd_pct = compute_range_percent(s_mid)
                            LRLR path_lrlr = lrlr_in_path(ifvg_is_bullish, close)
                            int target_score = score_target(dol, path_lrlr, close, sl_level)
                            string grade = calculate_grade(has_sweep, has_delivery, not str.startswith(delivery_src, "same TF"), momentum_score, target_score, singular_score, ifvg_pd_zone, ifvg_pd_pct, ifvg_is_bullish)

                            // Create IFVG
                            new_ifvg = IFVG.new(
                                top = s_top,
                                bottom = s_bottom,
                                mid = s_mid,
                                start_bar = s_start,
                                inversion_bar = bar_index,
                                inversion_close = close,
                                is_bullish = ifvg_is_bullish,
                                status = "inverted",
                                grade = grade,
                                entry_valid = entry_valid,
                                be_level = be_level,
                                be_status = entry_valid ? "intact" : "taken",
                                sl_level = sl_level,
                                sl_type = sl_type_used,
                                dol = dol,
                                has_sweep = has_sweep,
                                sweep_reclaimed = sweep_kind == 2,
                                momentum = momentum_str,
                                has_delivery = has_delivery,
                                delivery_src = delivery_src,
                                pd_zone = ifvg_pd_zone,
                                momentum_score = momentum_score,
                                singularity_score = singular_score,
                                target_score = target_score,
                                has_lrlr = not na(path_lrlr),
                                pd_pct = ifvg_pd_pct,
                                box_id = na,
                                label_id = na,
                                be_line_id = na,
                                sl_line_id = na,
                                entry_line_id = na,
                                entry_label_id = na,
                                formation_divider_id = na
                            )

                            string setup_tag = trade_tag(grade, sweep_kind, delivery_src, momentum_score, singular_score, target_score, ifvg_pd_zone, not na(path_lrlr), ifvg_is_bullish)
                            new_ifvg.trade := create_trade(ifvg_is_bullish, close, sl_level, s_top, s_bottom, be_level, grade, setup_tag, dol, path_lrlr)
                            if not na(new_ifvg.trade) and grade_meets_minimum(grade, i_alert_min_grade)
                                new_ifvg.trade.notify := true
                                if i_alert_setups
                                    queue_alert(setup_alert_text(new_ifvg.trade))
                            array.push(g_ifvg_array, new_ifvg)
        // Remove every FVG inverted on this bar (series members included)
        if array.size(g_fvg_array) > 0
            for r = array.size(g_fvg_array) - 1 to 0
                if array.get(g_fvg_array, r).status == "inverted"
                    array.remove(g_fvg_array, r)

// ══════════════════════════════════════════════════════════════════════
// SECTION 9: BE STATUS & MITIGATION DETECTION
// ══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// SL hit / setup invalidated: any candle closes below the IFVG box (longs) or
// above it (shorts) — the trader's open stop. Wicks through the box or the SL line
// do not stop the setup.
// ─────────────────────────────────────────────────────────────────────
is_ifvg_stopped(IFVG ifvg) =>
    ifvg.is_bullish ? close < ifvg.bottom : close > ifvg.top

// ─────────────────────────────────────────────────────────────────────
// Update BE and SL status for all active IFVGs
// BE = First target (where to move stop to breakeven)
// SL = Stop loss level (invalidates entry if hit)
// ─────────────────────────────────────────────────────────────────────
update_be_status() =>
    int ifvg_size = array.size(g_ifvg_array)
    if barstate.isconfirmed and ifvg_size > 0
        for i = 0 to ifvg_size - 1
            if i < ifvg_size
                ifvg = array.get(g_ifvg_array, i)

                if ifvg.status == "inverted"
                    // Check if BE target has been reached (price moved in favor)
                    if ifvg.be_status == "intact"
                        if ifvg.is_bullish
                            // Bullish IFVG: BE reached if price hits BE level from below
                            if high >= ifvg.be_level
                                ifvg.be_status := "taken"
                        else
                            // Bearish IFVG: BE reached if price hits BE level from above
                            if low <= ifvg.be_level
                                ifvg.be_status := "taken"

                    // Check if SL has been hit (candle-close rule, see is_ifvg_stopped)
                    if ifvg.entry_valid and bar_index > ifvg.inversion_bar
                        if is_ifvg_stopped(ifvg)
                            ifvg.entry_valid := false

// ─────────────────────────────────────────────────────────────────────
// Update DOL status for all active IFVGs
// If the DOL has been mitigated (swept or broken through), find a new valid DOL
// This ensures the dashboard always shows current, valid targets
// ─────────────────────────────────────────────────────────────────────
update_dol_status() =>
    int ifvg_size = array.size(g_ifvg_array)
    if barstate.isconfirmed and ifvg_size > 0
        for i = 0 to ifvg_size - 1
            if i < ifvg_size
                ifvg = array.get(g_ifvg_array, i)

                if ifvg.status == "inverted"
                    bool need_new_dol = false

                    // Check if current DOL is still valid
                    if not na(ifvg.dol)
                        // DOL is invalid if it has been swept OR broken through
                        if ifvg.dol.is_swept or not ifvg.dol.is_valid
                            need_new_dol := true
                    else
                        // No DOL set, try to find one
                        need_new_dol := true

                    // Find new DOL if needed
                    if need_new_dol
                        Liquidity new_dol = find_dol(ifvg.is_bullish, close)
                        ifvg.dol := new_dol

// ─────────────────────────────────────────────────────────────────────
// Check IFVG mitigations
// ─────────────────────────────────────────────────────────────────────
check_mitigations() =>
    int mitigation_count = 0
    int ifvg_size = array.size(g_ifvg_array)

    if barstate.isconfirmed and ifvg_size > 0
        for i = ifvg_size - 1 to 0
            if i >= 0 and i < array.size(g_ifvg_array)  // Use fresh size check since array may be modified
                ifvg = array.get(g_ifvg_array, i)

                if ifvg.status == "inverted"
                    // Mitigated = stopped: any candle closes beyond the box
                    bool mitigated = is_ifvg_stopped(ifvg)

                    if mitigated
                        if not na(ifvg.box_id)
                            box.delete(ifvg.box_id)
                        if not na(ifvg.label_id)
                            label.delete(ifvg.label_id)
                        if not na(ifvg.be_line_id)
                            line.delete(ifvg.be_line_id)
                        if not na(ifvg.sl_line_id)
                            line.delete(ifvg.sl_line_id)
                        if not na(ifvg.entry_line_id)
                            line.delete(ifvg.entry_line_id)
                        if not na(ifvg.entry_label_id)
                            label.delete(ifvg.entry_label_id)
                        if not na(ifvg.formation_divider_id)
                            line.delete(ifvg.formation_divider_id)

                        array.remove(g_ifvg_array, i)
                        mitigation_count += 1

    mitigation_count

// ─────────────────────────────────────────────────────────────────────
// Track open trades to their exit (open-stop model: win/loss stats, PnL label)
// RULE 1: Stop wick first — the hard stop (setup's SL line, rare, can be worse than
//         -1R), or entry once the stop moved to breakeven (0R). A candle that also
//         reaches the TP still counts as the stop (order inside a candle is unknown).
// RULE 2: TP: a wick to the TP wins.
// RULE 3: Any candle closing beyond the IFVG box exits at that close (the open stop,
//         about -1R). Wicks through the box that close back inside are not exits.
// RULE 4: After the exit checks, a wick to the BE level moves the stop to entry
//         from the next candle on.
// ─────────────────────────────────────────────────────────────────────
update_trades() =>
    int n = array.size(g_open_trades)
    if barstate.isconfirmed and n > 0
        for i = n - 1 to 0
            Trade t = array.get(g_open_trades, i)
            if bar_index > t.start_bar
                float risk = math.abs(t.entry - t.stop_px)
                float stop_now = t.be_moved ? t.entry : t.sl
                bool stop_hit = t.is_bull ? low <= stop_now : high >= stop_now
                bool tp_hit = t.is_bull ? high >= t.tp : low <= t.tp
                bool close_exit = t.is_bull ? close < t.zone_bottom : close > t.zone_top
                if stop_hit or tp_hit or close_exit
                    float exit_px = stop_hit ? stop_now : tp_hit ? t.tp : close
                    t.result := stop_hit ? (t.be_moved ? 3 : -1) : tp_hit ? 1 : 2
                    t.exit_price := exit_px
                    t.r_result := t.result == 3 ? 0.0 : (t.is_bull ? exit_px - t.entry : t.entry - exit_px) / risk
                    t.end_bar := bar_index
                    if t.notify and i_alert_updates
                        queue_alert(exit_alert_text(t))
                    int gi = grade_index(t.grade)
                    if grade_meets_minimum(t.grade, i_stats_min_grade)
                        if t.result == 3
                            array.set(g_stat_be, gi, array.get(g_stat_be, gi) + 1)
                        else if t.r_result > 0
                            array.set(g_stat_wins, gi, array.get(g_stat_wins, gi) + 1)
                        else
                            array.set(g_stat_losses, gi, array.get(g_stat_losses, gi) + 1)
                        array.set(g_stat_r, gi, array.get(g_stat_r, gi) + t.r_result)
                    if i_show_stats and grade_meets_minimum(t.grade, i_min_grade_display)
                        bool won = t.r_result > 0
                        string mark_txt = t.result == 3 ? "BE 0R" : (won ? "✓ +" : "✗ ") + str.tostring(t.r_result, "0.0") + "R"
                        color mark_col = t.result == 3 ? color.gray : won ? i_bullish_color : i_bearish_color
                        label mk = label.new(bar_index, exit_px, mark_txt, style=(t.is_bull == won ? label.style_label_down : label.style_label_up), color=color.new(color.black, 100), textcolor=mark_col, size=size.tiny)
                        array.push(g_trade_marks, mk)
                        if array.size(g_trade_marks) > TRADE_MARKS_MAX
                            label.delete(array.shift(g_trade_marks))
                    array.remove(g_open_trades, i)
                if t.result == 0 and not t.be_moved and not na(t.be_level)
                    if t.is_bull ? high >= t.be_level : low <= t.be_level
                        t.be_moved := true
                        if t.notify and i_alert_updates
                            queue_alert("🔵 " + alert_head(t) + "\nBE level " + fmt_px(t.be_level) + " reached · move stop to entry " + fmt_px(t.entry))

// ══════════════════════════════════════════════════════════════════════
// SECTION 10: RENDERING
// ══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// PD Dealing Range — clear drawing handles
// Delete all drawing handles on a DealingRange. Safe with na refs.
// ─────────────────────────────────────────────────────────────────────
clear_range_drawings(DealingRange r) =>
    if not na(r)
        if not na(r.line_high)
            line.delete(r.line_high)
        if not na(r.line_eq)
            line.delete(r.line_eq)
        if not na(r.line_low)
            line.delete(r.line_low)
        if not na(r.label_high)
            label.delete(r.label_high)
        if not na(r.label_eq)
            label.delete(r.label_eq)
        if not na(r.label_low)
            label.delete(r.label_low)
        if not na(r.fill_premium)
            linefill.delete(r.fill_premium)
        if not na(r.fill_discount)
            linefill.delete(r.fill_discount)
        if not na(r.ote_line_top)
            line.delete(r.ote_line_top)
        if not na(r.ote_line_bot)
            line.delete(r.ote_line_bot)
        if not na(r.ote_fill)
            linefill.delete(r.ote_fill)

// ─────────────────────────────────────────────────────────────────────
// PD Dealing Range — render 3 dashed lines + labels + optional fills/OTE
// Creates drawings when handles are na; otherwise extends right edge.
// ─────────────────────────────────────────────────────────────────────
render_dealing_range(DealingRange r) =>
    if not na(r) and r.is_valid and i_show_pd_lines
        int right_edge = math.min(bar_index + i_extend_bars, bar_index + 400)
        int left_edge = clamp_left_bar(int(math.max(r.high_bar_idx, r.low_bar_idx)))
        float hi = r.high_price
        float lo = r.low_price
        float eq = (hi + lo) / 2.0
        // ── Lines ──
        if na(r.line_high)
            r.line_high := line.new(left_edge, hi, right_edge, hi, color=i_pd_line_color, style=line.style_dashed, width=i_pd_line_width)
        else
            line.set_x2(r.line_high, right_edge)
        if na(r.line_eq)
            r.line_eq := line.new(left_edge, eq, right_edge, eq, color=i_pd_eq_color, style=line.style_dashed, width=i_pd_line_width)
        else
            line.set_x2(r.line_eq, right_edge)
        if na(r.line_low)
            r.line_low := line.new(left_edge, lo, right_edge, lo, color=i_pd_line_color, style=line.style_dashed, width=i_pd_line_width)
        else
            line.set_x2(r.line_low, right_edge)
        // ── Labels (exact D-08 format: percentage (price)) ──
        // Label lanes (no overlap): PD labels sit ABOVE-right of the line end, liquidity
        // labels BELOW-right, entry labels ABOVE-left, the IFVG tag inside the box.
        string txt_high = "1 (" + str.tostring(hi, "#.##") + ")"
        string txt_eq   = "0.5 (" + str.tostring(eq, "#.##") + ")"
        string txt_low  = "0 (" + str.tostring(lo, "#.##") + ")"
        if na(r.label_high)
            r.label_high := label.new(right_edge, hi, txt_high, style=label.style_label_lower_left, color=color.new(color.black, 100), textcolor=i_pd_line_color, size=size.small)
        else
            label.set_x(r.label_high, right_edge)
            label.set_text(r.label_high, txt_high)
        if na(r.label_eq)
            r.label_eq := label.new(right_edge, eq, txt_eq, style=label.style_label_lower_left, color=color.new(color.black, 100), textcolor=i_pd_eq_color, size=size.small)
        else
            label.set_x(r.label_eq, right_edge)
            label.set_text(r.label_eq, txt_eq)
        if na(r.label_low)
            r.label_low := label.new(right_edge, lo, txt_low, style=label.style_label_lower_left, color=color.new(color.black, 100), textcolor=i_pd_line_color, size=size.small)
        else
            label.set_x(r.label_low, right_edge)
            label.set_text(r.label_low, txt_low)
        // ── Optional zone fills (D-09, default OFF) ──
        if i_show_pd_fills
            if na(r.fill_premium)
                r.fill_premium := linefill.new(r.line_high, r.line_eq, color.new(i_bearish_color, 92))
            if na(r.fill_discount)
                r.fill_discount := linefill.new(r.line_eq, r.line_low, color.new(i_bullish_color, 92))
        else
            if not na(r.fill_premium)
                linefill.delete(r.fill_premium)
                r.fill_premium := na
            if not na(r.fill_discount)
                linefill.delete(r.fill_discount)
                r.fill_discount := na
        // ── Optional OTE band 62%-79% (D-10, default OFF, visual only) ──
        if i_show_ote
            float range_span = hi - lo
            float ote_low_price = lo + range_span * 0.62
            float ote_high_price = lo + range_span * 0.79
            if na(r.ote_line_top)
                r.ote_line_top := line.new(left_edge, ote_high_price, right_edge, ote_high_price, color=color.new(#AB47BC, 70), style=line.style_dotted)
            else
                line.set_x2(r.ote_line_top, right_edge)
                line.set_y1(r.ote_line_top, ote_high_price)
                line.set_y2(r.ote_line_top, ote_high_price)
            if na(r.ote_line_bot)
                r.ote_line_bot := line.new(left_edge, ote_low_price, right_edge, ote_low_price, color=color.new(#AB47BC, 70), style=line.style_dotted)
            else
                line.set_x2(r.ote_line_bot, right_edge)
                line.set_y1(r.ote_line_bot, ote_low_price)
                line.set_y2(r.ote_line_bot, ote_low_price)
            if na(r.ote_fill)
                r.ote_fill := linefill.new(r.ote_line_top, r.ote_line_bot, color.new(#AB47BC, 92))
        else
            if not na(r.ote_line_top)
                line.delete(r.ote_line_top)
                r.ote_line_top := na
            if not na(r.ote_line_bot)
                line.delete(r.ote_line_bot)
                r.ote_line_bot := na
            if not na(r.ote_fill)
                linefill.delete(r.ote_fill)
                r.ote_fill := na

// ─────────────────────────────────────────────────────────────────────
// Render Active FVG Boxes
// ─────────────────────────────────────────────────────────────────────
render_fvg_boxes() =>
    int fvg_size = array.size(g_fvg_array)
    int shown = 0
    if i_show_active_fvg and fvg_size > 0
        // Newest first: only the newest i_max_fvgs active FVGs are drawn
        for i = fvg_size - 1 to 0
            if i < fvg_size
                fvg = array.get(g_fvg_array, i)
                if not na(fvg.box_id)
                    box.delete(fvg.box_id)
                    fvg.box_id := na
                if not na(fvg.label_id)
                    label.delete(fvg.label_id)
                    fvg.label_id := na
                if fvg.status == "active" and shown < i_max_fvgs
                    shown += 1
                    bg_color = get_fvg_color(fvg.is_bullish)
                    border_color = get_border_color(fvg.is_bullish)
                    border_style = get_border_style(i_fvg_border_style)
                    right_edge = bar_index + i_extend_bars

                    int fvg_left_edge = clamp_left_bar(fvg.start_bar)
                    fvg.box_id := box.new(
                        left = fvg_left_edge,
                        top = fvg.top,
                        right = right_edge,
                        bottom = fvg.bottom,
                        bgcolor = bg_color,
                        border_color = border_color,
                        border_width = i_fvg_border_width,
                        border_style = border_style
                    )

                    if i_show_labels
                        label_text = fvg.is_bullish ? "FVG ▲" : "FVG ▼"
                        fvg.label_id := label.new(
                            x = right_edge - 2,
                            y = fvg.bottom,
                            text = label_text,
                            style = label.style_none,
                            color = color.new(color.black, 100),
                            textcolor = border_color,
                            size = get_label_size(),
                            textalign = text.align_right,
                            yloc = yloc.price
                        )

// ─────────────────────────────────────────────────────────────────────
// Render IFVG Boxes (Phase 2: with grade and BE)
// ─────────────────────────────────────────────────────────────────────
render_ifvg_boxes() =>
    int ifvg_size = array.size(g_ifvg_array)
    if ifvg_size > 0
        // Count how many IFVGs have been displayed (from newest to oldest)
        int displayed_count = 0

        // Process from newest to oldest (end of array to start)
        for i = ifvg_size - 1 to 0
            if i >= 0 and i < ifvg_size
                ifvg = array.get(g_ifvg_array, i)

                // Always delete old drawings first
                if not na(ifvg.box_id)
                    box.delete(ifvg.box_id)
                    ifvg.box_id := na
                if not na(ifvg.label_id)
                    label.delete(ifvg.label_id)
                    ifvg.label_id := na
                if not na(ifvg.be_line_id)
                    line.delete(ifvg.be_line_id)
                    ifvg.be_line_id := na
                if not na(ifvg.sl_line_id)
                    line.delete(ifvg.sl_line_id)
                    ifvg.sl_line_id := na
                if not na(ifvg.entry_line_id)
                    line.delete(ifvg.entry_line_id)
                    ifvg.entry_line_id := na
                if not na(ifvg.entry_label_id)
                    label.delete(ifvg.entry_label_id)
                    ifvg.entry_label_id := na
                if not na(ifvg.formation_divider_id)
                    line.delete(ifvg.formation_divider_id)
                    ifvg.formation_divider_id := na

                // Check HTF bias alignment (Phase 3)
                bool htf_aligned = true
                if i_enable_htf and i_htf_filter_ltf
                    string combined_bias = get_htf_bias()
                    if combined_bias != "neutral"
                        // Filter: only show LTF setups that match HTF bias
                        htf_aligned := (combined_bias == "bullish" and ifvg.is_bullish) or
                                      (combined_bias == "bearish" and not ifvg.is_bullish)

                // Only render if: enabled, inverted status, meets grade, HTF aligned, and under display limit
                bool should_display = i_show_ifvg and ifvg.status == "inverted" and
                                     grade_meets_minimum(ifvg.grade, i_min_grade_display) and
                                     htf_aligned and
                                     displayed_count < i_max_recent_display

                if should_display
                    displayed_count += 1

                    // IFVG box: translucent gray with NO borders
                    ifvg_bg_color = color.new(i_ifvg_box_color, i_ifvg_box_opacity)
                    // Right edge projects forward to current bar — IFVG remains a live zone until mitigated
                    right_edge = bar_index + i_extend_bars

                    // Box left edge anchors at the ORIGINAL FVG's first bar (not the inversion bar),
                    // so the box visually covers the imbalance zone from its formation onward.
                    int ifvg_left_edge = clamp_left_bar(ifvg.start_bar)
                    ifvg.box_id := box.new(
                        left = ifvg_left_edge,
                        top = ifvg.top,
                        right = right_edge,
                        bottom = ifvg.bottom,
                        bgcolor = ifvg_bg_color,
                        border_color = color.new(color.gray, 100),  // Fully transparent border
                        border_width = 0,
                        border_style = line.style_solid
                    )

                    // Draw tiny "IFVG" tag inside the box, right side, at mid (away from
                    // the entry line, which sits just outside the box edge)
                    if i_show_labels
                        ifvg.label_id := label.new(
                            x = right_edge,
                            y = ifvg.mid,
                            text = "IFVG",
                            style = label.style_label_right,
                            color = color.new(color.black, 100),
                            textcolor = color.new(color.gray, 30),  // Subtle gray text
                            size = size.tiny,
                            textalign = text.align_right,
                            yloc = yloc.price
                        )

                    // ═══════════════════════════════════════════════════════════
                    // Draw SL line (Stop Loss - ABOVE for bearish, BELOW for bullish)
                    // Drawn FIRST so BE line appears on top
                    // ═══════════════════════════════════════════════════════════
                    if i_show_sl_level
                        float sl_draw_level = ifvg.sl_level
                        if na(sl_draw_level)
                            // Fallback: use FVG boundary
                            sl_draw_level := ifvg.is_bullish ? ifvg.bottom : ifvg.top

                        if not na(sl_draw_level)
                            sl_line_color = ifvg.entry_valid ? i_sl_color : color.new(i_sl_color, 60)
                            sl_line_style = line.style_solid

                            ifvg.sl_line_id := line.new(
                                x1 = ifvg_left_edge,
                                y1 = sl_draw_level,
                                x2 = right_edge,
                                y2 = sl_draw_level,
                                color = sl_line_color,
                                style = sl_line_style,
                                width = 2
                            )

                    // ═══════════════════════════════════════════════════════════
                    // Draw BE line (Break-Even target - BELOW for bearish, ABOVE for bullish)
                    // This is the first swing target where you move stop to breakeven
                    // ═══════════════════════════════════════════════════════════
                    if i_show_be_level
                        float be_draw_level = ifvg.be_level
                        if na(be_draw_level)
                            // Fallback: use FVG boundary
                            be_draw_level := ifvg.is_bullish ? ifvg.top : ifvg.bottom

                        if not na(be_draw_level)
                            be_line_color = ifvg.be_status == "intact" ? i_be_color : color.new(i_be_color, 60)
                            be_line_style = ifvg.be_status == "intact" ? line.style_dashed : line.style_dotted

                            ifvg.be_line_id := line.new(
                                x1 = ifvg_left_edge,
                                y1 = be_draw_level,
                                x2 = right_edge,
                                y2 = be_draw_level,
                                color = be_line_color,
                                style = be_line_style,
                                width = 2
                            )

                    // ═══════════════════════════════════════════════════════════
                    // Draw Entry Line at inversion candle close
                    // Shows Grade + Direction (e.g., "A+ BUY" or "B- SELL")
                    // ═══════════════════════════════════════════════════════════
                    if i_show_entry_line
                        float entry_level = ifvg.inversion_close
                        if not na(entry_level)
                            // Entry line color based on direction
                            entry_line_color = ifvg.is_bullish ? i_entry_color_bull : i_entry_color_bear

                            // Draw entry line
                            int entry_left_edge = clamp_left_bar(ifvg.inversion_bar)
                            ifvg.entry_line_id := line.new(
                                x1 = entry_left_edge,
                                y1 = entry_level,
                                x2 = right_edge,
                                y2 = entry_level,
                                color = entry_line_color,
                                style = line.style_solid,
                                width = 2
                            )

                            // Build tooltip with the grading checklist (values at inversion)
                            int tt_mom = ifvg.momentum_score
                            int tt_tgt = ifvg.target_score
                            int tt_sg = ifvg.singularity_score
                            int tt_pd = score_pd_zone(ifvg.pd_zone, ifvg.is_bullish)
                            string sweep_text = ifvg.sweep_reclaimed ? "Sweep (closed through, reclaimed)" : "Sweep"
                            string band_text = ifvg.has_sweep and ifvg.has_delivery ? sweep_text + " + Delivery (" + ifvg.delivery_src + ") (A+ band)" : (ifvg.has_sweep ? sweep_text + " only (A band)" : (ifvg.has_delivery ? "Delivery (" + ifvg.delivery_src + ") only (A band)" : "No sweep or delivery (B band)"))
                            string mom_text = tt_mom == 2 ? "Strong, no chop" : (tt_mom == 0 ? "Weak / choppy" : "Some chop")
                            string tgt_text = (tt_tgt == 2 ? "Clear" : (tt_tgt == 1 ? "Closer than stop" : "None")) + (ifvg.has_lrlr ? " + LRLR" : "")
                            string dol_text = not na(ifvg.dol) ? (" (now " + ifvg.dol.liq_type + " @ " + str.tostring(ifvg.dol.level, format.mintick) + ")") : ""
                            string sg_text = tt_sg == 2 ? "Singular, obvious" : (tt_sg == 1 ? "Singular, small" : "Not singular")
                            string pct_text = na(ifvg.pd_pct) ? "" : (" " + str.tostring(ifvg.pd_pct) + "%")
                            string zone_text = str.upper(ifvg.pd_zone) + pct_text
                            entry_status = ifvg.entry_valid ? "VALID" : "INVALID (SL hit)"
                            tooltip_text = "Grade: " + ifvg.grade + "\n" +
                                          "─────────────\n" +
                                          band_text + "\n" +
                                          "[" + str.tostring(tt_mom) + "] Momentum: " + mom_text + "\n" +
                                          "[" + str.tostring(tt_tgt) + "] Target: " + tgt_text + dol_text + "\n" +
                                          "[" + str.tostring(tt_sg) + "] FVG: " + sg_text + "\n" +
                                          "[" + str.tostring(tt_pd) + "] Zone: " + zone_text + "\n" +
                                          "─────────────\n" +
                                          "Entry: " + entry_status
                            // Entry line label: Grade + Direction (+ invalid mark)
                            direction_text = ifvg.is_bullish ? "BUY" : "SELL"
                            entry_label_text = ifvg.grade + " " + direction_text + (ifvg.entry_valid ? "" : " (invalid)")

                            ifvg.entry_label_id := label.new(
                                x = right_edge,
                                y = entry_level,
                                text = entry_label_text,
                                style = label.style_label_lower_right,
                                color = color.new(color.black, 100),
                                textcolor = entry_line_color,
                                size = size.small,
                                textalign = text.align_right,
                                yloc = yloc.price,
                                tooltip = tooltip_text
                            )

                    // ═══════════════════════════════════════════════════════════
                    // Draw Formation Divider — thin vertical line at inversion_bar
                    // Visually separates the original FVG formation (left of line)
                    // from the post-inversion live zone projection (right of line).
                    // ═══════════════════════════════════════════════════════════
                    if i_show_formation_divider and not na(ifvg.inversion_bar) and (bar_index - ifvg.inversion_bar < 5000)
                        ifvg.formation_divider_id := line.new(
                            x1 = ifvg.inversion_bar,
                            y1 = ifvg.top,
                            x2 = ifvg.inversion_bar,
                            y2 = ifvg.bottom,
                            color = color.new(color.gray, 30),
                            style = line.style_dotted,
                            width = 1,
                            extend = extend.none
                        )

// ─────────────────────────────────────────────────────────────────────
// Render HTF FVG Boxes (Phase 3)
// ─────────────────────────────────────────────────────────────────────
render_htf_fvg_boxes(array<FVG> arr, string tf_label) =>
    if i_enable_htf and i_show_htf_fvg
        int arr_size = array.size(arr)
        int shown = 0
        if arr_size > 0
            // Newest first: only the newest i_max_fvgs active HTF FVGs are drawn
            for i = arr_size - 1 to 0
                if i < array.size(arr)
                    fvg = array.get(arr, i)
                    if not na(fvg.box_id)
                        box.delete(fvg.box_id)
                        fvg.box_id := na
                    if not na(fvg.label_id)
                        label.delete(fvg.label_id)
                        fvg.label_id := na
                    if fvg.status == "active" and shown < i_max_fvgs
                        shown += 1
                        // HTF boxes: same colors but thicker borders
                        base_color = fvg.is_bullish ? i_bullish_color : i_bearish_color
                        bg_color = color.new(base_color, i_htf_box_opacity)
                        border_color = base_color
                        // Active HTF FVG projects forward to current bar (live zone).
                        right_edge = bar_index + i_extend_bars
                        // Left anchored at the HTF FVG's first bar — stays put as price moves on.
                        int left_edge = clamp_left_bar(fvg.start_bar)

                        fvg.box_id := box.new(
                            left = left_edge,
                            top = fvg.top,
                            right = right_edge,
                            bottom = fvg.bottom,
                            bgcolor = bg_color,
                            border_color = border_color,
                            border_width = i_htf_border_width,
                            border_style = line.style_solid
                        )

                        // Label with timeframe indicator
                        if i_show_labels
                            direction_arrow = fvg.is_bullish ? " ▲" : " ▼"
                            label_text = "[" + tf_label + "] FVG" + direction_arrow

                            fvg.label_id := label.new(
                                x = right_edge - 2,
                                y = fvg.is_bullish ? fvg.bottom : fvg.top,
                                text = label_text,
                                style = label.style_none,
                                color = color.new(color.black, 100),
                                textcolor = border_color,
                                size = size.small,
                                textalign = text.align_right,
                                yloc = yloc.price
                            )

// ─────────────────────────────────────────────────────────────────────
// Render HTF IFVG Boxes (Phase 3)
// ─────────────────────────────────────────────────────────────────────
render_htf_ifvg_boxes(array<IFVG> arr, string tf_label) =>
    if i_enable_htf and i_show_htf_ifvg
        int arr_size = array.size(arr)
        if arr_size > 0
            for i = 0 to arr_size - 1
                if i < array.size(arr)
                    ifvg = array.get(arr, i)

                    if ifvg.status == "inverted"
                        // Delete old drawings
                        if not na(ifvg.box_id)
                            box.delete(ifvg.box_id)
                        if not na(ifvg.label_id)
                            label.delete(ifvg.label_id)

                        // HTF IFVG boxes: use gray with dashed thick border
                        bg_color = color.new(color.gray, i_htf_box_opacity)
                        border_color = ifvg.is_bullish ? i_bullish_color : i_bearish_color
                        // Right edge projects forward — HTF IFVG is a live zone until mitigated.
                        right_edge = bar_index + i_extend_bars
                        // Left anchored at the source HTF FVG's first bar (not the inversion bar).
                        int left_edge = clamp_left_bar(ifvg.start_bar)

                        ifvg.box_id := box.new(
                            left = left_edge,
                            top = ifvg.top,
                            right = right_edge,
                            bottom = ifvg.bottom,
                            bgcolor = bg_color,
                            border_color = border_color,
                            border_width = i_htf_border_width,
                            border_style = line.style_dashed
                        )

                        // Label with timeframe and direction
                        if i_show_labels
                            direction_text = ifvg.is_bullish ? "LONG" : "SHORT"
                            label_text = "[" + tf_label + "] IFVG " + direction_text

                            ifvg.label_id := label.new(
                                x = right_edge - 2,
                                y = ifvg.bottom,
                                text = label_text,
                                style = label.style_none,
                                color = color.new(color.black, 100),
                                textcolor = border_color,
                                size = size.small,
                                textalign = text.align_right,
                                yloc = yloc.price
                            )

// ─────────────────────────────────────────────────────────────────────
// Count live (unswept, unbroken) liquidity levels for the dashboard
// ─────────────────────────────────────────────────────────────────────
count_live_liquidity() =>
    int live = 0
    int n = array.size(g_liquidity_array)
    if n > 0
        for i = 0 to n - 1
            Liquidity liq = array.get(g_liquidity_array, i)
            if liq.is_valid and not liq.is_swept
                live += 1
    live

// ─────────────────────────────────────────────────────────────────────
// n-th smallest value of an array (na when empty; largest value if fewer than n)
// ─────────────────────────────────────────────────────────────────────
nth_smallest(array<float> values, int n) =>
    float result = na
    int sz = array.size(values)
    if sz > 0
        array.sort(values, order.ascending)
        result := array.get(values, int(math.min(n, sz)) - 1)
    result

// ─────────────────────────────────────────────────────────────────────
// Whether a liquidity level's TYPE is enabled for display
// (visibility toggles only — data is always kept for grading)
// ─────────────────────────────────────────────────────────────────────
is_liq_displayable(Liquidity liq) =>
    bool is_eq = liq.liq_type == "EQH" or liq.liq_type == "EQL"
    bool is_internal = liq.liq_type == "ITH" or liq.liq_type == "ITL"
    bool is_data = liq.liq_type == "Data High" or liq.liq_type == "Data Low"
    bool type_on = (is_eq and i_show_eqh_eql) or (is_internal and i_show_ith_itl) or (is_data and i_show_data)
    bool quality_ok = not (is_eq and i_show_perfect_only and liq.quality == "relative")
    type_on and quality_ok

// ─────────────────────────────────────────────────────────────────────
// Render Liquidity Lines (Phase 2 - Enhanced with quality indicators)
// ─────────────────────────────────────────────────────────────────────
render_liquidity_lines() =>
    int liq_size = array.size(g_liquidity_array)
    if liq_size > 0
        // Pass 1: distance cut-offs so only the nearest LIQ_DRAW_PER_SIDE live levels
        // above and below price are drawn (all live levels stay in memory)
        // Strong, weak and Data levels are ranked separately, so a Strong High/Low or a
        // news candle level is never hidden behind nearer weak pullback levels
        array<float> above_strong = array.new<float>()
        array<float> above_weak = array.new<float>()
        array<float> below_strong = array.new<float>()
        array<float> below_weak = array.new<float>()
        array<float> above_data = array.new<float>()
        array<float> below_data = array.new<float>()
        for i = 0 to liq_size - 1
            Liquidity lq = array.get(g_liquidity_array, i)
            if is_liq_displayable(lq) and lq.is_valid and not lq.is_swept
                bool lq_above = lq.level >= close
                bool lq_data = lq.liq_type == "Data High" or lq.liq_type == "Data Low"
                float lq_dist = math.abs(lq.level - close)
                if lq_data
                    array.push(lq_above ? above_data : below_data, lq_dist)
                else
                    if lq_above and lq.is_strong
                        array.push(above_strong, lq_dist)
                    if lq_above and not lq.is_strong
                        array.push(above_weak, lq_dist)
                    if not lq_above and lq.is_strong
                        array.push(below_strong, lq_dist)
                    if not lq_above and not lq.is_strong
                        array.push(below_weak, lq_dist)
        float above_strong_cut = nth_smallest(above_strong, LIQ_DRAW_PER_SIDE)
        float above_weak_cut = nth_smallest(above_weak, LIQ_DRAW_PER_SIDE)
        float below_strong_cut = nth_smallest(below_strong, LIQ_DRAW_PER_SIDE)
        float below_weak_cut = nth_smallest(below_weak, LIQ_DRAW_PER_SIDE)
        float above_data_cut = nth_smallest(above_data, LIQ_DRAW_PER_SIDE)
        float below_data_cut = nth_smallest(below_data, LIQ_DRAW_PER_SIDE)
        // Pass 2: draw
        array<float> placed_y = array.new<float>()
        array<label> placed_lbl = array.new<label>()
        for i = 0 to liq_size - 1
            if i < liq_size
                liq = array.get(g_liquidity_array, i)
                bool is_mitigated = liq.is_swept or not liq.is_valid
                bool is_data_lvl = liq.liq_type == "Data High" or liq.liq_type == "Data Low"
                bool is_near = false
                if not is_mitigated
                    if liq.level >= close
                        float cut_a = is_data_lvl ? above_data_cut : liq.is_strong ? above_strong_cut : above_weak_cut
                        is_near := not na(cut_a) and liq.level - close <= cut_a
                    else
                        float cut_b = is_data_lvl ? below_data_cut : liq.is_strong ? below_strong_cut : below_weak_cut
                        is_near := not na(cut_b) and close - liq.level <= cut_b
                bool should_draw = is_liq_displayable(liq) and (is_mitigated ? i_show_mitigated_liq : is_near)
                // Delete drawings and skip levels that are hidden, far from price, or mitigated (unless shown)
                if not should_draw
                    delete_liquidity_drawings(liq)
                    continue
                // Delete old drawings (for items that will be redrawn)
                if not na(liq.line_id)
                    line.delete(liq.line_id)
                if not na(liq.label_id)
                    label.delete(liq.label_id)

                // Determine color and style based on type, quality, and status
                line_color = color.gray
                line_style = line.style_solid
                int line_width = 1

                if liq.liq_type == "EQH" or liq.liq_type == "EQL"
                    // Base color depends on quality
                    if liq.quality == "perfect"
                        line_color := color.new(#FF6600, 0)  // Bright orange for perfect
                        line_width := 2
                    else
                        line_color := i_liq_color  // Standard orange for relative

                    // Modify for swept status
                    if liq.is_swept
                        line_color := color.new(color.gray, 50)  // Gray out swept
                        line_style := line.style_dotted
                    else if not liq.is_valid
                        line_color := color.new(color.gray, 70)  // Faded if broken through
                        line_style := line.style_dotted
                    else
                        line_style := line.style_solid

                else if liq.liq_type == "ITH" or liq.liq_type == "ITL"
                    if liq.is_swept
                        line_color := color.new(i_ithl_color, 70)  // Faded if swept
                        line_style := line.style_dotted
                    else if not liq.is_valid
                        line_color := color.new(color.gray, 70)  // Gray if broken through
                        line_style := line.style_dotted
                    else
                        line_color := i_ithl_color
                        line_style := line.style_dashed

                else if is_data_lvl
                    if liq.is_swept
                        line_color := color.new(DATA_COLOR, 70)  // Faded if swept
                        line_style := line.style_dotted
                    else if not liq.is_valid
                        line_color := color.new(color.gray, 70)  // Gray if broken through
                        line_style := line.style_dotted
                    else
                        line_color := DATA_COLOR
                        line_style := line.style_solid

                // Strong High/Low: thicker line
                if liq.is_strong
                    line_width := 2
                right_edge = bar_index + i_extend_bars

                // Draw line
                liq.line_id := line.new(
                    x1 = clamp_left_bar(liq.bar_idx),
                    y1 = liq.level,
                    x2 = right_edge,
                    y2 = liq.level,
                    color = line_color,
                    style = line_style,
                    width = line_width
                )

                // Draw label with enhanced info
                if i_show_labels
                    label_text = liq.is_strong ? (liq.liq_type == "ITH" ? "Strong High" : "Strong Low") : liq.liq_type

                    if liq.liq_type == "EQH" or liq.liq_type == "EQL"
                        // Build label based on quality:
                        // Perfect: "EQL★ (2)" or "EQH★ (3)"
                        // Relative: "R.EQL (2)" or "R.EQH (3)"
                        if liq.quality == "perfect"
                            label_text := liq.liq_type + "★ (" + str.tostring(liq.touch_count) + ")"
                        else if liq.quality == "relative"
                            label_text := "R." + liq.liq_type + " (" + str.tostring(liq.touch_count) + ")"
                        else
                            label_text := liq.liq_type + " (" + str.tostring(liq.touch_count) + ")"

                    // Add status indicator
                    if liq.is_swept
                        label_text := label_text + " ✗"
                    else if not liq.is_valid
                        label_text := label_text + " ⊘"  // Broken through but not swept

                    // Levels closer than one label height share one label ("Strong Low · ITL")
                    int near_idx = -1
                    int placed_n = array.size(placed_y)
                    if placed_n > 0
                        for p = 0 to placed_n - 1
                            if near_idx < 0 and math.abs(array.get(placed_y, p) - liq.level) < g_label_gap
                                near_idx := p
                    if near_idx >= 0
                        label near_lbl = array.get(placed_lbl, near_idx)
                        liq.label_id := na
                        label.set_text(near_lbl, label.get_text(near_lbl) + " · " + label_text)
                    else
                        liq.label_id := label.new(
                            x = right_edge,
                            y = liq.level,
                            text = label_text,
                            style = label.style_label_upper_left,
                            color = color.new(color.black, 100),
                            textcolor = line_color,
                            size = size.tiny,
                            textalign = text.align_left,
                            yloc = yloc.price
                        )
                        array.push(placed_y, liq.level)
                        array.push(placed_lbl, liq.label_id)

// ─────────────────────────────────────────────────────────────────────
// Position on the latest valid setup: PnL zone (loss/profit boxes) and the
// lot size & risk label. The two toggles are independent.
// ─────────────────────────────────────────────────────────────────────
render_position() =>
    if barstate.islast
        for k = 0 to 1
            box old_b = array.get(g_pos_boxes, k)
            if not na(old_b)
                box.delete(old_b)
                array.set(g_pos_boxes, k, na)
        label old_l = array.get(g_pos_label, 0)
        if not na(old_l)
            label.delete(old_l)
            array.set(g_pos_label, 0, na)
        IFVG sel = na
        int n = array.size(g_ifvg_array)
        if (i_show_pnl or i_show_size) and n > 0
            for i = n - 1 to 0
                IFVG f = array.get(g_ifvg_array, i)
                if na(sel) and f.status == "inverted" and f.entry_valid and not na(f.trade) and grade_meets_minimum(f.grade, i_min_grade_display)
                    sel := f
        if not na(sel)
            Trade t = sel.trade
            int left_x = clamp_left_bar(t.start_bar)
            int right_x = t.result != 0 ? t.end_bar : bar_index + i_extend_bars
            if i_show_pnl
                array.set(g_pos_boxes, 0, box.new(left_x, math.max(t.entry, t.stop_px), right_x, math.min(t.entry, t.stop_px), border_color=i_pnl_loss_color, bgcolor=i_pnl_loss_color))
                array.set(g_pos_boxes, 1, box.new(left_x, math.max(t.entry, t.tp), right_x, math.min(t.entry, t.tp), border_color=i_pnl_profit_color, bgcolor=i_pnl_profit_color))
            if i_show_size
                [size_txt, risk_used] = position_info(t.entry, t.stop_px)
                float risk_dist = math.abs(t.entry - t.stop_px)
                float rr_tp = math.abs(t.tp - t.entry) / risk_dist
                bool sized = risk_used > 0
                string side = t.is_bull ? "BUY " : "SELL "
                string rr_txt = "1:" + str.tostring(rr_tp, "0.0#")
                string l2 = sized ? ("Risk " + usd(risk_used) + " (" + str.tostring(risk_used / i_account_size * 100.0, "0.0#") + "%) · TP +" + usd(risk_used * rr_tp) + " (" + rr_txt + ")") : ("TP " + rr_txt)
                float r_now = t.result == 0 ? (t.is_bull ? close - t.entry : t.entry - close) / risk_dist : t.r_result
                string r_txt = (r_now >= 0 ? "+" : "") + str.tostring(r_now, "0.0#") + "R"
                string money = sized ? ((r_now >= 0 ? "+" : "-") + usd(r_now * risk_used) + " ") : ""
                string l3 = switch t.result
                    1 => "TP hit " + money + "(" + r_txt + ")"
                    -1 => "SL hit " + money + "(" + r_txt + ")"
                    2 => "Closed beyond box " + money + "(" + r_txt + ")"
                    3 => "Breakeven (0R)"
                    => (t.be_moved ? "Open, stop at BE " : "Open ") + money + "(" + r_txt + ")"
                string ticket = side + size_txt + " @ " + str.tostring(t.entry, format.mintick) + "\nStop: close beyond " + str.tostring(t.stop_px, format.mintick) + "\nHard stop " + str.tostring(t.sl, format.mintick) + "\nTP " + str.tostring(t.tp, format.mintick) + " (" + rr_txt + ")" + (sized ? "\nRisk " + usd(risk_used) + " · Reward " + usd(risk_used * rr_tp) : "")
                // Label always at the right edge (past the boxes) so it never covers the setup's labels
                array.set(g_pos_label, 0, label.new(bar_index + i_extend_bars, t.entry, side + size_txt + "\n" + l2 + "\n" + l3, style=label.style_label_left, color=color.new(color.black, 30), textcolor=color.white, size=size.small, textalign=text.align_left, tooltip=ticket))

// ─────────────────────────────────────────────────────────────────────
// Win/loss stats per grade over the loaded chart history
// ─────────────────────────────────────────────────────────────────────
var table g_stats_table = table.new(position.bottom_right, 5, 9, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

render_trade_stats() =>
    if barstate.islast
        table.clear(g_stats_table, 0, 0, 4, 8)
        if i_show_stats
            array<string> names = array.from("A+", "A", "A-", "B+", "B", "B-", "C")
            table.cell(g_stats_table, 0, 0, "Grade", text_color=color.gray, text_size=size.small)
            table.cell(g_stats_table, 1, 0, "Trades", text_color=color.gray, text_size=size.small)
            table.cell(g_stats_table, 2, 0, "Win %", text_color=color.gray, text_size=size.small)
            table.cell(g_stats_table, 3, 0, "BE %", text_color=color.gray, text_size=size.small)
            table.cell(g_stats_table, 4, 0, "Avg R", text_color=color.gray, text_size=size.small)
            int row = 1
            int tot_n = 0
            int tot_w = 0
            int tot_be = 0
            float tot_r = 0.0
            for gi = 0 to 6
                int w = array.get(g_stat_wins, gi)
                int be = array.get(g_stat_be, gi)
                int cnt = w + be + array.get(g_stat_losses, gi)
                float sum_r = array.get(g_stat_r, gi)
                if cnt > 0
                    float avg_r = sum_r / cnt
                    table.cell(g_stats_table, 0, row, array.get(names, gi), text_color=grade_to_color(array.get(names, gi)), text_size=size.small)
                    table.cell(g_stats_table, 1, row, str.tostring(cnt), text_color=color.white, text_size=size.small)
                    table.cell(g_stats_table, 2, row, str.tostring(100.0 * w / cnt, "0") + "%", text_color=color.white, text_size=size.small)
                    table.cell(g_stats_table, 3, row, str.tostring(100.0 * be / cnt, "0") + "%", text_color=color.gray, text_size=size.small)
                    table.cell(g_stats_table, 4, row, (avg_r >= 0 ? "+" : "") + str.tostring(avg_r, "0.00"), text_color=(avg_r >= 0 ? i_bullish_color : i_bearish_color), text_size=size.small)
                    row += 1
                    tot_n += cnt
                    tot_w += w
                    tot_be += be
                    tot_r += sum_r
            if tot_n > 0
                float tot_avg = tot_r / tot_n
                table.cell(g_stats_table, 0, row, "All", text_color=color.white, text_size=size.small)
                table.cell(g_stats_table, 1, row, str.tostring(tot_n), text_color=color.white, text_size=size.small)
                table.cell(g_stats_table, 2, row, str.tostring(100.0 * tot_w / tot_n, "0") + "%", text_color=color.white, text_size=size.small)
                table.cell(g_stats_table, 3, row, str.tostring(100.0 * tot_be / tot_n, "0") + "%", text_color=color.gray, text_size=size.small)
                table.cell(g_stats_table, 4, row, (tot_avg >= 0 ? "+" : "") + str.tostring(tot_avg, "0.00"), text_color=(tot_avg >= 0 ? i_bullish_color : i_bearish_color), text_size=size.small)

// ─────────────────────────────────────────────────────────────────────
// Find Most Recent IFVG for dashboard
// ─────────────────────────────────────────────────────────────────────
find_most_recent_ifvg() =>
    IFVG recent = na
    int arr_size = array.size(g_ifvg_array)

    if arr_size > 0
        // Get the most recent (last) IFVG that is still inverted (not mitigated)
        for i = arr_size - 1 to 0
            if i >= 0 and i < arr_size
                ifvg = array.get(g_ifvg_array, i)
                if ifvg.status == "inverted"
                    recent := ifvg
                    break

    recent

// ══════════════════════════════════════════════════════════════════════
// SECTION 11: DASHBOARD (Phase 3 Enhanced)
// ══════════════════════════════════════════════════════════════════════

var table dashboard = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

render_dashboard(IFVG latest_ifvg) =>
    if barstate.islast
        // Row 0: Title
        table.cell(dashboard, 0, 0, "IFVG PRO v3.0", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
        table.cell(dashboard, 1, 0, "", text_color=color.white, text_size=size.normal)

        // Row 1: Active FVGs
        table.cell(dashboard, 0, 1, "Active FVGs:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 1, str.tostring(array.size(g_fvg_array)), text_color=color.white, text_size=size.small, text_halign=text.align_right)

        // Row 2: Active IFVGs
        table.cell(dashboard, 0, 2, "Active IFVGs:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 2, str.tostring(array.size(g_ifvg_array)), text_color=color.white, text_size=size.small, text_halign=text.align_right)

        // Row 3: Liquidity Levels
        table.cell(dashboard, 0, 3, "Liquidity:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 3, str.tostring(count_live_liquidity()), text_color=color.white, text_size=size.small, text_halign=text.align_right)

        // Row 4: Divider
        table.cell(dashboard, 0, 4, "─────────", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 4, "────", text_color=color.gray, text_size=size.small, text_halign=text.align_right)

        // Row 5: Latest Setup
        latest_grade = not na(latest_ifvg) ? latest_ifvg.grade : "-"
        latest_color = not na(latest_ifvg) ? grade_to_color(latest_ifvg.grade) : color.gray
        table.cell(dashboard, 0, 5, "Latest Setup:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 5, latest_grade + " IFVG", text_color=latest_color, text_size=size.small, text_halign=text.align_right)

        // Row 6: Entry Status
        entry_text = not na(latest_ifvg) ? (latest_ifvg.entry_valid ? "VALID" : "INVALID") : "-"
        entry_color = not na(latest_ifvg) and latest_ifvg.entry_valid ? color.green : color.red
        if na(latest_ifvg)
            entry_color := color.gray
        table.cell(dashboard, 0, 6, "Entry:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 6, entry_text, text_color=entry_color, text_size=size.small, text_halign=text.align_right)

        // Row 7: DOL Target
        dol_text = "-"
        if not na(latest_ifvg) and not na(latest_ifvg.dol)
            dol_text := latest_ifvg.dol.liq_type + " @ " + str.tostring(latest_ifvg.dol.level, format.mintick)
        table.cell(dashboard, 0, 7, "DOL:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 7, dol_text, text_color=color.white, text_size=size.small, text_halign=text.align_right)

        // Row 8: HTF Bias (Phase 3)
        string htf_bias_text = "-"
        color htf_bias_color = color.gray
        if i_enable_htf
            string combined_bias = get_htf_bias()
            htf_bias_text := str.upper(combined_bias)
            if combined_bias == "bullish"
                htf_bias_color := color.green
            else if combined_bias == "bearish"
                htf_bias_color := color.red
        table.cell(dashboard, 0, 8, "HTF Bias:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 8, htf_bias_text, text_color=htf_bias_color, text_size=size.small, text_halign=text.align_right)

        // Row 9: HTF TF Display
        string htf_tf_text = "-"
        if i_enable_htf
            htf_tf_text := get_tf_label(i_htf_timeframe)
            if i_htf_timeframe_2 != i_htf_timeframe
                htf_tf_text := htf_tf_text + " / " + get_tf_label(i_htf_timeframe_2)
        table.cell(dashboard, 0, 9, "HTF:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, 9, htf_tf_text, text_color=color.white, text_size=size.small, text_halign=text.align_right)

        // ── PD Zone row (DSH-01, D-11) ─────────────────────────────
        string pd_text = "—"
        color pd_color = color.gray
        int row_pd = 10
        int row_range = 11
        if not na(g_current_range) and g_current_range.is_valid
            float current_mid = close
            float hi_pd = g_current_range.high_price
            float lo_pd = g_current_range.low_price
            if hi_pd > lo_pd
                float eq_pd = (hi_pd + lo_pd) / 2.0
                if current_mid > eq_pd
                    pd_text := "PREMIUM"
                    pd_color := color.red
                else if current_mid < eq_pd
                    pd_text := "DISCOUNT"
                    pd_color := color.green
                else
                    pd_text := "EQ"
                    pd_color := color.yellow
        table.cell(dashboard, 0, row_pd, "PD Zone:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, row_pd, pd_text, text_color=pd_color, text_size=size.small, text_halign=text.align_right)

        // ── Range % row (DSH-02, D-12) ─────────────────────────────
        string range_pct_text = "—"
        if not na(g_current_range) and g_current_range.is_valid
            int pct = compute_range_percent(close)
            if not na(pct)
                int pct_clamped = int(math.max(0, math.min(100, pct)))
                range_pct_text := str.tostring(pct_clamped) + "%"
        table.cell(dashboard, 0, row_range, "Range %:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
        table.cell(dashboard, 1, row_range, range_pct_text, text_color=color.white, text_size=size.small, text_halign=text.align_right)

// ══════════════════════════════════════════════════════════════════════
// SECTION 12: MAIN EXECUTION LOOP
// ══════════════════════════════════════════════════════════════════════

if i_show_indicator
    // ─────────────────────────────────────────────────────────────────
    // Step 1: Detect swing points for liquidity
    // ─────────────────────────────────────────────────────────────────
    if swing_ready
        float confirm_dist = atr_value * SWING_CONFIRM_ATR
        // RULE 1: new candidates at [1]
        if swing_cand_high
            array.set(g_dbg_swing, 0, array.get(g_dbg_swing, 0) + 1)
            array.push(g_pending_highs, SwingPoint.new(price = high[1], bar_idx = bar_index - 1, is_high = true, is_internal = false, is_valid = true, far_close = close[1]))
            if array.size(g_pending_highs) > SWING_PENDING_MAX
                array.shift(g_pending_highs)
        if swing_cand_low
            array.set(g_dbg_swing, 3, array.get(g_dbg_swing, 3) + 1)
            array.push(g_pending_lows, SwingPoint.new(price = low[1], bar_idx = bar_index - 1, is_high = false, is_internal = false, is_valid = true, far_close = close[1]))
            if array.size(g_pending_lows) > SWING_PENDING_MAX
                array.shift(g_pending_lows)
        // RULE 2/3: resolve pending highs (oldest first keeps g_swing_highs in bar order)
        int ih = 0
        while ih < array.size(g_pending_highs)
            SwingPoint cand = array.get(g_pending_highs, ih)
            cand.far_close := math.min(cand.far_close, close)
            bool resolved = false
            if high > cand.price
                array.set(g_dbg_swing, 2, array.get(g_dbg_swing, 2) + 1)
                resolved := true
            else if close <= cand.price - confirm_dist
                array.set(g_dbg_swing, 1, array.get(g_dbg_swing, 1) + 1)
                array.push(g_swing_highs, cand)
                if array.size(g_swing_highs) > SWING_MEMORY_MAX
                    array.shift(g_swing_highs)
                resolved := true
            if resolved
                array.remove(g_pending_highs, ih)
            ih := resolved ? ih : ih + 1
        // RULE 2/3: resolve pending lows
        int il = 0
        while il < array.size(g_pending_lows)
            SwingPoint cand = array.get(g_pending_lows, il)
            cand.far_close := math.max(cand.far_close, close)
            bool resolved = false
            if low < cand.price
                array.set(g_dbg_swing, 5, array.get(g_dbg_swing, 5) + 1)
                resolved := true
            else if close >= cand.price + confirm_dist
                array.set(g_dbg_swing, 4, array.get(g_dbg_swing, 4) + 1)
                array.push(g_swing_lows, cand)
                if array.size(g_swing_lows) > SWING_MEMORY_MAX
                    array.shift(g_swing_lows)
                resolved := true
            if resolved
                array.remove(g_pending_lows, il)
            il := resolved ? il : il + 1
    // ─────────────────────────────────────────────────────────────────
    // Step 2: Check for EQH/EQL formations
    // ─────────────────────────────────────────────────────────────────
    check_equal_highs()
    check_equal_lows()
    create_internal_levels()
    detect_data_candle()
    cleanup_liquidity_array()
    update_lrlr()

    // ─────────────────────────────────────────────────────────────────
    // Step 3: Check for liquidity sweeps
    // ─────────────────────────────────────────────────────────────────
    check_liquidity_sweeps()

    // ─────────────────────────────────────────────────────────────────
    // Step 4: Detect new LTF FVGs
    // ─────────────────────────────────────────────────────────────────
    new_fvg = detect_fvg()
    if not na(new_fvg)
        // Series of gaps: try to merge with existing same-direction FVG in same leg
        bool was_merged = merge_with_existing_fvg(new_fvg)
        if not was_merged
            array.push(g_fvg_array, new_fvg)
        cleanup_fvg_array()

    // ─────────────────────────────────────────────────────────────────
    // Step 4B: Detect HTF FVGs (Phase 3)
    // ─────────────────────────────────────────────────────────────────
    if i_enable_htf
        // HTF 1 FVG Detection
        htf1_fvg = detect_htf_fvg(i_htf_timeframe, htf_high, htf_low, htf_high_2, htf_low_2, htf_atr, htf_bar_changed)
        if not na(htf1_fvg) and not htf_fvg_exists(g_htf_fvg_array, htf1_fvg.top, htf1_fvg.bottom, htf1_fvg.is_bullish)
            htf1_fvg.htf_end := htf_bar_idx
            array.push(g_htf_fvg_array, htf1_fvg)
            cleanup_htf_fvg_array(g_htf_fvg_array, FVG_MEMORY)

        // HTF 2 FVG Detection (only if different from HTF 1)
        if i_htf_timeframe_2 != i_htf_timeframe
            htf2_fvg = detect_htf_fvg(i_htf_timeframe_2, htf2_high, htf2_low, htf2_high_2, htf2_low_2, htf2_atr, htf2_bar_changed)
            if not na(htf2_fvg) and not htf_fvg_exists(g_htf2_fvg_array, htf2_fvg.top, htf2_fvg.bottom, htf2_fvg.is_bullish)
                htf2_fvg.htf_end := htf2_bar_idx
                array.push(g_htf2_fvg_array, htf2_fvg)
                cleanup_htf_fvg_array(g_htf2_fvg_array, FVG_MEMORY)

    // ─────────────────────────────────────────────────────────────────
    // Step 4C: PD zone pipeline (Phase 2 — runs before check_inversions)
    // ─────────────────────────────────────────────────────────────────
    if barstate.isconfirmed
        bool pd_bar_changed = na(g_prev_pd_bar) or time(i_pd_timeframe) != g_prev_pd_bar
        if pd_bar_changed
            g_prev_pd_bar := time(i_pd_timeframe)
        // Cycle 3: record the TRUE chart-bar where the pivot occurred, not the
        // chart-bar where request.security exposed it. ta.pivothigh(N,N) confirms
        // a pivot N HTF bars after the swing; with lookahead_off the value first
        // surfaces on the first chart bar of HTF (X+N+1). So the pivot is roughly
        // (N+1) HTF bars == (N+1)*ratio chart bars earlier than `bar_index` at push.
        // Pinning the level to its true bar fixes line rendering (was anchored too
        // far right) and stabilises the cycle-2 chronological walkback when the
        // walkback compares an ITH and ITL pushed on the same chart bar.
        float pd_secs    = timeframe.in_seconds(i_pd_timeframe)
        float chart_secs = timeframe.in_seconds(timeframe.period)
        float ratio      = chart_secs > 0 ? (pd_secs / chart_secs) : 1.0
        // Automatic swings: the lag is the swing's own age in PD bars (swing candle -> confirmation)
        if not na(pd_pivot_high_raw) and pd_bar_changed
            int lag_h = int(math.max(1, math.round((pd_pivot_high_age + 1) * ratio)))
            int pivot_bar = int(math.max(0, bar_index - lag_h))
            g_pd_lag_bars := lag_h
            array.push(g_pd_swing_highs, SwingPoint.new(price=pd_pivot_high_raw, bar_idx=pivot_bar, is_high=true, is_internal=false, is_valid=true))
            if array.size(g_pd_swing_highs) > 50
                array.shift(g_pd_swing_highs)
        if not na(pd_pivot_low_raw) and pd_bar_changed
            int lag_l = int(math.max(1, math.round((pd_pivot_low_age + 1) * ratio)))
            int pivot_bar = int(math.max(0, bar_index - lag_l))
            g_pd_lag_bars := int(math.max(g_pd_lag_bars, lag_l))
            array.push(g_pd_swing_lows, SwingPoint.new(price=pd_pivot_low_raw, bar_idx=pivot_bar, is_high=false, is_internal=false, is_valid=true))
            if array.size(g_pd_swing_lows) > 50
                array.shift(g_pd_swing_lows)
    create_pd_internal_levels()
    check_pd_sweeps()
    // Dealing range = most recent valid (unswept) PD_ITH paired with most recent valid PD_ITL.
    // ICT methodology: the freshest unswept liquidity on each side defines the current
    // dealing range, regardless of price's position within it. If the two newest cross
    // (ITH.level <= ITL.level, an inverted anchor), walk back the chronologically OLDER
    // anchor to find an earlier instance of that side that yields ITH.level > ITL.level.
    // No "narrowest containing price" preference — that biases toward micro-consolidations
    // and ignores the structural range visible across the chart.
    array<Liquidity> src = select_dealing_range_source()
    array<Liquidity> ith_candidates = array.new<Liquidity>()
    array<Liquidity> itl_candidates = array.new<Liquidity>()
    if array.size(src) > 0
        for i = array.size(src) - 1 to 0
            Liquidity liq = array.get(src, i)
            if liq.is_valid and not liq.is_swept
                if (liq.liq_type == "PD_ITH" or liq.liq_type == "ITH")
                    array.push(ith_candidates, liq)
                if (liq.liq_type == "PD_ITL" or liq.liq_type == "ITL")
                    array.push(itl_candidates, liq)
    Liquidity sel_ith = na
    Liquidity sel_itl = na
    int n_ith = array.size(ith_candidates)
    int n_itl = array.size(itl_candidates)
    if n_ith > 0 and n_itl > 0
        // Candidates were pushed newest-first (outer loop walks size-1 -> 0), so
        // index 0 is the most recent valid level on each side.
        int ith_idx = 0
        int itl_idx = 0
        Liquidity cand_ith = array.get(ith_candidates, ith_idx)
        Liquidity cand_itl = array.get(itl_candidates, itl_idx)
        bool resolved = cand_ith.level > cand_itl.level
        // Walk back the older of the two anchors until non-crossing pair found.
        // Bounded by total candidate count to guarantee termination.
        int safety_iters = n_ith + n_itl
        while (not resolved) and safety_iters > 0
            if cand_ith.bar_idx <= cand_itl.bar_idx
                // ITH is older (or same age) -- advance to next older ITH
                ith_idx := ith_idx + 1
                if ith_idx >= n_ith
                    break
                cand_ith := array.get(ith_candidates, ith_idx)
            else
                // ITL is older -- advance to next older ITL
                itl_idx := itl_idx + 1
                if itl_idx >= n_itl
                    break
                cand_itl := array.get(itl_candidates, itl_idx)
            resolved := cand_ith.level > cand_itl.level
            safety_iters := safety_iters - 1
        if resolved
            sel_ith := cand_ith
            sel_itl := cand_itl
        else
            // Cycle 4: structural-extremes fallback. When newest-newest walkback
            // exhausts (every newest ITH sits below every newest ITL — happens in
            // strong directional trends where recent pivots cluster on one side of
            // price), fall back to ICT impulse-leg interpretation: dealing range =
            // highest unswept ITH paired with lowest unswept ITL across all valid
            // candidates. This preserves a structurally meaningful range during
            // steep trending moves rather than dropping the zone entirely.
            Liquidity hi_ith = array.get(ith_candidates, 0)
            Liquidity lo_itl = array.get(itl_candidates, 0)
            // Guard `for a to b` against ascending range when n == 1 (Pine `to`
            // is bidirectional — `for k = 1 to 0` would iterate k=1,0 and OOB).
            if n_ith >= 2
                for k = 1 to n_ith - 1
                    Liquidity ck = array.get(ith_candidates, k)
                    if ck.level > hi_ith.level
                        hi_ith := ck
            if n_itl >= 2
                for k = 1 to n_itl - 1
                    Liquidity ck = array.get(itl_candidates, k)
                    if ck.level < lo_itl.level
                        lo_itl := ck
            if hi_ith.level > lo_itl.level
                sel_ith := hi_ith
                sel_itl := lo_itl
    // Cycle 5: final safety-net fallback. When ONE side has zero valid candidates
    // (e.g. a sustained bullish trend has invalidated every ITH via wick-revert
    // sweeps and cycle-3 close-through inside the lag window) but the other side
    // still has valid candidates, the primary branch above is skipped entirely
    // (gated on n_ith > 0 AND n_itl > 0) and the PD zone collapses to blank even
    // though structural extremes exist in the swept/invalid pool. Recover by
    // scanning the FULL PD liquidity array (including swept and invalid) for the
    // highest PD_ITH and lowest PD_ITL, but ONLY on whichever side is empty —
    // a side with valid candidates always prefers a valid pick from the cycle-4
    // path above. This is a pure rendering-safety net; it does not change sweep
    // semantics or pollute candidate pools used elsewhere.
    if na(sel_ith) or na(sel_itl)
        Liquidity safety_ith = sel_ith
        Liquidity safety_itl = sel_itl
        int src_n = array.size(src)
        if src_n > 0
            // Scan the full array for highest PD_ITH side
            if na(safety_ith)
                for k = 0 to src_n - 1
                    if k < src_n
                        Liquidity ck = array.get(src, k)
                        if (ck.liq_type == "PD_ITH" or ck.liq_type == "ITH")
                            if na(safety_ith) or ck.level > safety_ith.level
                                safety_ith := ck
            // Scan the full array for lowest PD_ITL side
            if na(safety_itl)
                for k = 0 to src_n - 1
                    if k < src_n
                        Liquidity ck = array.get(src, k)
                        if (ck.liq_type == "PD_ITL" or ck.liq_type == "ITL")
                            if na(safety_itl) or ck.level < safety_itl.level
                                safety_itl := ck
        if not na(safety_ith) and not na(safety_itl) and safety_ith.level > safety_itl.level
            sel_ith := safety_ith
            sel_itl := safety_itl
    // Leg-based dealing range (preferred): the range spans the CURRENT leg.
    // Bullish leg:
    //   RULE 1 (top): the OLDEST unbroken PD swing high (no later swing high above it)
    //     whose leg is intact — the high the current up-move reached.
    //   RULE 2 (start): the LOWEST PD swing low since price was last above that high
    //     (after the most recent older higher high). Minor bounces between the start and
    //     the top never cut the leg. If the high is the top of memory, walk back the chain
    //     of higher lows instead (stop at the first older low that is higher).
    //   RULE 3 (intact): no PD swing low after the start is below it (no lower low).
    //     A newer, smaller bounce inside a bigger move is a pullback, not the range.
    // Bearish leg: mirrored (oldest unbroken swing low, highest high since price was last
    //   below it, no higher high after that start).
    // RULE 4: if both legs are intact, use the OUTER one (older start) — a pullback inside
    //   a range is never treated as a new range. Otherwise use whichever is intact.
    // Independent of how many swings are in memory. Falls back to the freshest-unswept
    // selection above when no leg can be built.
    // NOTE: legs are cached and rebuilt only when a new PD swing arrives (the search is
    // O(n^2) over up to 50 swings per side — running it every bar exceeds the time limit)
    var float bull_hi = na
    var int bull_hi_bar = na
    var float bull_lo = na
    var int bull_lo_bar = na
    var float bear_hi = na
    var int bear_hi_bar = na
    var float bear_lo = na
    var int bear_lo_bar = na
    var bool bull_ok = false
    var bool bear_ok = false
    var int leg_cache_h = -1
    var int leg_cache_l = -1
    int n_ph = array.size(g_pd_swing_highs)
    int n_pl = array.size(g_pd_swing_lows)
    int newest_h_bar = n_ph > 0 ? array.get(g_pd_swing_highs, n_ph - 1).bar_idx : -1
    int newest_l_bar = n_pl > 0 ? array.get(g_pd_swing_lows, n_pl - 1).bar_idx : -1
    bool legs_stale = newest_h_bar != leg_cache_h or newest_l_bar != leg_cache_l
    if legs_stale
        leg_cache_h := newest_h_bar
        leg_cache_l := newest_l_bar
        bull_hi := na
        bull_hi_bar := na
        bull_lo := na
        bull_lo_bar := na
        bear_hi := na
        bear_hi_bar := na
        bear_lo := na
        bear_lo_bar := na
        bull_ok := false
        bear_ok := false
    if legs_stale and n_ph > 0 and n_pl > 0
        // Bullish leg: oldest unbroken PD swing high (no later higher high) whose leg is intact
        for c = 0 to n_ph - 1
            SwingPoint hc = array.get(g_pd_swing_highs, c)
            if not bull_ok
                bool unbroken = true
                int from_bar = -1
                for k = 0 to n_ph - 1
                    SwingPoint hk = array.get(g_pd_swing_highs, k)
                    if hk.bar_idx > hc.bar_idx and hk.price > hc.price
                        unbroken := false
                    if hk.bar_idx < hc.bar_idx and hk.price > hc.price
                        from_bar := hk.bar_idx
                if unbroken
                    // Start: lowest swing low since price was last above this high. If no
                    // older high is above it (top of memory), walk back the chain of higher
                    // lows instead and stop at the first older low that is higher.
                    float lo_c = na
                    int lo_c_bar = na
                    if from_bar >= 0
                        for k = 0 to n_pl - 1
                            SwingPoint lk = array.get(g_pd_swing_lows, k)
                            if lk.bar_idx > from_bar and lk.bar_idx < hc.bar_idx and (na(lo_c) or lk.price < lo_c)
                                lo_c := lk.price
                                lo_c_bar := lk.bar_idx
                    else
                        for k = n_pl - 1 to 0
                            SwingPoint lk = array.get(g_pd_swing_lows, k)
                            if lk.bar_idx < hc.bar_idx
                                if na(lo_c) or lk.price < lo_c
                                    lo_c := lk.price
                                    lo_c_bar := lk.bar_idx
                                else
                                    break
                    if not na(lo_c)
                        // Intact: no swing low after the start is below it
                        bool intact = true
                        for k = 0 to n_pl - 1
                            SwingPoint lk = array.get(g_pd_swing_lows, k)
                            if lk.bar_idx > lo_c_bar and lk.price < lo_c
                                intact := false
                        if intact
                            bull_ok := true
                            bull_lo := lo_c
                            bull_lo_bar := lo_c_bar
                            bull_hi := hc.price
                            bull_hi_bar := hc.bar_idx
        // Bearish leg: oldest unbroken PD swing low (no later lower low) whose leg is intact
        for c = 0 to n_pl - 1
            SwingPoint lc = array.get(g_pd_swing_lows, c)
            if not bear_ok
                bool unbroken = true
                int from_bar = -1
                for k = 0 to n_pl - 1
                    SwingPoint lk = array.get(g_pd_swing_lows, k)
                    if lk.bar_idx > lc.bar_idx and lk.price < lc.price
                        unbroken := false
                    if lk.bar_idx < lc.bar_idx and lk.price < lc.price
                        from_bar := lk.bar_idx
                if unbroken
                    // Start: highest swing high since price was last below this low. If no
                    // older low is below it (bottom of memory), walk back the chain of lower
                    // highs instead and stop at the first older high that is lower.
                    float hi_c = na
                    int hi_c_bar = na
                    if from_bar >= 0
                        for k = 0 to n_ph - 1
                            SwingPoint hk = array.get(g_pd_swing_highs, k)
                            if hk.bar_idx > from_bar and hk.bar_idx < lc.bar_idx and (na(hi_c) or hk.price > hi_c)
                                hi_c := hk.price
                                hi_c_bar := hk.bar_idx
                    else
                        for k = n_ph - 1 to 0
                            SwingPoint hk = array.get(g_pd_swing_highs, k)
                            if hk.bar_idx < lc.bar_idx
                                if na(hi_c) or hk.price > hi_c
                                    hi_c := hk.price
                                    hi_c_bar := hk.bar_idx
                                else
                                    break
                    if not na(hi_c)
                        // Intact: no swing high after the start is above it
                        bool intact = true
                        for k = 0 to n_ph - 1
                            SwingPoint hk = array.get(g_pd_swing_highs, k)
                            if hk.bar_idx > hi_c_bar and hk.price > hi_c
                                intact := false
                        if intact
                            bear_ok := true
                            bear_hi := hi_c
                            bear_hi_bar := hi_c_bar
                            bear_lo := lc.price
                            bear_lo_bar := lc.bar_idx
    bool use_bull = false
    if bull_ok and bear_ok
        use_bull := bull_lo_bar <= bear_hi_bar
    else
        use_bull := bull_ok
    bool any_leg = bull_ok or bear_ok
    float leg_hi = not any_leg ? na : (use_bull ? bull_hi : bear_hi)
    int leg_hi_bar = use_bull ? bull_hi_bar : bear_hi_bar
    float leg_lo = not any_leg ? na : (use_bull ? bull_lo : bear_lo)
    int leg_lo_bar = use_bull ? bull_lo_bar : bear_lo_bar
    // RULE 5 (running extreme): when price trades beyond the leg's far end before a new
    // PD swing confirms (slow on Daily), extend that end to the chart's running high
    // (bullish leg) / low (bearish leg) since it. Range % never sticks at 100% / 0%.
    // Tracked incrementally: one scan when the leg end changes, then one bar per update.
    var float ext_val = na
    var int ext_bar = na
    var int ext_key = na
    if any_leg and not na(leg_hi) and not na(leg_lo)
        int ext_from = use_bull ? leg_hi_bar : leg_lo_bar
        int key_now = use_bull ? ext_from : -ext_from - 1
        if na(ext_key) or ext_key != key_now
            ext_key := key_now
            ext_val := use_bull ? leg_hi : leg_lo
            ext_bar := ext_from
            int ext_span = int(math.min(bar_index - ext_from, 499))
            if ext_span >= 1
                for k = ext_span to 1
                    if use_bull and high[k] > ext_val
                        ext_val := high[k]
                        ext_bar := bar_index - k
                    if not use_bull and low[k] < ext_val
                        ext_val := low[k]
                        ext_bar := bar_index - k
        if use_bull and high > ext_val
            ext_val := high
            ext_bar := bar_index
        if not use_bull and low < ext_val
            ext_val := low
            ext_bar := bar_index
        if use_bull
            leg_hi := ext_val
            leg_hi_bar := ext_bar
        else
            leg_lo := ext_val
            leg_lo_bar := ext_bar
    if na(leg_hi) or na(leg_lo)
        leg_hi := na
        leg_lo := na
        if not na(sel_ith) and not na(sel_itl)
            leg_hi := sel_ith.level
            leg_hi_bar := sel_ith.bar_idx
            leg_lo := sel_itl.level
            leg_lo_bar := sel_itl.bar_idx
    if not na(leg_hi) and not na(leg_lo) and leg_hi > leg_lo
        bool rotated = na(g_current_range) or not g_current_range.is_valid or g_current_range.high_bar_idx != leg_hi_bar or g_current_range.low_bar_idx != leg_lo_bar
        if rotated
            clear_range_drawings(g_current_range)
            g_current_range := DealingRange.new(high_price=leg_hi, low_price=leg_lo, high_bar_idx=leg_hi_bar, low_bar_idx=leg_lo_bar, is_valid=true, line_high=na, line_eq=na, line_low=na, label_high=na, label_eq=na, label_low=na, fill_premium=na, fill_discount=na, ote_line_top=na, ote_line_bot=na, ote_fill=na)
    else
        if not na(g_current_range) and g_current_range.is_valid
            clear_range_drawings(g_current_range)
            g_current_range.is_valid := false
            g_current_range.line_high := na
            g_current_range.line_eq := na
            g_current_range.line_low := na
            g_current_range.label_high := na
            g_current_range.label_eq := na
            g_current_range.label_low := na
            g_current_range.fill_premium := na
            g_current_range.fill_discount := na
            g_current_range.ote_line_top := na
            g_current_range.ote_line_bot := na
            g_current_range.ote_fill := na

    // ─────────────────────────────────────────────────────────────────
    // Step 5: Check for LTF inversions (FVG → IFVG)
    // ─────────────────────────────────────────────────────────────────
    check_inversions()
    cleanup_ifvg_array()

    // ─────────────────────────────────────────────────────────────────
    // Step 5B: Check for HTF inversions (Phase 3)
    // ─────────────────────────────────────────────────────────────────
    if i_enable_htf
        check_htf_inversions(g_htf_fvg_array, g_htf_ifvg_array, htf_close, i_htf_timeframe, g_htf_col_bar, g_htf_col)
        cleanup_htf_ifvg_array(g_htf_ifvg_array, i_max_ifvgs)

        if i_htf_timeframe_2 != i_htf_timeframe
            check_htf_inversions(g_htf2_fvg_array, g_htf2_ifvg_array, htf2_close, i_htf_timeframe_2, g_htf2_col_bar, g_htf2_col)
            cleanup_htf_ifvg_array(g_htf2_ifvg_array, i_max_ifvgs)

    // ─────────────────────────────────────────────────────────────────
    // Step 5C: Check HTF IFVG mitigations (Phase 3)
    // ─────────────────────────────────────────────────────────────────
    if i_enable_htf
        check_htf_mitigations(g_htf_ifvg_array, htf_close)
        if i_htf_timeframe_2 != i_htf_timeframe
            check_htf_mitigations(g_htf2_ifvg_array, htf2_close)

    // ─────────────────────────────────────────────────────────────────
    // Step 6: Update BE status
    // ─────────────────────────────────────────────────────────────────
    update_be_status()

    // ─────────────────────────────────────────────────────────────────
    // Step 6.5: Update DOL status (refresh stale/mitigated DOLs)
    // ─────────────────────────────────────────────────────────────────
    update_dol_status()

    // ─────────────────────────────────────────────────────────────────
    // Step 7: Check for mitigations (IFVG removal)
    // ─────────────────────────────────────────────────────────────────
    check_mitigations()
    update_trades()

    // ─────────────────────────────────────────────────────────────────
    // Step 8: Find best IFVG for dashboard
    // ─────────────────────────────────────────────────────────────────
    IFVG current_latest_ifvg = find_most_recent_ifvg()

    // ─────────────────────────────────────────────────────────────────
    // Step 9: Render all elements
    // ─────────────────────────────────────────────────────────────────
    render_fvg_boxes()
    render_ifvg_boxes()

    // ─────────────────────────────────────────────────────────────────
    // Step 9B: Render HTF elements (Phase 3)
    // ─────────────────────────────────────────────────────────────────
    if i_enable_htf
        string htf1_label = get_tf_label(i_htf_timeframe)
        string htf2_label = get_tf_label(i_htf_timeframe_2)

        render_htf_fvg_boxes(g_htf_fvg_array, htf1_label)
        render_htf_ifvg_boxes(g_htf_ifvg_array, htf1_label)

        if i_htf_timeframe_2 != i_htf_timeframe
            render_htf_fvg_boxes(g_htf2_fvg_array, htf2_label)
            render_htf_ifvg_boxes(g_htf2_ifvg_array, htf2_label)

    render_liquidity_lines()
    render_lrlr()
    render_dealing_range(g_current_range)
    render_dashboard(current_latest_ifvg)
    render_position()
    render_trade_stats()

// ─────────────────────────────────────────────────────────────────────
// Alerts: every message queued this candle goes out as one alert()
// (one TradingView alert with "Any alert() function call" catches them all)
// ─────────────────────────────────────────────────────────────────────
if array.size(g_alert_msgs) > 0
    alert(array.join(g_alert_msgs, "\n\n"), alert.freq_once_per_bar_close)
    array.clear(g_alert_msgs)

// ─────────────────────────────────────────────────────────────────────
// Debug panel (Settings → Debug → Show Debug Panel)
// ─────────────────────────────────────────────────────────────────────
var label g_dbg_label = na
if barstate.islast
    label.delete(g_dbg_label)
    if i_show_debug
        int dbg_live = 0
        int dbg_ithl_live = 0
        int dbg_strong = 0
        int dbg_undecided = 0
        int dbg_disp = 0
        int dbg_drawn = 0
        int dbg_data_live = 0
        for dq in g_liquidity_array
            bool dq_live = dq.is_valid and not dq.is_swept
            bool dq_internal = dq.liq_type == "ITH" or dq.liq_type == "ITL"
            if dq_live
                dbg_live += 1
            if dq_live and (dq.liq_type == "Data High" or dq.liq_type == "Data Low")
                dbg_data_live += 1
            if dq_live and dq_internal
                dbg_ithl_live += 1
            if dq_live and dq.is_strong
                dbg_strong += 1
            if dq_live and dq_internal and not dq.is_decided
                dbg_undecided += 1
            if is_liq_displayable(dq)
                dbg_disp += 1
            if not na(dq.line_id)
                dbg_drawn += 1
        string dbg_txt = "DEBUG" + "\nbars processed: " + str.tostring(bar_index) + "\nATR: " + str.tostring(atr_value, format.mintick) + "\nshow ITH/ITL: " + str.tostring(i_show_ith_itl) + "\ncandidates H/L: " + str.tostring(array.get(g_dbg_swing, 0)) + "/" + str.tostring(array.get(g_dbg_swing, 3)) + "\nconfirmed H/L: " + str.tostring(array.get(g_dbg_swing, 1)) + "/" + str.tostring(array.get(g_dbg_swing, 4)) + "\ncancelled H/L: " + str.tostring(array.get(g_dbg_swing, 2)) + "/" + str.tostring(array.get(g_dbg_swing, 5)) + "\npending H/L: " + str.tostring(array.size(g_pending_highs)) + "/" + str.tostring(array.size(g_pending_lows)) + "\nswings H/L: " + str.tostring(array.size(g_swing_highs)) + "/" + str.tostring(array.size(g_swing_lows)) + "\nliq total/live: " + str.tostring(array.size(g_liquidity_array)) + "/" + str.tostring(dbg_live) + "\nlive ITH/ITL: " + str.tostring(dbg_ithl_live) + "\nlive strong: " + str.tostring(dbg_strong) + "\nundecided: " + str.tostring(dbg_undecided) + "\ndisplayable: " + str.tostring(dbg_disp) + "\nwith line drawn: " + str.tostring(dbg_drawn) + "\nlive Data H/L: " + str.tostring(dbg_data_live)
        int dbg_pd_live = 0
        for pq in g_pd_liquidity_array
            if pq.is_valid and not pq.is_swept
                dbg_pd_live += 1
        dbg_txt := dbg_txt + "\nPD swings H/L: " + str.tostring(array.size(g_pd_swing_highs)) + "/" + str.tostring(array.size(g_pd_swing_lows)) + "\nPD levels total/live: " + str.tostring(array.size(g_pd_liquidity_array)) + "/" + str.tostring(dbg_pd_live) + "\nPD lag bars: " + str.tostring(g_pd_lag_bars) + "\nPD range: " + (na(g_current_range) ? "none" : (g_current_range.is_valid ? "valid" : "invalid"))
        g_dbg_label := label.new(bar_index + 5, high, dbg_txt, style=label.style_label_left, color=color.new(color.black, 10), textcolor=color.white, size=size.normal)
